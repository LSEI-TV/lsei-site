---
// Lecteur « façade » : on affiche une vignette, et l'iframe YouTube n'est
// chargée (donc YouTube n'est contacté) QU'après le clic de l'internaute.
// Bon pour la vie privée (RGPD) et pour la performance.
interface Props {
  id: string;
  from: string;
  to: string;
  caption?: string;
  title?: string;
  image?: string;
  live?: boolean;
  score?: string;
}
const { id, from, to, caption, title, image, live = false, score } = Astro.props;
const isDemo = id.startsWith('demo-');
---
<div class="player">
  <button
    class="facade frame"
    data-id={id}
    data-demo={isDemo ? '1' : ''}
    aria-label={`Lire la vidéo : ${title ?? ''}`}
  >
    {image
      ? <img class="photo" src={image} alt="" />
      : <div class="duo" style={`background:linear-gradient(135deg,${from},${to});`}></div>}
    <div class="grad"></div>
    {live && <span class="badge"><span class="pulse"></span>Direct</span>}
    <span class="play" aria-hidden="true">
      <svg width="24" height="26" viewBox="0 0 20 22" fill="#fff"><path d="M0 0l20 11L0 22z"/></svg>
    </span>
    {(caption || score) && (
      <div class="cap">
        {caption && <div class="disc">{caption}</div>}
        {score && <div class="score">{score}</div>}
      </div>
    )}
  </button>
  <div class="demo-note">Vidéo de démonstration — le vrai lecteur s'affichera une fois les vidéos YouTube connectées.</div>
</div>
<script is:inline>
  (function () {
    document.querySelectorAll('.player .facade').forEach(function (el) {
      el.addEventListener('click', function () {
        if (el.getAttribute('data-demo')) { el.classList.add('is-demo'); return; }
        var id = el.getAttribute('data-id');
        var f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
        f.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
        f.setAttribute('allowfullscreen', '');
        f.setAttribute('title', 'Lecteur vidéo');
        el.replaceWith(f);
      });
    });
  })();
</script>
