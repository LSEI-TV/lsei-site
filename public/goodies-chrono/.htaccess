# Ancienne adresse de l'app (déménagée vers /nova/) : jamais de cache, pour que
# le service worker de nettoyage et la redirection arrivent tout de suite.
<IfModule mod_headers.c>
  <FilesMatch "(sw\.js|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
