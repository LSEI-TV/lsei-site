---
// Icône SVG maison d'un sport, dans la couleur héritée (currentColor).
// Utilisée dans les cartes de disciplines. slug = 'basket' | 'billard' | 'palets'
// | 'football' | 'beach' | 'bowling' | 'subbuteo'.
interface Props { slug: string; class?: string; }
const { slug, class: klass = '' } = Astro.props;

const ICONS: Record<string, string> = {
  basket:
    '<circle cx="12" cy="12" r="9" fill="none"/><path d="M3 12h18M12 3v18" fill="none"/><path d="M5.5 5.5C9 9 9 15 5.5 18.5M18.5 5.5C15 9 15 15 18.5 18.5" fill="none"/>',
  billard:
    '<circle cx="7.5" cy="16.5" r="4" stroke="none"/><line x1="11" y1="13" x2="21" y2="3" fill="none"/>',
  palets:
    '<ellipse cx="12" cy="8.5" rx="8" ry="3" stroke="none"/><path d="M4 8.5v5c0 1.66 3.58 3 8 3s8-1.34 8-3v-5" stroke="none" opacity="0.5"/>',
  football:
    '<circle cx="12" cy="12" r="9" fill="none"/><path d="M12 7.4l3.4 2.5-1.3 4h-4.2l-1.3-4z" stroke="none"/><path d="M12 3v4.4M4.6 9.6l4 .3M19.4 9.6l-4 .3M8 19l1.8-3.6M16 19l-1.8-3.6" fill="none"/>',
  beach:
    '<circle cx="12" cy="12" r="9" fill="none"/><path d="M12 3c-3 5-3 13 0 18M3.5 9c5 2.2 12 2 17-1M3.2 15c5-2 12-2.5 17.5 0" fill="none"/>',
  bowling:
    '<circle cx="12" cy="12" r="9" stroke="none"/><circle cx="9.5" cy="9" r="1.15" fill="#fff" stroke="none"/><circle cx="13.6" cy="8.5" r="1.15" fill="#fff" stroke="none"/><circle cx="12" cy="12.4" r="1.15" fill="#fff" stroke="none"/>',
  subbuteo:
    '<ellipse cx="12" cy="19.3" rx="6" ry="2.2" stroke="none"/><circle cx="12" cy="6.5" r="2.3" stroke="none"/><path d="M9.4 18.3c0-4.5 1-8 2.6-8s2.6 3.5 2.6 8z" stroke="none"/>',
};
const inner = ICONS[slug] ?? '';
---
<svg viewBox="0 0 24 24" class:list={['sport-ic', klass]} fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={inner}></svg>
