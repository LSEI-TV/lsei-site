---
// Modale de lecture : cliquer une carte vidéo ouvre le lecteur par-dessus la page,
// sans quitter la liste. Échap / bouton retour ferment. URL synchronisée (partageable).
---
<div class="modal" id="video-modal" hidden role="dialog" aria-modal="true" aria-label="Lecteur vidéo">
  <div class="modal-backdrop" data-close></div>
  <div class="modal-body">
    <button class="modal-close" data-close aria-label="Fermer">✕</button>
    <div class="modal-player" id="modal-player"></div>
    <div class="modal-meta">
      <h3 class="modal-title" id="modal-title"></h3>
      <a class="modal-yt" id="modal-yt" href="#" target="_blank" rel="noopener">Voir sur YouTube ↗</a>
      <div class="share modal-share" id="modal-share" data-share-url="" data-share-title="">
        <span class="share-label">Partager</span>
        <a class="share-btn" data-net="facebook" target="_blank" rel="noopener" aria-label="Partager sur Facebook" title="Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.87v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.88h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg></a>
        <a class="share-btn" data-net="whatsapp" target="_blank" rel="noopener" aria-label="Partager sur WhatsApp" title="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.83c0 4.54-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24Zm-3.68 4.4c-.17 0-.45.06-.69.31-.24.25-.9.88-.9 2.15s.92 2.49 1.05 2.66c.13.17 1.8 2.85 4.45 3.9 2.2.87 2.65.7 3.13.65.48-.04 1.55-.63 1.77-1.25.22-.61.22-1.14.15-1.25-.06-.11-.24-.18-.51-.31-.27-.14-1.55-.77-1.79-.85-.24-.09-.42-.13-.6.13-.17.25-.68.85-.83 1.03-.15.17-.31.19-.57.06-.27-.14-1.11-.41-2.12-1.31-.78-.7-1.31-1.56-1.47-1.82-.15-.25-.02-.39.12-.52.12-.12.27-.31.4-.47.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.13-.6-1.47-.83-2.01-.22-.53-.44-.46-.6-.46l-.51-.01Z"/></svg></a>
        <a class="share-btn" data-net="x" target="_blank" rel="noopener" aria-label="Partager sur X" title="X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.82-5.97 6.82H1.66l7.73-8.84L1.24 2.25h6.83l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.01 4.13H5.05l12.03 15.64Z"/></svg></a>
        <a class="share-btn" data-net="email" aria-label="Partager par email" title="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg></a>
        <button class="share-btn share-copy" type="button" aria-label="Copier le lien" title="Copier le lien"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></svg></button>
        <button class="share-btn share-native" type="button" aria-label="Partager…" title="Partager…" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg></button>
      </div>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    var modal = document.getElementById('video-modal');
    if (!modal) return;
    var player = document.getElementById('modal-player');
    var titleEl = document.getElementById('modal-title');
    var ytEl = document.getElementById('modal-yt');
    var open = false;

    function show(id, title) {
      player.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen title="Lecteur vidéo"></iframe>';
      titleEl.textContent = title || '';
      ytEl.href = 'https://www.youtube.com/watch?v=' + id;
      // Met à jour les liens de partage avec l'URL de la page replay de cette vidéo.
      var share = document.getElementById('modal-share');
      if (share) {
        var vurl = location.origin + '/replay/' + id;
        var su = encodeURIComponent(vurl), st = encodeURIComponent(title || '');
        share.setAttribute('data-share-url', vurl);
        share.setAttribute('data-share-title', title || '');
        share.querySelector('[data-net="facebook"]').href = 'https://www.facebook.com/sharer/sharer.php?u=' + su;
        share.querySelector('[data-net="whatsapp"]').href = 'https://api.whatsapp.com/send?text=' + st + '%20' + su;
        share.querySelector('[data-net="x"]').href = 'https://twitter.com/intent/tweet?url=' + su + '&text=' + st;
        share.querySelector('[data-net="email"]').href = 'mailto:?subject=' + st + '&body=' + su;
      }
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      open = true;
    }
    function hide() {
      player.innerHTML = '';
      modal.hidden = true;
      document.body.style.overflow = '';
      open = false;
    }
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a.card[href^="/replay/"]');
      if (!a) return;
      e.preventDefault();
      var href = a.getAttribute('href');
      var id = href.slice('/replay/'.length);
      var h = a.querySelector('h3');
      var title = h ? h.textContent.trim() : '';
      show(id, title);
      try { history.pushState({ videoModal: true, id: id, title: title }, '', href); } catch (err) {}
    });
    function requestClose() {
      if (!open) return;
      if (history.state && history.state.videoModal) history.back();
      else hide();
    }
    modal.querySelectorAll('[data-close]').forEach(function (el) { el.addEventListener('click', requestClose); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') requestClose(); });
    window.addEventListener('popstate', function () {
      var st = history.state;
      if (st && st.videoModal) { if (!open) show(st.id, st.title); }
      else if (open) hide();
    });

    // Vidéos intégrées dans les articles : clic sur la façade → chargement en place.
    document.addEventListener('click', function (e) {
      var f = e.target.closest('.yt-facade');
      if (!f) return;
      var id = f.getAttribute('data-id');
      var iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
      iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('title', 'Lecteur vidéo');
      iframe.className = 'yt-iframe';
      f.replaceWith(iframe);
    });

    // Partage : « copier le lien » + bouton natif (mobile) — pour TOUS les blocs .share
    // du document (popup vidéo, page article, page replay).
    if (navigator.share) {
      document.querySelectorAll('.share-native').forEach(function (b) { b.hidden = false; });
    }
    document.addEventListener('click', function (e) {
      var nat = e.target.closest('.share-native');
      if (nat) {
        var b1 = nat.closest('.share');
        if (navigator.share) navigator.share({ title: b1.getAttribute('data-share-title') || document.title, url: b1.getAttribute('data-share-url') || location.href }).catch(function () {});
        return;
      }
      var cp = e.target.closest('.share-copy');
      if (cp) {
        var b2 = cp.closest('.share');
        var url = b2.getAttribute('data-share-url') || location.href;
        if (navigator.clipboard) navigator.clipboard.writeText(url).then(function () {
          cp.classList.add('is-copied');
          setTimeout(function () { cp.classList.remove('is-copied'); }, 1600);
        }).catch(function () {});
      }
    });
  })();
</script>
