---
import SocialLinks from './SocialLinks.astro';
import Logo from './Logo.astro';

interface Props { active?: string }
const { active } = Astro.props;

// Date du jour, format « Dim. 12 juil. »
const fmt = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' });
let today = fmt.format(new Date());
today = today.charAt(0).toUpperCase() + today.slice(1);
---
<div class="util">
  <div class="wrap">
    <div class="left">
      <span class="on-air"><span class="pulse"></span>ON AIR</span>
      <span><b id="js-today">{today}</b></span>
      <span class="hide">Web TV associative</span>
    </div>
    <div class="right">
      <SocialLinks compact />
    </div>
  </div>
</div>

<header class="masthead">
  <div class="wrap">
    <Logo />
    <nav class="main">
      <a href="/" class={active === 'direct' ? 'active' : ''}>Accueil</a>
      <a href="/programme" class={active === 'programme' ? 'active' : ''}>Programme</a>
      <a href="/disciplines" class={active === 'disciplines' ? 'active' : ''}>Disciplines</a>
      <a href="/actualites" class={active === 'actualites' ? 'active' : ''}>Actualités</a>
    </nav>
    <div class="mast-actions">
      <a href="/recherche" class={active === 'recherche' ? 'search-link active' : 'search-link'} aria-label="Rechercher">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.65" y2="16.65"></line></svg>
      </a>
      <a href="/direct" class="btn">▸ Regarder le direct</a>
      <button class="menu-btn" id="menu-btn" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-nav" id="mobile-nav">
  <a href="/" class={active === 'direct' ? 'active' : ''}>Accueil</a>
  <a href="/programme" class={active === 'programme' ? 'active' : ''}>Programme</a>
  <a href="/disciplines" class={active === 'disciplines' ? 'active' : ''}>Disciplines</a>
  <a href="/actualites" class={active === 'actualites' ? 'active' : ''}>Actualités</a>
  <a href="/recherche" class={active === 'recherche' ? 'active' : ''}>Rechercher</a>
  <a href="/direct">▸ Regarder le direct</a>
</nav>

<script is:inline>
  // Date du jour, calculée dans le navigateur → toujours à jour (pas figée au build).
  (function () {
    var el = document.getElementById('js-today');
    if (!el) return;
    try {
      var d = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' }).format(new Date());
      el.textContent = d.charAt(0).toUpperCase() + d.slice(1);
    } catch (e) {}
  })();

  (function () {
    var btn = document.getElementById('menu-btn');
    var panel = document.getElementById('mobile-nav');
    if (!btn || !panel) return;
    btn.addEventListener('click', function () {
      var open = panel.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    });
  })();
</script>
