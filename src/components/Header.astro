---
import SocialLinks from './SocialLinks.astro';
import Logo from './Logo.astro';

interface Props { active?: string }
const { active } = Astro.props;

// Date du jour, format « Dim. 12 juil. »
const fmt = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' });
let today = fmt.format(new Date());
today = today.charAt(0).toUpperCase() + today.slice(1);
---
<div class="util">
  <div class="wrap">
    <div class="left">
      <a class="on-air" id="js-onair" href="/direct" hidden><span class="pulse"></span>En direct</a>
      <span><b id="js-today">{today}</b></span>
      <span class="hide">Web TV associative</span>
    </div>
    <div class="right">
      <SocialLinks compact />
    </div>
  </div>
</div>

<header class="masthead">
  <div class="wrap">
    <Logo />
    <span class="xmas-hat" aria-hidden="true">
      <svg viewBox="0 0 80 66" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 48 C16 20 42 6 64 11 C59 20 55 28 57 40 C45 35 24 37 15 48 Z" fill="#d12f2f"/>
        <path d="M7 46 Q40 35 63 46 Q40 57 7 46 Z" fill="#fbfbfb"/>
        <circle cx="65" cy="11" r="9" fill="#fbfbfb"/>
      </svg>
    </span>
    <nav class="main">
      <a href="/" class={active === 'direct' ? 'active' : ''}>Accueil</a>
      <a href="/programme" class={active === 'programme' ? 'active' : ''}>Programme</a>
      <a href="/disciplines" class={active === 'disciplines' ? 'active' : ''}>Disciplines</a>
      <a href="/actualites" class={active === 'actualites' ? 'active' : ''}>Actualités</a>
    </nav>
    <div class="mast-actions">
      <a href="/recherche" class={active === 'recherche' ? 'search-link active' : 'search-link'} aria-label="Rechercher">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.65" y2="16.65"></line></svg>
      </a>
      <a href="/direct" class="btn">▸ Regarder le direct</a>
      <a href="/direct" class="btn-live" aria-label="Regarder le direct">▸ Direct</a>
      <button class="menu-btn" id="menu-btn" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav">
    <a href="/" class={active === 'direct' ? 'active' : ''}>Accueil</a>
    <a href="/programme" class={active === 'programme' ? 'active' : ''}>Programme</a>
    <a href="/disciplines" class={active === 'disciplines' ? 'active' : ''}>Disciplines</a>
    <a href="/actualites" class={active === 'actualites' ? 'active' : ''}>Actualités</a>
    <a href="/recherche" class={active === 'recherche' ? 'active' : ''}>Rechercher</a>
    <a href="/direct">▸ Regarder le direct</a>
  </nav>
</header>

{/* Guirlande de Noël sous le menu (variante « guirlandes » ; activée par data-xmas-style) */}
<div class="xmas-garland" aria-hidden="true">{Array.from({ length: 40 }).map(() => <span></span>)}</div>

<script is:inline>
  // Thème HALLOWEEN : s'active tout seul pendant la fenêtre ci-dessous (calcul dans le
  // navigateur → s'allume et s'éteint sans redéploiement), retour au header habituel après.
  // Aperçu immédiat hors fenêtre : ajouter ?halloween=1 à l'URL.
  (function () {
    try {
      var START = new Date('2026-10-30T19:00:00');   // allumage : vendredi 30/10 à 19h
      var END = new Date('2026-11-02T06:00:00');      // extinction : lundi 02/11 au matin (retour habituel)
      var force = /[?&]halloween=1(?:&|$)/.test(location.search);
      if (force || (Date.now() >= START.getTime() && Date.now() < END.getTime())) {
        document.documentElement.setAttribute('data-hw', '1');
      }
    } catch (e) {}
  })();

  // Thème NOËL — même principe. Fenêtre à fixer.
  // Le décor est composé de « tokens » (village / garland / hat / baubles / sport) : chaque aperçu
  // en active un sous-ensemble, ce qui rend les combinaisons triviales.
  //   ?noel=1 village seul · ?noel=2 guirlande+boules · ?noel=3 bonnet+ballons · ?noel=4 village+guirlande+bonnet
  (function () {
    try {
      var START = new Date('2026-12-20T00:00:00');  // allumage : samedi 20/12 à minuit
      var END = new Date('2026-12-29T00:00:00');     // extinction : visible jusqu'au 28/12 inclus (relais Nouvel An le 30/12)
      var s = location.search;
      var f1 = /[?&]noel=1(?:&|$)/.test(s), f2 = /[?&]noel=2(?:&|$)/.test(s),
          f3 = /[?&]noel=3(?:&|$)/.test(s), f4 = /[?&]noel=4(?:&|$)/.test(s);
      if (f1 || f2 || f3 || f4 || (Date.now() >= START.getTime() && Date.now() < END.getTime())) {
        document.documentElement.setAttribute('data-xmas', '1');
        var style = f1 ? 'village'
                  : f2 ? 'garland baubles'
                  : f3 ? 'hat sport'
                  : 'village garland hat'; // ?noel=4 et fenêtre de dates = combo retenu (village + guirlande + bonnet)
        document.documentElement.setAttribute('data-xmas-style', style);
      }
    } catch (e) {}
  })();

  // Date du jour, calculée dans le navigateur → toujours à jour (pas figée au build).
  (function () {
    var el = document.getElementById('js-today');
    if (!el) return;
    try {
      var d = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' }).format(new Date());
      el.textContent = d.charAt(0).toUpperCase() + d.slice(1);
    } catch (e) {}
  })();

  // Badge « En direct » : affiché UNIQUEMENT quand un live est réellement en cours
  // (live.json, régénéré toutes les 5 min). Sinon masqué — plus de « ON AIR » permanent.
  (function () {
    var el = document.getElementById('js-onair');
    if (!el) return;
    function sync() {
      fetch('/live.json?_=' + Date.now(), { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { el.hidden = !(d && d.live); })
        .catch(function () {});
    }
    sync();
    setInterval(sync, 60000);
  })();

  (function () {
    var btn = document.getElementById('menu-btn');
    var panel = document.getElementById('mobile-nav');
    if (!btn || !panel) return;
    btn.addEventListener('click', function () {
      var open = panel.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    });
  })();
</script>

<style is:global>
  /* ======= Thème HALLOWEEN (activé par data-hw="1" sur <html>, cf. script ci-dessus) =======
     Déployé une fois : s'allume pendant la fenêtre et revient au header habituel après,
     sans redéploiement. Toiles d'araignée dans les coins, bandeau nuit, bouton citrouille. */
  :root[data-hw="1"] .util {
    background: linear-gradient(90deg, #170b26 0%, #3a1608 100%);
    color: #ffcf8a; border-bottom: 1px solid #4a2a12;
  }
  :root[data-hw="1"] .util .left { color: #ffcf8a; }
  :root[data-hw="1"] .util .left b { color: #ff8c1a; }
  :root[data-hw="1"] .util .right { color: #ffcf8a; }
  :root[data-hw="1"] .util .right a:hover { color: #ff8c1a; }
  :root[data-hw="1"] .util .left::after {
    content: "🎃 Spécial Halloween"; font-weight: 700; color: #ff8c1a; white-space: nowrap;
  }
  :root[data-hw="1"] .util .right::before {
    content: "🦇"; font-size: 13px; animation: hw-bat 3s ease-in-out infinite;
  }

  /* Toiles d'araignée dans les coins du masthead (la droite s'efface sur petit écran) */
  :root[data-hw="1"] .masthead::before,
  :root[data-hw="1"] .masthead::after {
    content: "🕸️"; position: absolute; top: -2px; font-size: 28px; opacity: .5;
    pointer-events: none; z-index: 1;
  }
  :root[data-hw="1"] .masthead::before { left: 2px; }
  :root[data-hw="1"] .masthead::after { right: 2px; transform: scaleX(-1); }

  /* Bouton « Regarder le direct » en citrouille lumineuse */
  :root[data-hw="1"] .masthead .btn,
  :root[data-hw="1"] .btn-live {
    background: linear-gradient(180deg, #ff8c1a, #e8600b); color: #1a0f04;
    box-shadow: 0 0 0 1px rgba(255,140,26,.55), 0 6px 18px rgba(255,120,20,.45);
  }
  :root[data-hw="1"] .masthead .btn:hover,
  :root[data-hw="1"] .btn-live:hover { background: linear-gradient(180deg, #ff9f3d, #d1560a); }
  :root[data-hw="1"] nav.main a.active { border-color: #ff8c1a; }
  :root[data-hw="1"] .search-link.active { color: #ff8c1a; }

  @keyframes hw-bat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) { :root[data-hw="1"] .util .right::before { animation: none; } }
  @media (max-width: 900px) { :root[data-hw="1"] .masthead::after { display: none; } }
  @media (max-width: 640px) {
    :root[data-hw="1"] .masthead::before { font-size: 22px; }
    :root[data-hw="1"] .util .left::after { content: "🎃 Halloween"; }
  }

  /* ---- Décor Halloween du hero d'accueil (markup .hw-deco / .hw-pumpkin dans index.astro) ---- */
  .hw-deco, .hw-pumpkin, .hw-scene { display: none; }
  :root[data-hw="1"] .hw-deco { display: block; position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  :root[data-hw="1"] .hw-web { position: absolute; top: -10px; font-size: 48px; opacity: .4; }
  :root[data-hw="1"] .hw-web-l { left: -8px; }
  :root[data-hw="1"] .hw-web-r { right: -8px; transform: scaleX(-1); }
  /* citrouille d'Halloween, centrée entre le compte à rebours (gauche) et la vidéo (droite) */
  /* scène en arrière-plan : marécage deviné + fumée qui dérive */
  :root[data-hw="1"] .hw-scene { display: block; position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  /* brume qui couvre toute l'image, en nappes qui dérivent lentement */
  :root[data-hw="1"] .hw-fog { position: absolute; border-radius: 50%; filter: blur(36px); mix-blend-mode: screen;
    background: radial-gradient(ellipse at center, rgba(178,190,208,.5), rgba(178,190,208,0) 70%); }
  :root[data-hw="1"] .hw-fog-1 { width: 540px; height: 210px; left: -5%; top: 8%;   opacity: .4;  animation: hw-drift 30s ease-in-out infinite; }
  :root[data-hw="1"] .hw-fog-2 { width: 640px; height: 240px; right: -6%; top: 22%; opacity: .34; animation: hw-drift 42s ease-in-out infinite reverse; }
  :root[data-hw="1"] .hw-fog-3 { width: 720px; height: 280px; left: 26%; top: 40%;  opacity: .3;  animation: hw-drift 36s ease-in-out infinite; animation-delay: -8s; }
  :root[data-hw="1"] .hw-fog-4 { width: 500px; height: 200px; left: 2%;  bottom: 0%; opacity: .42; animation: hw-drift 28s ease-in-out infinite reverse; animation-delay: -14s; }
  :root[data-hw="1"] .hw-fog-5 { width: 580px; height: 220px; right: 1%; bottom: 4%; opacity: .36; animation: hw-drift 38s ease-in-out infinite; animation-delay: -5s; }
  @keyframes hw-drift { 0%, 100% { transform: translateX(-18px); } 50% { transform: translateX(26px); } }
  @media (prefers-reduced-motion: reduce) { :root[data-hw="1"] .hw-fog { animation: none; } }

  /* grosse citrouille EN ARRIÈRE-PLAN (z-index 0) : derrière le cadre vidéo et les textes, elle émerge du bas */
  :root[data-hw="1"] .hw-pumpkin { display: block; position: absolute; left: 50%; bottom: -90px; transform: translateX(-50%);
    width: 430px; z-index: 0; pointer-events: none; filter: drop-shadow(0 0 34px rgba(255,140,30,.28)); }
  :root[data-hw="1"] .hw-pumpkin svg { display: block; width: 100%; height: auto; }
  @media (max-width: 900px) {
    /* le hero passe en 1 colonne : plus d'espace « entre » le compte à rebours et la vidéo */
    :root[data-hw="1"] .hw-pumpkin, :root[data-hw="1"] .hw-scene { display: none; }
  }
  @media (max-width: 640px) {
    :root[data-hw="1"] .hw-web { font-size: 34px; }
    :root[data-hw="1"] .hw-web-r { display: none; }
  }

  /* ================= Thème NOËL (data-xmas="1") =================
     Décor modulaire par tokens dans data-xmas-style (ex. "village garland hat") :
       village = skyline enneigée · garland = guirlande LED sous le menu · baubles = boules suspendues
       hat = bonnet sur le logo · sport = ballons de sport suspendus
     Aperçus : ?noel=1 village · ?noel=2 guirlande+boules · ?noel=3 bonnet+ballons · ?noel=4 village+guirlande+bonnet */
  .xmas-scene, .xmas-village { display: none; }
  /* header festif */
  :root[data-xmas="1"] .util { background: linear-gradient(90deg, #5a1113 0%, #0e3b24 100%); color: #ffe9b8; border-bottom: 1px solid #6b2a1e; }
  :root[data-xmas="1"] .util .left { color: #ffe9b8; }
  :root[data-xmas="1"] .util .left b { color: #ffd54a; }
  :root[data-xmas="1"] .util .right { color: #ffe9b8; }
  :root[data-xmas="1"] .util .right a:hover { color: #ffd54a; }
  :root[data-xmas="1"] .util .left::after { content: "🎄 Joyeuses fêtes"; font-weight: 700; color: #ffd54a; white-space: nowrap; }
  :root[data-xmas="1"] .util .right::before { content: "❄"; color: #cfe6ff; font-size: 13px; }
  :root[data-xmas="1"] .masthead::before, :root[data-xmas="1"] .masthead::after { content: "❄"; position: absolute; top: 2px; font-size: 20px; color: #dcecff; opacity: .5; pointer-events: none; z-index: 1; }
  :root[data-xmas="1"] .masthead::before { left: 6px; } :root[data-xmas="1"] .masthead::after { right: 6px; }
  :root[data-xmas="1"] .masthead .btn, :root[data-xmas="1"] .btn-live { background: linear-gradient(180deg, #e0413a, #b5231d); color: #fff; box-shadow: 0 0 0 1px rgba(224,65,58,.5), 0 6px 16px rgba(200,30,25,.4); }
  :root[data-xmas="1"] .masthead .btn:hover, :root[data-xmas="1"] .btn-live:hover { background: linear-gradient(180deg, #ee5a52, #9e1c17); }
  :root[data-xmas="1"] nav.main a.active { border-color: #e0413a; }

  /* scène hero : lune, étoiles, village, neige */
  :root[data-xmas="1"] .xmas-scene { display: block; position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  :root[data-xmas-style~="village"] .xmas-moon { position: absolute; top: 18px; right: 8%; width: 70px; height: 70px; border-radius: 50%;
    background: radial-gradient(circle at 38% 36%, #fdfbf0, #e7eef7 60%, #cdd8e8 100%); box-shadow: 0 0 44px 12px rgba(220,232,250,.35); opacity: .9; }
  :root[data-xmas-style~="village"] .xmas-stars { position: absolute; left: 0; right: 0; top: 0; height: 62%;
    background-image: radial-gradient(1.4px 1.4px at 12% 24%, #fff, transparent), radial-gradient(1.2px 1.2px at 28% 52%, #fff, transparent),
      radial-gradient(1.6px 1.6px at 46% 18%, #fff, transparent), radial-gradient(1.2px 1.2px at 63% 42%, #fff, transparent),
      radial-gradient(1.4px 1.4px at 78% 28%, #fff, transparent), radial-gradient(1.2px 1.2px at 90% 54%, #fff, transparent),
      radial-gradient(1.2px 1.2px at 36% 34%, #fff, transparent), radial-gradient(1.4px 1.4px at 70% 14%, #fff, transparent);
    opacity: .55; animation: xmas-tw 5s ease-in-out infinite alternate; }
  @keyframes xmas-tw { from { opacity: .35; } to { opacity: .75; } }
  :root[data-xmas-style~="village"] .xmas-village { display: block; position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 96%; }
  :root[data-xmas-style~="village"] .vl-hill { fill: #1b3048; }
  :root[data-xmas-style~="village"] .vl-far { fill: #223a56; opacity: .7; }
  :root[data-xmas-style~="village"] .vl-chim { fill: #1a2d44; }
  :root[data-xmas-style~="village"] .vl-snow { fill: url(#vlSnowG); }
  :root[data-xmas-style~="village"] .vl-tree path { fill: #1a5235; }
  :root[data-xmas-style~="village"] .vl-house rect { fill: #243b58; }
  :root[data-xmas-style~="village"] .vl-roof { fill: #2c466a; }
  :root[data-xmas-style~="village"] .vl-cap { fill: #f3f7fc; }
  :root[data-xmas-style~="village"] .vl-win { fill: #ffd97a; filter: drop-shadow(0 0 4px rgba(255,200,90,.9)); }
  :root[data-xmas-style~="village"] .vl-star2 { fill: #ffd54a; }
  :root[data-xmas-style~="village"] .vl-fir { fill: #1d6b38; stroke: #0f4425; stroke-width: 2; }
  :root[data-xmas-style~="village"] .vl-glow { fill: #dff3e6; opacity: .18; filter: blur(7px); }
  :root[data-xmas-style~="village"] .vl-r { color: #ff5a4d; } :root[data-xmas-style~="village"] .vl-y { color: #ffd23f; } :root[data-xmas-style~="village"] .vl-b { color: #63b3ff; }
  :root[data-xmas-style~="village"] .vl-light circle { fill: currentColor; filter: drop-shadow(0 0 3px currentColor); }
  :root[data-xmas-style~="village"] .vl-r { animation: xmas-tw 1.8s ease-in-out infinite alternate; }
  :root[data-xmas-style~="village"] .vl-y { animation: xmas-tw 1.8s ease-in-out .6s infinite alternate; }
  :root[data-xmas-style~="village"] .vl-b { animation: xmas-tw 1.8s ease-in-out 1.2s infinite alternate; }
  :root[data-xmas-style~="village"] .vl-star { fill: #ffe066; filter: drop-shadow(0 0 7px rgba(255,214,80,.85)); }

  :root[data-xmas="1"] .xmas-snow { position: absolute; inset: 0; pointer-events: none; }
  :root[data-xmas="1"] .xmas-snow-1 { background-image:
      radial-gradient(2px 2px at 20px 30px, #fff, transparent), radial-gradient(2px 2px at 110px 80px, #fff, transparent),
      radial-gradient(1.6px 1.6px at 170px 140px, #fff, transparent), radial-gradient(2px 2px at 60px 180px, #fff, transparent);
    background-size: 200px 200px; opacity: .9; animation: xmas-fall1 9s linear infinite; }
  :root[data-xmas="1"] .xmas-snow-2 { background-image:
      radial-gradient(3px 3px at 50px 60px, #fff, transparent), radial-gradient(2.4px 2.4px at 150px 20px, #fff, transparent),
      radial-gradient(3px 3px at 210px 120px, #fff, transparent), radial-gradient(2.4px 2.4px at 90px 170px, #fff, transparent);
    background-size: 260px 260px; opacity: .8; animation: xmas-fall2 6.5s linear infinite; }
  :root[data-xmas="1"] .xmas-snow-3 { background-image:
      radial-gradient(1.4px 1.4px at 30px 50px, #fff, transparent), radial-gradient(1.4px 1.4px at 120px 110px, #fff, transparent),
      radial-gradient(1.2px 1.2px at 180px 40px, #fff, transparent);
    background-size: 160px 160px; opacity: .6; animation: xmas-fall3 13s linear infinite; }
  @keyframes xmas-fall1 { to { background-position: 30px 200px; } }
  @keyframes xmas-fall2 { to { background-position: -40px 260px; } }
  @keyframes xmas-fall3 { to { background-position: 16px 160px; } }

  /* ---- token « garland » : guirlande de LED sous le menu ---- */
  .xmas-garland { display: none; }
  :root[data-xmas-style~="garland"] .xmas-garland { display: flex; justify-content: space-between; align-items: flex-start;
    position: sticky; top: 74px; z-index: 39; height: 0; padding: 0 14px; pointer-events: none; border-top: 2px solid #2e5b35; }
  :root[data-xmas-style~="garland"] .xmas-garland span { width: 9px; height: 13px; border-radius: 50% 50% 55% 55% / 44% 44% 62% 62%;
    position: relative; animation: xmas-blink 2.4s ease-in-out infinite; }
  :root[data-xmas-style~="garland"] .xmas-garland span::before { content: ""; position: absolute; left: 50%; top: -4px; width: 2px; height: 4px; background: #2e5b35; transform: translateX(-50%); }
  :root[data-xmas-style~="garland"] .xmas-garland span:nth-child(4n+1) { background: #e23b3b; box-shadow: 0 0 8px 1px rgba(226,59,59,.8); }
  :root[data-xmas-style~="garland"] .xmas-garland span:nth-child(4n+2) { background: #e7b53c; box-shadow: 0 0 8px 1px rgba(231,181,60,.8); }
  :root[data-xmas-style~="garland"] .xmas-garland span:nth-child(4n+3) { background: #3f7fd6; box-shadow: 0 0 8px 1px rgba(63,127,214,.8); }
  :root[data-xmas-style~="garland"] .xmas-garland span:nth-child(4n+4) { background: #49b36a; box-shadow: 0 0 8px 1px rgba(73,179,106,.8); }
  :root[data-xmas-style~="garland"] .xmas-garland span:nth-child(3n+2) { animation-delay: .8s; }
  :root[data-xmas-style~="garland"] .xmas-garland span:nth-child(3n+3) { animation-delay: 1.6s; }
  @keyframes xmas-blink { 0%, 100% { opacity: 1; } 50% { opacity: .32; } }

  /* ---- token « baubles » : boules suspendues dans le hero ---- */
  .xmas-baubles { display: none; }
  :root[data-xmas-style~="baubles"] .xmas-baubles { display: block; position: absolute; inset: 0; pointer-events: none; }
  :root[data-xmas-style~="baubles"] .xb { position: absolute; top: 0; width: var(--s); height: var(--s);
    transform-origin: 50% -180px; animation: xb-sway 5.5s ease-in-out infinite; animation-delay: var(--d); }
  :root[data-xmas-style~="baubles"] .xb::before { content: ""; position: absolute; left: 50%; bottom: 100%; width: 1px; height: 180px; transform: translateX(-50%);
    background: linear-gradient(rgba(220,230,245,.4), rgba(220,230,245,.06)); }
  :root[data-xmas-style~="baubles"] .xb::after { content: ""; position: absolute; inset: 0; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(255,255,255,.95), var(--c) 55%, color-mix(in srgb, var(--c) 55%, #000) 100%);
