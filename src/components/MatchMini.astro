---
// Mini-carte d'un match : 2 joueurs (photo + nom + score), vainqueur surligné.
// CLIQUABLE : au clic, ouvre la fenêtre « Face-à-face » (données dans data-cf).
// Réutilisée dans les poules et la phase finale du tableau d'un tournoi.
import { photoOf } from '../lib/billardStats';
interface Props { m: any; seasonSlug: string; cf: any; label?: string; gold?: boolean; }
const { m, seasonSlug, cf, label, gold } = Astro.props as Props;
const ph = (id: number, name: string) => photoOf({ id, name } as any, seasonSlug);
const rows = [
  { id: m.aId, name: m.aName, my: m.sA, opp: m.sB },
  { id: m.bId, name: m.bName, my: m.sB, opp: m.sA },
];
---
<button type="button" class:list={['mm', { gold }]} data-cf={JSON.stringify(cf)}>
  {label && <div class="mm-lab">{label}</div>}
  {rows.map((p) => (
    <span class:list={['mm-p', { win: p.my > p.opp }]}>
      <span class="mm-ph"><span class="bavatar">{p.name.slice(0, 1)}</span>{ph(p.id, p.name) && <img src={ph(p.id, p.name)} alt="" loading="lazy" onerror="this.remove()" />}</span>
      <span class="mm-nm">{p.name}</span>
      <span class="mm-sc">{p.my}</span>
    </span>
  ))}
  <span class="mm-go">Face-à-face →</span>
</button>

<style>
  .mm { position: relative; display: block; width: 100%; border: 1px solid var(--line); border-radius: 11px; overflow: hidden; background: var(--surface); padding: 0; font: inherit; text-align: left; cursor: pointer; transition: border-color .12s, box-shadow .12s; }
  .mm:hover { border-color: var(--c-billard); box-shadow: 0 4px 14px color-mix(in srgb, var(--c-billard) 14%, transparent); }
  .mm.gold { border: 2px solid #E4B23C; box-shadow: 0 6px 18px color-mix(in srgb, #E4B23C 18%, transparent); }
  .mm.gold:hover { box-shadow: 0 6px 20px color-mix(in srgb, #E4B23C 26%, transparent); }
  .mm-lab { font-size: 9px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-faint); padding: 5px 11px 1px; }
  .mm-p { display: flex; align-items: center; gap: 9px; padding: 7px 11px; color: var(--ink); }
  .mm-p:not(:last-of-type) { border-bottom: 1px solid var(--line); }
  .mm-p.win { background: color-mix(in srgb, var(--c-billard) 9%, var(--surface)); }
  .mm.gold .mm-p.win { background: color-mix(in srgb, #E4B23C 13%, var(--surface)); }
  .mm-ph { position: relative; width: 28px; height: 28px; border-radius: 50%; overflow: hidden; background: var(--surface-2); border: 1px solid var(--line); display: grid; place-items: center; flex: none; }
  .mm-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .mm-ph .bavatar { font-family: var(--display); font-weight: 800; font-size: 12px; color: var(--ink-faint); }
  .mm-nm { flex: 1; min-width: 0; font-size: 13.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mm-p.win .mm-nm { font-weight: 800; }
  .mm-sc { font-family: var(--mono); font-weight: 800; font-size: 15px; color: var(--ink-faint); flex: none; }
  .mm-p.win .mm-sc { color: var(--c-billard); }
  .mm.gold .mm-p.win .mm-sc { color: #b08400; }
  .mm-go { display: block; text-align: center; font-size: 9.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: var(--c-billard); background: color-mix(in srgb, var(--c-billard) 7%, var(--surface)); border-top: 1px solid var(--line); padding: 4px; opacity: 0; max-height: 0; transition: opacity .15s, max-height .15s; }
  .mm:hover .mm-go, .mm:focus-visible .mm-go { opacity: .9; max-height: 24px; }
</style>
