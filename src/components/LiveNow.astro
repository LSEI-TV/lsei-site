---
// Bandeau « EN DIRECT » universel pour les pages de sport. S'affiche tout seul en haut
// de la page quand CE sport est en direct (lu depuis /live.json, rafraîchi toutes les 60 s).
// Clic → /direct/ (lecteur inline + onglets multi-live).
//   <LiveNow sport="basket" />   slug : basket · billard · palets · bowling · football · beach · subbuteo
interface Props { sport: string }
const { sport } = Astro.props;
---
<div class="livenow-outer" data-livenow data-sport={sport} hidden>
  <div class="wrap">
    <a class="livenow" href="/direct/" aria-label="Regarder le direct">
      <span class="livenow-badge"><span class="livenow-dot" aria-hidden="true"></span>EN DIRECT</span>
      <span class="livenow-body"><b class="livenow-match"></b><span class="livenow-ctx"></span></span>
      <span class="livenow-cta">▸ Regarder&nbsp;<span aria-hidden="true">→</span></span>
    </a>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('.livenow-outer[data-livenow]:not([data-wired])').forEach(function (box) {
      box.setAttribute('data-wired', '1');
      var sport = box.getAttribute('data-sport');
      function clean(t) {
        var p = (t || '').split('|').map(function (x) { return x.trim(); }).filter(Boolean);
        return p.length > 1 ? p[p.length - 1] : (t || '').replace(/^[^\p{L}\p{N}(]+/u, '').trim();
      }
      function refresh() {
        fetch('/live.json', { cache: 'no-store' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            var lives = (d && d.lives) ? d.lives : (d && d.live && d.id ? [{ id: d.id, title: d.title || 'Direct', discipline: d.discipline || '' }] : []);
            var l = lives.filter(function (x) { return x.discipline === sport; })[0];
            if (!l) { box.hidden = true; return; }
            var m = box.querySelector('.livenow-match'); if (m) m.textContent = l.match || clean(l.title);
            var ctx = l.context || ''; if (l.place) ctx = ctx ? (ctx + ' · 📍 ' + l.place) : ('📍 ' + l.place);
            var c = box.querySelector('.livenow-ctx'); if (c) c.textContent = ctx;
            box.hidden = false;
          })
          .catch(function () { /* live.json injoignable : on laisse masqué */ });
      }
      refresh(); setInterval(refresh, 60000);
    });
  })();
</script>

<style is:global>
  .livenow-outer[hidden] { display: none !important; }
  .livenow-outer { margin: 14px 0 0; }
  a.livenow {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 12px 18px; border-radius: 14px; text-decoration: none; color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--live) 45%, transparent);
    background: color-mix(in srgb, var(--live) 12%, var(--surface));
    transition: background .15s, border-color .15s;
  }
  a.livenow:hover { background: color-mix(in srgb, var(--live) 18%, var(--surface)); border-color: var(--live); }
  .livenow-badge { display: inline-flex; align-items: center; gap: 8px; flex: none; color: #fff; background: var(--live);
    font-weight: 800; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; }
  .livenow-dot { width: 8px; height: 8px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 0 rgba(255,255,255,.75); animation: livenow-pulse 1.6s infinite; }
  @keyframes livenow-pulse { 70% { box-shadow: 0 0 0 7px rgba(255,255,255,0); } 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); } }
  @media (prefers-reduced-motion: reduce) { .livenow-dot { animation: none; } }
  .livenow-body { display: flex; flex-direction: column; min-width: 0; flex: 1 1 200px; }
  .livenow-match { font-family: var(--display); font-weight: 800; font-size: 16px; line-height: 1.2; color: var(--ink); overflow: hidden; text-overflow: ellipsis; }
  .livenow-ctx { font-size: 12px; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .03em; }
  .livenow-ctx:empty { display: none; }
  .livenow-cta { flex: none; font-weight: 800; color: var(--live); white-space: nowrap; }
</style>
