---
// Bandeau « affiche » d'une page de match : les 2 adversaires face à face
// (logos des clubs au basket, photos détourées des joueurs au billard), le score si connu,
// la compétition et la date. Données : lib/matchAffiche.ts (reconnaissance automatique du titre).
import type { Affiche } from '../lib/matchAffiche';

interface Props { a: Affiche; kicker: string; when?: string; place?: string; color: string }
const { a, kicker, when, place, color } = Astro.props;
const [L, R] = a.sides;
---
<section class={`ma ma--${a.sport}`} style={`--dc:${color}`}>
  <div class="wrap ma-in">
    <div class="ma-k">{kicker}{a.round ? ` · Journée ${a.round}` : ''}</div>
    <div class="ma-row">
      {[L, R].map((s, i) => (
        <Fragment>
          {i === 1 && (
            <div class="ma-mid">
              {a.score
                ? <div class="ma-score"><b class={a.score[0] > a.score[1] ? 'w' : ''}>{a.score[0]}</b><i>–</i><b class={a.score[1] > a.score[0] ? 'w' : ''}>{a.score[1]}</b></div>
                : <div class="ma-vs">VS</div>}
              {a.score && <div class="ma-fin">Score final</div>}
            </div>
          )}
          {(() => {
            const inner = (
              <Fragment>
                <span class={`ma-img ${s.cut ? 'is-cut' : ''} ${a.sport === 'basket' ? 'is-logo' : ''}`}>
                  {s.img ? <img src={s.img} alt={s.name} loading="eager" onerror="this.remove()" /> : <b>{(s.short || s.name).slice(0, 3)}</b>}
                </span>
                <span class="ma-name">{s.name}</span>
                {s.rank && <span class="ma-rank">{s.rank}<sup>{s.rank === 1 ? 'er' : 'e'}</sup> du classement</span>}
              </Fragment>
            );
            return s.href
              ? <a class={`ma-side ${s.win ? 'is-win' : ''} ${s.win === false ? 'is-loss' : ''}`} href={s.href}>{inner}</a>
              : <div class={`ma-side ${s.win ? 'is-win' : ''} ${s.win === false ? 'is-loss' : ''}`}>{inner}</div>;
          })()}
        </Fragment>
      ))}
    </div>
    {(when || place) && <div class="ma-when">{when}{when && place ? ' · ' : ''}{place && `📍 ${place}`}</div>}
  </div>
</section>

<style>
  .ma { position: relative; overflow: hidden; color: #fff;
    background: radial-gradient(60% 120% at 50% 0%, color-mix(in srgb, var(--dc) 34%, #0A0E1A) 0%, #0A0E1A 70%), #0A0E1A; }
  .ma::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--brand-bars, var(--dc)); }
  .ma-in { padding-top: 30px; padding-bottom: 30px; text-align: center; }
  .ma-k { font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: color-mix(in srgb, var(--dc) 55%, #fff); }
  .ma-row { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 18px; margin-top: 18px; }
  .ma-side { display: flex; flex-direction: column; align-items: center; gap: 10px; text-decoration: none; color: #fff; min-width: 0; transition: transform .25s cubic-bezier(.2,.7,.2,1); }
  a.ma-side:hover { transform: translateY(-3px); }
  a.ma-side:hover .ma-name { text-decoration: underline; }
  .ma-img { position: relative; width: 150px; height: 150px; border-radius: 50%; display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(ellipse at 50% 30%, #2b5f99 0%, #0d2c49 75%); border: 3px solid rgba(255,255,255,.16); box-shadow: 0 16px 36px -14px rgba(0,0,0,.7); }
  .ma-img img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .ma-img.is-cut img { object-fit: contain; object-position: bottom center; transform: translateY(6%) scale(1.06); }
  .ma-img.is-logo { background: #fff; border-color: #fff; }
  .ma-img.is-logo img { width: 80%; height: 80%; object-fit: contain; object-position: center; }
  .ma-img b { font-family: var(--display); font-size: 34px; color: rgba(255,255,255,.75); }
  .ma-img.is-logo b { color: #0A0E1A; }
  .ma-name { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(18px, 2.4vw, 28px); line-height: 1.02; }
  .ma-rank { font-size: 12px; font-weight: 700; color: rgba(255,255,255,.65); }
  .ma-side.is-win .ma-img { border-color: #E4B23C; box-shadow: 0 0 0 4px rgba(228,178,60,.25), 0 16px 36px -14px rgba(0,0,0,.7); }
  .ma-side.is-loss .ma-name { opacity: .7; }
  .ma-mid { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .ma-score { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 800; font-size: clamp(40px, 6vw, 72px); line-height: 1; }
  .ma-score b { color: rgba(255,255,255,.7); font-weight: 800; }
  .ma-score b.w { color: #fff; }
  .ma-score i { font-style: normal; color: var(--dc); }
  .ma-vs { font-family: var(--display); font-weight: 800; font-size: clamp(30px, 4vw, 48px); color: var(--dc); }
  .ma-fin { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55); }
  .ma-when { margin-top: 18px; font-size: 14px; font-weight: 600; color: rgba(255,255,255,.75); }
  @media (max-width: 560px) {
    .ma-row { gap: 8px; }
    .ma-img { width: 92px; height: 92px; }
    .ma-name { font-size: 15px; }
    .ma-rank { font-size: 11px; }
  }
</style>
