---
import Base from '../../layouts/Base.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import Thumb from '../../components/Thumb.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import { getDiscipline } from '../../data/site';
import { getReplays } from '../../lib/youtube';
import channelBillard from '../../data/billard/channel-billard.json';
import { getSeasons } from '../../data/billard/seasons';
import { getFemmesSeasons } from '../../data/billard/seasonsFemmes';
import { getParaSeasons } from '../../data/billard/seasonsPara';
import { getParaMvSeasons } from '../../data/billard/seasonsParaMalvoyants';
import { playerSlugs } from '../../lib/billardStats';
import { titleMatchesPlayer, nameTokens } from '../../lib/videoMatch';

export async function getStaticPaths() {
  const videos = await getReplays();
  const have = new Set(videos.map((v) => v.id));
  const frDate = (iso: string) => (iso ? new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(iso)) : '');
  // Union : toute vidéo billard de la chaîne non présente dans le cache reçoit AUSSI
  // sa page /replay (sinon lien cassé depuis les fiches) → rich result vidéo pour TOUT.
  const extra = (channelBillard as { id: string; title: string; date?: string }[])
    .filter((c) => !have.has(c.id))
    .map((c) => {
      const iso = c.date ? (c.date.length === 10 ? `${c.date}T00:00:00Z` : c.date) : '';
      return { id: c.id, discipline: 'billard' as const, title: c.title, kicker: 'Replay', caption: 'Billard', when: frDate(iso), thumb: `https://i.ytimg.com/vi/${c.id}/hqdefault.jpg`, date: iso || undefined };
    });
  return [...videos, ...extra].map((v) => ({ params: { id: v.id }, props: { video: v } }));
}

const { video } = Astro.props;
const d = getDiscipline(video.discipline);
const shareUrl = new URL(`/replay/${video.id}`, Astro.site).href;

// Fiches des joueurs cités dans le titre (billard) → liens « Fiche joueur » sous le titre.
// Même reconnaissance par NOM DE FAMILLE que « Ses matchs en vidéo » des fiches (sens inverse).
// Catégorie déduite du titre ; à nom de famille égal, le joueur de la saison la plus récente l'emporte.
function titlePlayers(title: string): { name: string; href: string }[] {
  if (video.discipline !== 'billard' || !title || /snooker|chinese|\bpool\b|8\s*pool|am[eé]ricain/i.test(title)) return [];
  const [list, base] = /malvoyant/i.test(title) ? [getParaMvSeasons(), '/para-billard-malvoyants/joueur/']
    : /para.?billard|fauteuil/i.test(title) ? [getParaSeasons(), '/para-billard/joueur/']
    : /femme/i.test(title) ? [getFemmesSeasons(), '/femmes/joueur/']
    : [getSeasons(), '/billard/joueur/'];
  const { slugOf } = playerSlugs(list);
  const toks = nameTokens(title);
  const bySurname = new Map<string, { id: number; name: string; pos: number }>();
  for (const s of list) {                      // saisons de la plus récente à la plus ancienne
    if (!s.results) continue;
    for (const p of s.results.players as { id: number; name: string }[]) {
      if (!titleMatchesPlayer(title, p.name)) continue;
      const sur = nameTokens(p.name).filter((w) => w.length >= 3).pop() || '';
      if (!sur || bySurname.has(sur)) continue;
      const pos = toks.findIndex((w) => w === sur || (Math.min(w.length, sur.length) >= 5 && (w.includes(sur) || sur.includes(w))));
      bySurname.set(sur, { id: p.id, name: p.name, pos: pos < 0 ? 99 : pos });
    }
  }
  // Écriture homogène « Prénom NOM » (les données mélangent « Damien Joly » et « Kevin LEFRANCOIS »).
  const pretty = (n: string) => { const w = n.trim().split(/\s+/); return [w[0].charAt(0).toUpperCase() + w[0].slice(1).toLowerCase(), ...w.slice(1).map((x) => x.toUpperCase())].join(' '); };
  return [...bySurname.values()].sort((a, b) => a.pos - b.pos).slice(0, 4).map((p) => ({ name: pretty(p.name), href: base + slugOf(p.id) }));
}
const fiches = titlePlayers(video.title);

const all = await getReplays({ discipline: video.discipline });
const related = all.filter((v) => v.id !== video.id).slice(0, 3);

// Données structurées vidéo (SEO) : permet à Google d'afficher la vidéo
// avec sa miniature dans les résultats de recherche et l'onglet « Vidéos ».
const videoLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description: video.excerpt || `${video.title} — ${d.name} en replay sur LSEI, Le Sport en Image.`,
  // Plusieurs tailles de miniature → meilleure éligibilité aux rich results vidéo.
  thumbnailUrl: [
    `https://i.ytimg.com/vi/${video.id}/maxresdefault.jpg`,
    `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`,
    `https://i.ytimg.com/vi/${video.id}/mqdefault.jpg`,
  ],
  ...(video.date ? { uploadDate: video.date } : {}),
  ...(video.duration ? { duration: video.duration } : {}),
  embedUrl: `https://www.youtube.com/embed/${video.id}`,
  contentUrl: `https://www.youtube.com/watch?v=${video.id}`,
  publisher: {
    '@type': 'Organization',
    name: 'LSEI — Le Sport en Image',
    logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', Astro.site).href },
  },
};
---
<Base title={video.title} description={video.excerpt} active="replays" ogType="video.other" image={video.thumb}>
  <script type="application/ld+json" set:html={JSON.stringify(videoLd)} />
  <section class="section">
    <div class="wrap watch">
      <div class="watch-main lead">
        <VideoPlayer id={video.id} from={d.from} to={d.to} caption={video.caption} title={video.title} image={video.thumb} />
        <div class="kicker" style={`color:${d.colorVar};margin-top:16px;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase`}>{video.kicker}</div>
        <h1>{video.title}</h1>
        <div class="byline">
          <a href={`/disciplines/${d.slug}`} class="k" style={`color:${d.colorVar}`}>{d.name}</a><span class="sep"></span>
          <span>{video.when}</span>
          {video.views && <Fragment><span class="sep"></span><span class="mono">{video.views} vues</span></Fragment>}
        </div>
        {fiches.length > 0 && (
          <nav class="rp-fiches" aria-label="Fiches des joueurs">
            <span class="rp-fiches-k">{fiches.length > 1 ? 'Fiches joueurs' : 'Fiche joueur'}</span>
            {fiches.map((f) => <a class="rp-fiche" href={f.href} style={`--c:${d.colorVar}`}>{f.name}<span aria-hidden="true">→</span></a>)}
          </nav>
        )}
        <p class="dek">{video.excerpt}</p>
        <p style="margin-top:18px">
          <a class="btn ghost" href={`https://www.youtube.com/watch?v=${video.id}`} rel="noopener">Voir sur YouTube ↗</a>
        </p>
        <div class="article-share" style="margin-top:20px"><ShareLinks url={shareUrl} title={video.title} /></div>
      </div>

      <aside class="watch-side">
        <h2>Dans la même discipline</h2>
        <div class="related">
          {related.map((v) => (
            <a href={`/replay/${v.id}`} class="card" style={`--dc:${d.colorVar}`}>
              <Thumb from={d.from} to={d.to} caption={v.caption} image={v.thumb} alt={v.title} />
              <div class="kicker">{v.kicker}</div>
              <h3>{v.title}</h3>
              <div class="meta"><span>{v.when}</span>{v.views && <Fragment><span class="sep"></span><span class="mono">{v.views} vues</span></Fragment>}</div>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  /* Liens vers les fiches des joueurs cités dans le titre */
  .rp-fiches { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 14px; }
  .rp-fiches-k { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); margin-right: 2px; }
  .rp-fiche { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line);
    background: var(--surface, #fff); color: var(--ink, #111); font-weight: 700; font-size: 14px; text-decoration: none; transition: border-color .15s, color .15s; }
  .rp-fiche span { color: var(--c); transition: transform .15s; }
  .rp-fiche:hover, .rp-fiche:focus-visible { border-color: var(--c); color: var(--c); }
  .rp-fiche:hover span { transform: translateX(3px); }
</style>
