---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import Thumb from '../components/Thumb.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { disciplines, getDiscipline, partners, stats, cta, site } from '../data/site';
import SportIcon from '../components/SportIcon.astro';
import { getLiveFeature, getBroadcasts, getReplays, getChannelStats, tagStyle } from '../lib/youtube';
import { parseProgTitle } from '../lib/programmeTitle';
import { getCollection } from 'astro:content';
import { articleCover } from '../lib/articles';
import { getEvents } from '../lib/events';
import { assetExists, assetUrl } from '../lib/publicAssets';
import { defaultSeason, getPalmares, getSeasons, DEFAULT_SEASON } from '../data/billard/seasons';
import { photoOf, playerSlugs } from '../lib/billardStats';

// Chiffres-clés : tirés en direct de l'API YouTube (abonnés, vues, vidéos) + nb de
// disciplines. Toujours à jour, aucun chiffre saisi à la main. Repli sur les chiffres
// statiques (src/data/site.ts) si l'API n'est pas disponible au build (dev local sans clé).
const _ch = await getChannelStats();
// Format compact FR SANS surestimer : on tronque (14 200 → « 14 K », pas « 15 K »),
// et l'unité « + » signale « au moins ».
const _compact = (n: number): string => {
  if (n >= 1_000_000) return String(Math.floor(n / 100_000) / 10).replace('.', ',') + ' M';
  if (n >= 1_000) return Math.floor(n / 1_000) + ' K';
  return String(n);
};
// Chiffres qui ne dépendent PAS de l'API (toujours affichés).
const _foundedStat = { num: '2005', label: 'Année de création', raw: true, ic: 'flag' };
const _discStat = { num: String(disciplines.length), label: 'Disciplines couvertes', ic: 'grid' };
const _partnersStat = { num: String(partners.length), label: 'Partenaires du projet', ic: 'partners' };
const liveStats = _ch
  ? [
      _foundedStat,
      { num: _compact(_ch.subscribers), unit: '+', label: 'Abonnés YouTube', ic: 'users' },
      { num: _compact(_ch.views), unit: '+', label: 'Vues cumulées', ic: 'eye' },
      { num: _compact(_ch.videos), unit: _ch.videos >= 1000 ? '+' : '', label: 'Vidéos en ligne', ic: 'video' },
      _discStat,
      _partnersStat,
    ]
  : [_foundedStat, _discStat, _partnersStat];
const STAT_ICONS: Record<string, string> = {
  flag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.2 20a6 6 0 0 1 11.6 0"/><path d="M16 5.4a3 3 0 0 1 0 5.5M21 20a6 6 0 0 0-4-5.7"/></svg>',
  eye: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>',
  video: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="M16 10l6-3v10l-6-3z"/></svg>',
  grid: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
  partners: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 6.6a4.5 4.5 0 0 0-6.4 0L12 9l-2.4-2.4a4.5 4.5 0 1 0-6.4 6.4L12 21.8l8.8-8.8a4.5 4.5 0 0 0 0-6.4z"/></svg>',
};

const latestArticles = (await getCollection('articles', ({ data }) => !data.draft && data.date.valueOf() <= Date.now()))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmtArticleDate = (d: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

// Événements à mettre en avant (bandeau) — collection /admin + affiches déposées
// dans public/evenements/. Fenêtre d'affichage gérée dans getEvents().
const events = await getEvents();

// Spotlight billard (remplace l'ancienne section replays) : champion en titre + haut du classement.
const bilSeason = defaultSeason();
const bilPalm = getPalmares().find((p) => p.slug === DEFAULT_SEASON);
const bilChamp = bilPalm?.cdf || bilPalm?.champ || null;
const bilChampIsCdf = !!bilPalm?.cdf;
const bilPlayers = (bilSeason.results?.players ?? []) as any[];
const bilRanked = [...bilPlayers].sort((a, b) => a.rank - b.rank);
const bilTop = bilRanked.slice(0, 3);          // podium (3 cadres)
const bilTable = bilRanked.slice(3, 8);        // suite du classement (4ᵉ → 8ᵉ), à droite des cadres
const bilChampP = bilChamp ? bilPlayers.find((p) => p.id === bilChamp!.id) : null;
const bilChampPhoto = bilChampP ? photoOf(bilChampP, DEFAULT_SEASON) : null;
const { slugOf: bilSlug } = playerSlugs(getSeasons());

const live = await getLiveFeature();

// « Au programme » : lives YouTube + annonces manuelles (/admin), triés par date.
// UNE seule ligne par discipline = le PROCHAIN rendez-vous de chaque sport.
// Quand un live se termine, il sort de la fenêtre et le suivant du même sport
// prend sa place automatiquement (à la reconstruction suivante).
const _now = Date.now();
const _manualProg = (await getCollection('programme', ({ data }) => !data.draft)).map((p) => ({
  sport: p.data.sport as string, date: p.data.date as Date, live: false,
  thumb: p.data.image as string | undefined, category: p.data.category || '', title: p.data.title || '',
  href: '/programme', id: undefined as string | undefined,   // annonce pas encore sur YouTube → page programme
}));
const _autoProg = (await getBroadcasts()).map((b) => ({
  sport: b.discipline as string, date: new Date(b.date), live: b.live,
  thumb: `https://i.ytimg.com/vi/${b.id}/maxresdefault.jpg`, category: '', title: b.title,
  href: `https://www.youtube.com/watch?v=${b.id}`, id: b.id,   // live prêt sur YouTube → lu dans le grand lecteur
}));
// Auto (vrais lives YouTube) en premier : en cas d'égalité de date avec une annonce
// manuelle du même sport, c'est le vrai live (lien vidéo) qui l'emporte.
const _progSorted = [..._autoProg, ..._manualProg]
  .filter((it) => it.live || it.date.valueOf() + 3 * 3600 * 1000 >= _now)
  .sort((a, b) => (a.live === b.live ? a.date.valueOf() - b.date.valueOf() : a.live ? -1 : 1));
const _CAP_PER_SPORT = 1, _MAX_ITEMS = 7, _perSport = new Map<string, number>();
const programme: typeof _progSorted = [];
for (const it of _progSorted) {
  const c = _perSport.get(it.sport) || 0;
  if (c >= _CAP_PER_SPORT) continue;      // diversité : plafond par discipline
  _perSport.set(it.sport, c + 1);
  programme.push(it);
  if (programme.length >= _MAX_ITEMS) break;
}
const railDay = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/Paris' });
const railTime = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' });

const replays = await getReplays({ limit: 3 });
// Bandeau bas de la « une » (option C) : les derniers replays (les directs terminés y arrivent).
// « Derniers replays » : replays des 2 DERNIERS MOIS, triés par fraîcheur (getReplays() est
// déjà trié du plus récent au plus ancien). 1 par discipline, SAUF billard et basket (jusqu'à 3).
const _cut = new Date(_now); _cut.setMonth(_cut.getMonth() - 2);
const _cutMs = _cut.getTime();
const _allReplays = await getReplays();
const _maxPer = (d: string) => (d === 'billard' || d === 'basket' ? 3 : 1);
const _replCount = new Map<string, number>();
const beltReplays: typeof _allReplays = [];
for (const v of _allReplays) {
  if (!v.date || new Date(v.date).getTime() < _cutMs) continue;   // fenêtre 2 mois
  const c = _replCount.get(v.discipline) || 0;
  if (c >= _maxPer(v.discipline)) continue;                        // plafond par discipline
  _replCount.set(v.discipline, c + 1);
  beltReplays.push(v);
}
// Version TELEPHONE/TABLETTE de « Derniers replays » : le dernier billard + le dernier basket.
const replaysMobile = [
  ...(await getReplays({ discipline: 'billard', limit: 1 })),
  ...(await getReplays({ discipline: 'basket', limit: 1 })),
];
const liveCount = programme.filter((p) => p.live).length;
// Si aucun direct/programme, le rail affiche la DERNIÈRE vidéo de CHAQUE discipline
// (une par sport), en gardant l'ordre par heure réelle de diffusion la plus récente.
let railReplays: Awaited<ReturnType<typeof getReplays>> = [];
if (!programme.length) {
  const all = await getReplays();
  const seen = new Set<string>();
  for (const v of all) {
    if (!seen.has(v.discipline)) {
      seen.add(v.discipline);
      railReplays.push(v);
    }
  }
}

const liveDisc = live ? getDiscipline(live.discipline) : null;
const tagLabel = (t: string) => (t === 'magazine' ? 'Magazine' : getDiscipline(t as any).label);
// Catégorie de la vidéo à la une (déduite du titre, ex. « Femmes »), sinon la discipline.
const fmtCat = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : '');
const heroPt = live ? parseProgTitle(live.title) : null;
const heroCat = live ? (fmtCat(heroPt!.kicker) || liveDisc?.name || '') : '';
const heroTitle = heroPt?.main || (live?.title ?? '');   // titre nettoyé (sans les « | » ni emoji)
const heroSub = heroPt ? heroPt.badges.join(' · ') : ''; // ex. « 26/27 · 1/4 FINALE »
const heroStatusLabel = live ? (live.status === 'live' ? 'En direct' : live.status === 'upcoming' ? 'Bientôt' : 'À revoir') : '';

// À la une : date de l'événement (croisée avec le programme, même id) → date lisible,
// décompte et lien « Ajouter au calendrier » (Google Agenda généré depuis la date).
const heroProg = live ? programme.find((it) => it.id === live.id) : null;
const heroDate = heroProg?.date ?? null;
const _heroFullDate = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' });
const heroDateLabel = heroDate
  ? (() => { const s = _heroFullDate.format(heroDate); return s.charAt(0).toUpperCase() + s.slice(1) + ' · ' + railTime.format(heroDate).replace(':', 'h'); })()
  : '';
const heroWhenLabel = live?.isLive ? [live.venue, live.viewers].filter(Boolean).join(' · ') : heroDateLabel;
const heroIso = heroDate ? heroDate.toISOString() : '';
const _gcalFmt = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
const gcalUrl = heroDate
  ? `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(heroTitle + ' — LSEI')}&dates=${_gcalFmt(heroDate)}/${_gcalFmt(new Date(heroDate.getTime() + 2 * 3600 * 1000))}&details=${encodeURIComponent('En direct sur LSEI — Le Sport en Image · https://lsei.tv/direct')}`
  : '';

// Concept 3 « Prochain direct » : le direct programmé le plus proche → carte compte à rebours.
const nextLive = programme.find((it) => !it.live && it.date.valueOf() > _now) || null;
const restProg = programme.filter((it) => it !== nextLive);
const nextPt = nextLive && !nextLive.category ? parseProgTitle(nextLive.title) : null;
const nextMain = nextLive ? (nextLive.category || nextPt?.main || nextLive.title) : '';
const nextSub = nextLive ? [railDay.format(nextLive.date).replace('.', ''), railTime.format(nextLive.date).replace(':', 'h')].join(' · ') : '';

// Carrousel « prochains directs » : tous les directs À VENIR, défilement 10 s, chacun
// avec son propre décompte (et bascule « en direct » quand l'heure est atteinte).
const slides = programme
  .filter((it) => !it.live && it.date.valueOf() > _now)
  .map((it) => {
    const pt = it.category ? null : parseProgTitle(it.title);
    return {
      href: it.href, id: it.id as string | undefined, sport: it.sport, thumb: it.thumb,
      main: it.category || pt?.main || it.title,
      iso: it.date.toISOString(),
      when: [railDay.format(it.date).replace('.', ''), railTime.format(it.date).replace(':', 'h')].join(' · '),
    };
  });
---
<Base active="direct" preloadImage={assetExists('/home-hero.webp') ? assetUrl('/home-hero.webp') : undefined}>
  <Ticker />

  <!-- HERO — « une » cinématique (Variante C : corps clair, une sombre) -->
  {live && liveDisc && (
    <section class="mhero" style={`--hero-accent:${liveDisc.colorVar}`}>
      <div class="mhero-media" style={`background-image:url('${assetUrl('/home-hero.webp')}')`} aria-hidden="true"></div>
      <div class="wrap mhero-in">
        <span class={`hero-pill${live.isLive ? ' is-live' : ' is-soon'}`}>{live.isLive ? '● En direct' : (live.status === 'upcoming' ? 'En direct bientôt' : 'À revoir')}{heroCat ? ` · ${heroCat}` : ''}</span>
        <h1 class="mhero-h">{heroTitle}</h1>
        {heroSub && <div class="mhero-sub">{heroSub}</div>}
        {heroWhenLabel && (
          <div class="mhero-when">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
            <span>{heroWhenLabel}</span>
          </div>
        )}
        {!live.isLive && heroIso && (
          <div class="hero-count" data-count={heroIso}>
            <span class="hcl">Dans</span>
            <span class="hcb"><span class="hcb-box"><b data-d>—</b></span><i>Jours</i></span>
            <span class="hcb"><span class="hcb-box"><b data-h>—</b></span><i>Heures</i></span>
            <span class="hcb"><span class="hcb-box"><b data-m>—</b></span><i>Min</i></span>
            <span class="hcb"><span class="hcb-box"><b data-s>—</b></span><i>Sec</i></span>
          </div>
        )}
        <div class="hero-actions">
          <a class="btn hero-play" href={live.id ? `https://www.youtube.com/watch?v=${live.id}` : (live.href || site.youtubeUrl)} target={live.id ? '_blank' : undefined} rel="noopener">▸ {live.isLive ? 'Regarder le direct' : 'Regarder'}</a>
          {!live.isLive && gcalUrl && <a class="btn ghost hero-cal" href={gcalUrl} target="_blank" rel="noopener">＋ Ajouter au calendrier</a>}
        </div>
      </div>
    </section>
  )}

  <!-- PROCHAINS DIRECTS -->
  {slides.length > 0 && (
    <section class="section" style="padding-bottom:0">
      <div class="wrap">
        <div class="sec-head"><div><div class="eyebrow">À venir</div><h2>Prochains directs</h2></div><a href="/programme" class="link">Tous les événements →</a></div>
        <div class="pdrow">
          {slides.slice(0, 4).map((s) => (
            <a href={s.href} class="pdcard" style={`--dc:${getDiscipline(s.sport).colorVar}`}>
              <span class="pdthumb">
                {s.thumb
                  ? <img src={s.thumb} alt="" loading="lazy" onerror={s.thumb.includes('maxresdefault') ? `this.onerror=null;this.src='${s.thumb.replace('maxresdefault', 'hqdefault')}'` : undefined} />
                  : <span></span>}
                <span class="pdjx" data-jxshort={s.iso} style={`background:${getDiscipline(s.sport).colorVar}`}>J‑—</span>
              </span>
              <span class="pdbody">
                <span class="pdcat" style={`color:${getDiscipline(s.sport).colorVar}`}>{tagLabel(s.sport)}</span>
                <span class="pdtitle">{s.main}</span>
                <span class="pdwhen">{s.when}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    (function () {
      var el = document.querySelector('.hero-count');
      if (el) {
        var iso = el.getAttribute('data-count');
        var dEl = el.querySelector('[data-d]'), hEl = el.querySelector('[data-h]'), mEl = el.querySelector('[data-m]'), sEl = el.querySelector('[data-s]');
        var p = function (n) { return (n < 10 ? '0' : '') + n; };
        var tick = function () {
          var t = new Date(iso).getTime() - Date.now(); if (t < 0) t = 0;
          var s = Math.floor(t / 1000), d = Math.floor(s / 86400); s -= d * 86400;
          var h = Math.floor(s / 3600); s -= h * 3600; var m = Math.floor(s / 60); s -= m * 60;
          if (dEl) dEl.textContent = p(d); if (hEl) hEl.textContent = p(h); if (mEl) mEl.textContent = p(m); if (sEl) sEl.textContent = p(s);
        };
        tick(); setInterval(tick, 1000);
      }
    })();
    (function () {
      var chips = [].slice.call(document.querySelectorAll('[data-jxshort]'));
      if (!chips.length) return;
      var upd = function () { chips.forEach(function (el) { var d = Math.floor((new Date(el.getAttribute('data-jxshort')).getTime() - Date.now()) / 86400000); el.textContent = d <= 0 ? '●' : 'J‑' + d; }); };
      upd(); setInterval(upd, 60000);
    })();
    // Synchro TEMPS RÉEL de la « une » avec live.json (mis à jour toutes les 5 min) :
    // dès qu'un direct est en cours, l'accueil bascule en ● EN DIRECT et pointe dessus,
    // sans attendre une reconstruction du site.
    (function () {
      var hero = document.querySelector('.mhero');
      if (!hero) return;
      var pill = hero.querySelector('.hero-pill');
      var h1 = hero.querySelector('.mhero-h');
      var playBtn = hero.querySelector('.hero-play');
      var count = hero.querySelector('.hero-count');
      var when = hero.querySelector('.mhero-when');
      var sub = hero.querySelector('.mhero-sub');
      function clean(t) { var p = (t || '').split('|').map(function (s) { return s.trim(); }).filter(Boolean); return p.length ? p[p.length - 1] : (t || ''); }
      function sync() {
        fetch('/live.json', { cache: 'no-store' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            var lives = (d && d.lives) ? d.lives : (d && d.live && d.id ? [{ id: d.id, title: d.title || 'Direct' }] : []);
            if (!lives.length) return; // pas de direct : on garde la une construite (à venir / à revoir)
            var l = lives[0];
            if (pill) { pill.textContent = '● En direct'; pill.classList.add('is-live'); pill.classList.remove('is-soon'); }
            if (h1) h1.textContent = clean(l.title);
            if (playBtn) { playBtn.setAttribute('href', 'https://www.youtube.com/watch?v=' + l.id); playBtn.setAttribute('target', '_blank'); playBtn.textContent = '▸ Regarder le direct'; }
            if (count) count.style.display = 'none';
            if (when) when.style.display = 'none';
            if (sub) sub.style.display = 'none';
          })
          .catch(function () {});
      }
      sync(); setInterval(sync, 60000);
    })();
  </script>

  <!-- DISCIPLINES -->
  <section class="section" id="disciplines">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <div class="eyebrow">Nos antennes</div>
          <h2>7 disciplines, une même passion</h2>
        </div>
        <a href="/videotheque" class="link">Toute la vidéothèque →</a>
      </div>
      <div class="discs">
        {disciplines.map((d, i) => (
          <a href={d.hub ?? `/disciplines/${d.slug}`} class="disc-card" style={`--dc:${d.colorVar}`}>
            <span class="disc-ico"><SportIcon slug={d.slug} /></span>
            <div class="name">{d.name}</div>
            <div class="disc-cta">Voir les événements <span aria-hidden="true">→</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {(bilTop.length > 0 || beltReplays.length > 0) && (
    <section class="section">
      <div class="wrap">
        <div class="home-2col home-2col--media">
          {bilTop.length > 0 && (
          <div class="hcol bspot-sec" style="--dc:var(--c-billard)">
        <div class="sec-head">
          <div>
            <div class="eyebrow" style="color:var(--c-billard)">Blackball Masters</div>
            <h2>Le podium · {bilSeason.label}</h2>
          </div>
          <a href={`/billard/saison/${DEFAULT_SEASON}/classement`} class="link">Classement complet →</a>
        </div>
        <div class="bpod">
          {bilTop.map((p) => {
            const ph = photoOf(p, DEFAULT_SEASON);
            const lab = p.rank === 1 ? 'Leader du classement' : p.rank === 2 ? 'Vice-champion' : '3ᵉ au classement';
            return (
              <a href={`/billard/joueur/${bilSlug(p.id)}`} class={`bpod-card r${p.rank}`}>
                <span class="bpod-ph">
                  {ph ? <img src={ph} alt={p.name} onerror="this.remove()" /> : <span class="bpod-av">{p.name.slice(0, 1)}</span>}
                  <span class="bpod-rk">{p.rank}</span>
                </span>
                <span class="bpod-lab">{lab}</span>
                <span class="bpod-name">{p.name}</span>
                <span class="bpod-pts mono">{p.points}<small> pts</small></span>
              </a>
            );
          })}
        </div>
          </div>
          )}

  <!-- DERNIERS REPLAYS -->
          {beltReplays.length > 0 && (
          <div class="hcol">
        <div class="sec-head">
          <div>
            <div class="eyebrow">À revoir</div>
            <h2>Derniers replays</h2>
          </div>
          <a href="/videotheque" class="link">Toute la vidéothèque →</a>
        </div>
        <div class="rcarousel">
          <button type="button" class="rcar-nav rcar-prev" aria-label="Précédent">‹</button>
          <div class="rcards">
            {beltReplays.map((v) => {
              const rd = getDiscipline(v.discipline);
              const vpt = parseProgTitle(v.title);
              return (
                <a href={`/replay/${v.id}`} class="rcard" style={`--dc:${rd.colorVar}`}>
                  <span class="rcard-h">
                    <span class="rcard-cat" style={`color:${rd.colorVar}`}>{rd.label}</span>
                    <span class="rcard-date">{v.when}</span>
                  </span>
                  <span class="rcard-img">
                    {v.id ? <img src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`} alt={vpt.main || v.title} loading="lazy" onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${v.id}/hqdefault.jpg'`} /> : <span style={`background:linear-gradient(135deg,${rd.from},${rd.to})`}></span>}
                  </span>
                  <span class="rcard-t">{vpt.main || v.title}</span>
                </a>
              );
            })}
          </div>
          <button type="button" class="rcar-nav rcar-next" aria-label="Suivant">›</button>
        </div>
          </div>
          )}
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    (function () {
      document.querySelectorAll('.rcarousel').forEach(function (car) {
        var track = car.querySelector('.rcards');
        var prev = car.querySelector('.rcar-prev');
        var next = car.querySelector('.rcar-next');
        if (!track) return;
        function step() { var c = track.querySelector('.rcard'); return (c ? c.getBoundingClientRect().width + 12 : 200) * 2; }
        function upd() {
          var scrollable = (track.scrollWidth - track.clientWidth) > 2;
          if (prev) prev.hidden = !scrollable;
          if (next) next.hidden = !scrollable;
        }
        if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
        if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
        track.addEventListener('scroll', upd);
        window.addEventListener('resize', upd);
        upd();
      });
    })();
  </script>

  <!-- ACTUALITÉS (pleine largeur) -->
  {latestArticles.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <div class="eyebrow">Le mag</div>
            <h2>Actualités</h2>
          </div>
          <a href="/actualites" class="link">Toutes les actualités →</a>
        </div>
        <div class="cards">
          {latestArticles.map((a) => {
            const d = disciplines.find((x) => x.slug === a.data.discipline);
            const cover = articleCover(a);
            return (
              <a href={`/actualites/${a.id}`} class="card" style={d ? `--dc:${d.colorVar}` : ''}>
                <div class="frame">
                  {cover
                    ? <img class="photo" src={cover.src} alt="" loading="lazy" onerror={cover.fallback ? `this.onerror=null;this.src='${cover.fallback}'` : undefined} />
                    : <div class="duo" style={d ? `background:linear-gradient(135deg,${d.from},${d.to})` : 'background:linear-gradient(135deg,#1E40E5,#0a1a6b)'}></div>}
                  <div class="grad"></div>
                  {d && <div class="cap"><div class="disc"><SportIcon slug={d.slug} class="disc-tag-ic" />{d.label}</div></div>}
                </div>
                <div class="kicker">{fmtArticleDate(a.data.date)}</div>
                <h3>{a.data.title}</h3>
                <p class="ex">{a.data.excerpt}</p>
                <span class="card-more">Lire la suite <span aria-hidden="true">→</span></span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- CHIFFRES-CLÉS (panneau dédié) -->
  <section class="stats-sec" id="club">
    <div class="wrap">
      <div class="stats-panel">
        <div class="stats">
          {liveStats.map((s) => (
            <div class="stat">
              <span class="stat-ic" set:html={STAT_ICONS[(s as any).ic] || ''}></span>
              <span class="stat-body">
                <span class="num" data-nocount={(s as any).raw ? '' : undefined}>{s.num}{s.unit && <span style="font-size:20px">{s.unit}</span>}</span>
                <span class="lab">{s.label}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PARTENAIRES (section distincte) -->
  <section class="partners-sec">
    <div class="wrap">
      <div class="partners">
        <div class="pl">Ils portent le projet</div>
        <div class="plist">
          {partners.map((p) => (
            <a href={p.url} class="ptile-link" target="_blank" rel="noopener" title={p.name}>
              <span class="ptile"><img src={p.logo} alt={p.name} loading="lazy" /></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="wrap">
      <div class="cta">
        <div class="txt">
          <div class="eyebrow">{cta.eyebrow}</div>
          <h2>{cta.title}</h2>
          <p>{cta.text}<br />{cta.text2}</p>
          <div class="actions" style="justify-content:center;margin-top:22px">
            <a href={site.social.facebook} target="_blank" rel="noopener" class="btn light">Nous contacter</a>
            <a href="/le-club" class="btn outline">Découvrir LSEI</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    // Clic sur une vidéo du cadre « Dernières vidéos » → la lit dans le grand lecteur.
    (function () {
      var hero = document.querySelector('.hero .player');
      if (!hero) return;
      document.querySelectorAll('.rail .prog[data-id], .nlist-card[data-id]').forEach(function (item) {
        item.addEventListener('click', function (e) {
          e.preventDefault();
          var id = item.getAttribute('data-id');
          var title = item.getAttribute('data-title');
          var f = document.createElement('iframe');
          f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
          f.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
          f.setAttribute('allowfullscreen', '');
          f.setAttribute('title', title || 'Lecteur vidéo');
          hero.innerHTML = '';
          hero.appendChild(f);
          var st = document.querySelector('.hero .hero-stage');
          if (st) st.classList.add('is-playing');
          var h1 = document.querySelector('.hero .lead h1');
          if (h1 && title) h1.textContent = title;
          var cat = item.getAttribute('data-cat');
          // Met à jour l'info « Sport » sous la vidéo (label + lien vidéothèque) selon la vignette choisie.
          var sportEl = document.getElementById('js-hero-sport');
          if (sportEl && cat) sportEl.textContent = cat;
          var sportLink = document.getElementById('js-hero-sport-link');
          var dh = item.getAttribute('data-dischref');
          if (sportLink && dh) { sportLink.setAttribute('href', dh); sportLink.setAttribute('aria-label', 'Vidéothèque ' + (cat || '')); }
          hero.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });
    })();
  </script>
</Base>
