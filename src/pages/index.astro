---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import Thumb from '../components/Thumb.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { disciplines, getDiscipline, partners, stats, cta, site } from '../data/site';
import SportIcon from '../components/SportIcon.astro';
import { getLiveFeature, getBroadcasts, getReplays, tagStyle } from '../lib/youtube';
import { parseProgTitle } from '../lib/programmeTitle';
import { getCollection } from 'astro:content';
import { articleCover } from '../lib/articles';
import { getEvents } from '../lib/events';
import { defaultSeason, getPalmares, getSeasons, DEFAULT_SEASON } from '../data/billard/seasons';
import { photoOf, playerSlugs } from '../lib/billardStats';

const latestArticles = (await getCollection('articles', ({ data }) => !data.draft && data.date.valueOf() <= Date.now()))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmtArticleDate = (d: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

// Événements à mettre en avant (bandeau) — collection /admin + affiches déposées
// dans public/evenements/. Fenêtre d'affichage gérée dans getEvents().
const events = await getEvents();

// Spotlight billard (remplace l'ancienne section replays) : champion en titre + haut du classement.
const bilSeason = defaultSeason();
const bilPalm = getPalmares().find((p) => p.slug === DEFAULT_SEASON);
const bilChamp = bilPalm?.cdf || bilPalm?.champ || null;
const bilChampIsCdf = !!bilPalm?.cdf;
const bilPlayers = (bilSeason.results?.players ?? []) as any[];
const bilRanked = [...bilPlayers].sort((a, b) => a.rank - b.rank);
const bilTop = bilRanked.slice(0, 3);          // podium (3 cadres)
const bilTable = bilRanked.slice(3, 8);        // suite du classement (4ᵉ → 8ᵉ), à droite des cadres
const bilChampP = bilChamp ? bilPlayers.find((p) => p.id === bilChamp!.id) : null;
const bilChampPhoto = bilChampP ? photoOf(bilChampP, DEFAULT_SEASON) : null;
const { slugOf: bilSlug } = playerSlugs(getSeasons());

const live = await getLiveFeature();

// « Au programme » : lives YouTube + annonces manuelles (/admin), triés par date.
// UNE seule ligne par discipline = le PROCHAIN rendez-vous de chaque sport.
// Quand un live se termine, il sort de la fenêtre et le suivant du même sport
// prend sa place automatiquement (à la reconstruction suivante).
const _now = Date.now();
const _manualProg = (await getCollection('programme', ({ data }) => !data.draft)).map((p) => ({
  sport: p.data.sport as string, date: p.data.date as Date, live: false,
  thumb: p.data.image as string | undefined, category: p.data.category || '', title: p.data.title || '',
  href: '/programme', id: undefined as string | undefined,   // annonce pas encore sur YouTube → page programme
}));
const _autoProg = (await getBroadcasts()).map((b) => ({
  sport: b.discipline as string, date: new Date(b.date), live: b.live,
  thumb: `https://i.ytimg.com/vi/${b.id}/maxresdefault.jpg`, category: '', title: b.title,
  href: `https://www.youtube.com/watch?v=${b.id}`, id: b.id,   // live prêt sur YouTube → lu dans le grand lecteur
}));
// Auto (vrais lives YouTube) en premier : en cas d'égalité de date avec une annonce
// manuelle du même sport, c'est le vrai live (lien vidéo) qui l'emporte.
const _progSorted = [..._autoProg, ..._manualProg]
  .filter((it) => it.live || it.date.valueOf() + 3 * 3600 * 1000 >= _now)
  .sort((a, b) => (a.live === b.live ? a.date.valueOf() - b.date.valueOf() : a.live ? -1 : 1));
const _CAP_PER_SPORT = 1, _MAX_ITEMS = 7, _perSport = new Map<string, number>();
const programme: typeof _progSorted = [];
for (const it of _progSorted) {
  const c = _perSport.get(it.sport) || 0;
  if (c >= _CAP_PER_SPORT) continue;      // diversité : plafond par discipline
  _perSport.set(it.sport, c + 1);
  programme.push(it);
  if (programme.length >= _MAX_ITEMS) break;
}
const railDay = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/Paris' });
const railTime = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' });

const replays = await getReplays({ limit: 3 });
// Bandeau bas de la « une » (option C) : les derniers replays (les directs terminés y arrivent).
// « Derniers replays » : replays des 2 DERNIERS MOIS, triés par fraîcheur (getReplays() est
// déjà trié du plus récent au plus ancien). 1 par discipline, SAUF billard et basket (jusqu'à 3).
const _cut = new Date(_now); _cut.setMonth(_cut.getMonth() - 2);
const _cutMs = _cut.getTime();
const _allReplays = await getReplays();
const _maxPer = (d: string) => (d === 'billard' || d === 'basket' ? 3 : 1);
const _replCount = new Map<string, number>();
const beltReplays: typeof _allReplays = [];
for (const v of _allReplays) {
  if (!v.date || new Date(v.date).getTime() < _cutMs) continue;   // fenêtre 2 mois
  const c = _replCount.get(v.discipline) || 0;
  if (c >= _maxPer(v.discipline)) continue;                        // plafond par discipline
  _replCount.set(v.discipline, c + 1);
  beltReplays.push(v);
}
// Version TELEPHONE/TABLETTE de « Derniers replays » : le dernier billard + le dernier basket.
const replaysMobile = [
  ...(await getReplays({ discipline: 'billard', limit: 1 })),
  ...(await getReplays({ discipline: 'basket', limit: 1 })),
];
const liveCount = programme.filter((p) => p.live).length;
// Si aucun direct/programme, le rail affiche la DERNIÈRE vidéo de CHAQUE discipline
// (une par sport), en gardant l'ordre par heure réelle de diffusion la plus récente.
let railReplays: Awaited<ReturnType<typeof getReplays>> = [];
if (!programme.length) {
  const all = await getReplays();
  const seen = new Set<string>();
  for (const v of all) {
    if (!seen.has(v.discipline)) {
      seen.add(v.discipline);
      railReplays.push(v);
    }
  }
}

const liveDisc = live ? getDiscipline(live.discipline) : null;
const tagLabel = (t: string) => (t === 'magazine' ? 'Magazine' : getDiscipline(t as any).label);
// Catégorie de la vidéo à la une (déduite du titre, ex. « Femmes »), sinon la discipline.
const fmtCat = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : '');
const heroPt = live ? parseProgTitle(live.title) : null;
const heroCat = live ? (fmtCat(heroPt!.kicker) || liveDisc?.name || '') : '';
const heroTitle = heroPt?.main || (live?.title ?? '');   // titre nettoyé (sans les « | » ni emoji)
const heroSub = heroPt ? heroPt.badges.join(' · ') : ''; // ex. « 26/27 · 1/4 FINALE »
const heroStatusLabel = live ? (live.status === 'live' ? 'En direct' : live.status === 'upcoming' ? 'Bientôt' : 'À revoir') : '';

// Concept 3 « Prochain direct » : le direct programmé le plus proche → carte compte à rebours.
const nextLive = programme.find((it) => !it.live && it.date.valueOf() > _now) || null;
const restProg = programme.filter((it) => it !== nextLive);
const nextPt = nextLive && !nextLive.category ? parseProgTitle(nextLive.title) : null;
const nextMain = nextLive ? (nextLive.category || nextPt?.main || nextLive.title) : '';
const nextSub = nextLive ? [railDay.format(nextLive.date).replace('.', ''), railTime.format(nextLive.date).replace(':', 'h')].join(' · ') : '';

// Carrousel « prochains directs » : tous les directs À VENIR, défilement 10 s, chacun
// avec son propre décompte (et bascule « en direct » quand l'heure est atteinte).
const slides = programme
  .filter((it) => !it.live && it.date.valueOf() > _now)
  .map((it) => {
    const pt = it.category ? null : parseProgTitle(it.title);
    return {
      href: it.href, id: it.id as string | undefined, sport: it.sport, thumb: it.thumb,
      main: it.category || pt?.main || it.title,
      iso: it.date.toISOString(),
      when: [railDay.format(it.date).replace('.', ''), railTime.format(it.date).replace(':', 'h')].join(' · '),
    };
  });
---
<Base active="direct">
  <Ticker />

  <!-- HERO -->
  {live && liveDisc && (
    <section class="hero hero--now" style={`--hero-accent:${liveDisc.colorVar}`}>
      <div class="wrap hero-grid">
        <div class="lead">
          <VideoPlayer
            id={live.id}
            from={liveDisc.from}
            to={liveDisc.to}
            live={live.isLive}
            caption={live.caption}
            score={live.isLive ? live.score : undefined}
            image={live.thumb}
            title={live.title}
          />
          <div class={`hero-kicker${live.isLive ? ' is-live' : ''}${live.status === 'upcoming' ? ' is-soon' : ''}`}>
            <span class="dot"></span>{heroStatusLabel}<span class="sepk">·</span><span class="hero-cat">{heroCat}</span>
          </div>
          <h1>{heroTitle}</h1>
          {heroSub && <div class="hero-sub">{heroSub}</div>}
          {live.dek && <p class="dek">{live.dek}</p>}
          {live.isLive && (
            <div class="byline">
              <span class="k">En direct</span>
              {live.venue && <Fragment><span class="sep"></span><span>{live.venue}</span></Fragment>}
              {live.viewers && <Fragment><span class="sep"></span><span class="mono">{live.viewers}</span></Fragment>}
            </div>
          )}
        </div>

        <aside class={`rail${slides.length ? ' rail--next' : ''}`}>
          {slides.length ? (
            <div class="nlist">
              <div class="nlist-h">Prochains directs</div>
              <div class="nlist-track">
              {slides.slice(0, 4).map((s) => (
                <a href={s.href} class="nlist-card" {...(s.id ? { 'data-id': s.id, 'data-title': s.main, 'data-cat': tagLabel(s.sport), 'data-sub': s.when } : {})}>
                  <span class="nlist-thumb">
                    {s.thumb
                      ? <img src={s.thumb} alt="" loading="lazy" onerror={s.thumb.includes('maxresdefault') ? `this.onerror=null;this.src='${s.thumb.replace('maxresdefault', 'hqdefault')}'` : undefined} />
                      : <span style="background:linear-gradient(135deg,var(--surface-2),var(--surface))"></span>}
                    <span class="nlist-badge" style={tagStyle(s.sport)}>{tagLabel(s.sport)}</span>
                  </span>
                  <span class="nlist-body">
                    <span class="nlist-title">{s.main}</span>
                    <span class="nlist-count mono" data-countdown={s.iso}>—</span>
                    <span class="nlist-live"><span class="dot"></span>En direct — regarder →</span>
                    <span class="nlist-when">{s.when}</span>
                  </span>
                </a>
              ))}
              </div>
            </div>
          ) : (
            <Fragment>
              <h2>{programme.length ? 'Au programme' : 'Dernières vidéos'}
                {liveCount > 0 && (<span class="live-mini"><span class="pulse"></span>{liveCount} en direct</span>)}
              </h2>
              <div class="rail-list">
                {programme.length
                  ? programme.map((it) => {
                      const pt = it.category ? null : parseProgTitle(it.title);
                      const main = it.category || pt?.main || it.title;
                      const bits = it.category ? [it.title] : (pt ? [pt.kicker, ...pt.badges] : []);
                      const sub = [railDay.format(it.date).replace('.', ''), ...bits].filter(Boolean).join(' · ');
                      const time = it.live ? 'LIVE' : railTime.format(it.date).replace(':', 'h');
                      const cat = pt ? fmtCat(pt.kicker) : '';
                      const subb = pt ? pt.badges.join(' · ') : '';
                      return (
                        <a href={it.href} class="prog" {...(it.id ? { 'data-id': it.id, 'data-title': pt?.main || it.title, 'data-cat': cat, 'data-sub': subb } : {})}>
                          <div class="prog-media"><div class={`time mono prog-time-media${it.live ? ' on' : ''}`}>{time}</div><div class="prog-thumb">{it.thumb ? <img src={it.thumb} alt="" loading="lazy" onerror={it.thumb.includes('maxresdefault') ? `this.onerror=null;this.src='${it.thumb.replace('maxresdefault', 'hqdefault')}'` : undefined} /> : <span style="background:linear-gradient(135deg,var(--surface-2),var(--surface))"></span>}</div></div>
                          <div class="body"><div class={`time mono prog-time-body${it.live ? ' on' : ''}`}>{time}</div><div class="t">{main}</div>{sub && <div class="m">{sub}</div>}<span class="tagd" style={tagStyle(it.sport)}>{tagLabel(it.sport)}</span></div>
                        </a>
                      );
                    })
                  : railReplays.map((v) => {
                      const rd = getDiscipline(v.discipline);
                      const vpt = parseProgTitle(v.title);
                      return (
                        <a href={`/replay/${v.id}`} class="prog" data-id={v.id} data-title={vpt.main || v.title} data-caption={v.caption} data-cat={fmtCat(vpt.kicker) || rd.label} data-sub={vpt.badges.join(' · ')}>
                          <div class="prog-thumb">{v.thumb ? <img src={v.thumb} alt="" loading="lazy" /> : <span style={`background:linear-gradient(135deg,${rd.from},${rd.to})`}></span>}</div>
                          <div class="body"><div class="t">{v.title}</div><div class="m">{v.caption}</div></div>
                        </a>
                      );
                    })}
              </div>
              <a href={programme.length ? '/programme' : '/disciplines'} class="more">{programme.length ? 'Voir le programme →' : 'Voir toutes les disciplines →'}</a>
            </Fragment>
          )}
        </aside>
      </div>
      <script is:inline>
        (function () {
          var els = document.querySelectorAll('[data-countdown]');
          if (!els.length) return;
          function fmt(ms) {
            if (ms <= 0) return "C'est parti !";
            var s = Math.floor(ms / 1000), d = Math.floor(s / 86400); s -= d * 86400;
            var h = Math.floor(s / 3600); s -= h * 3600; var m = Math.floor(s / 60); s -= m * 60;
            var p = function (n) { return (n < 10 ? '0' : '') + n; };
            return (d > 0 ? d + 'j ' : '') + p(h) + 'h ' + p(m) + 'm ' + p(s) + 's';
          }
          function tick() {
            els.forEach(function (el) {
              el.textContent = fmt(new Date(el.getAttribute('data-countdown')).getTime() - Date.now());
            });
          }
          tick(); setInterval(tick, 1000);
        })();
        // Bascule « ● EN DIRECT » PRÉCISE via live.json (mis à jour toutes les 5 min, comme /direct) :
        // un slide passe en direct seulement quand SON live est réellement en cours, et revient
        // à la normale dès qu'il se termine — sans attendre la reconstruction du site.
        (function () {
          var cards = [].slice.call(document.querySelectorAll('.nlist-card[data-id]'));
          if (!cards.length) return;
          function syncLive() {
            fetch('/live.json', { cache: 'no-store' })
              .then(function (r) { return r.ok ? r.json() : null; })
              .then(function (d) {
                var ids = {};
                if (d && d.lives && d.lives.length) d.lives.forEach(function (l) { ids[l.id] = 1; });
                else if (d && d.live && d.id) ids[d.id] = 1;
                cards.forEach(function (s) { s.classList.toggle('is-live', !!ids[s.getAttribute('data-id')]); });
              })
              .catch(function () {});
          }
          syncLive(); setInterval(syncLive, 60000);
        })();
        // Cale la hauteur de la LISTE des prochains directs sur celle de la vidéo (2 colonnes only).
        (function () {
          var card = document.querySelector('.rail--next .nlist');
          var frame = document.querySelector('.hero .lead .frame');
          if (!card || !frame) return;
          function sync() {
            if (window.matchMedia('(min-width: 941px)').matches) {
              card.style.height = Math.round(frame.getBoundingClientRect().height) + 'px';
            } else { card.style.height = ''; }
          }
          sync();
          window.addEventListener('resize', sync);
          var img = frame.querySelector('img');
          if (img && !img.complete) img.addEventListener('load', sync);
        })();
      </script>
    </section>
  )}

  <!-- DISCIPLINES -->
  <section class="section" id="disciplines">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <div class="eyebrow">Nos antennes</div>
          <h2>7 disciplines, une même passion</h2>
        </div>
        <a href="/videotheque" class="link">Toute la vidéothèque →</a>
      </div>
      <div class="discs">
        {disciplines.map((d, i) => (
          <a href={d.hub ?? `/disciplines/${d.slug}`} class="disc-card" style={`--dc:${d.colorVar}`}>
            <div class="n">{String(i + 1).padStart(2, '0')}</div>
            <SportIcon slug={d.slug} />
            <div class="name">{d.name}</div>
            <div class="sub">{d.sub}</div>
            {d.statsHub && <div class="disc-stats-badge">＋ Classements &amp; stats</div>}
          </a>
        ))}
      </div>
    </div>
  </section>

  {events.length > 0 ? (
    <section class="section evbanner-wrap">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <div class="eyebrow">À l'affiche</div>
            <h2>{events.length > 1 ? 'Événements à venir' : 'Prochain événement'}</h2>
          </div>
        </div>
        <div class="evcar" data-count={events.length}>
          <div class="evcar-track">
            {events.map((e) => (
              <div class="evcar-slide">
                {e.link
                  ? <a href={e.link} class="evbanner" target={e.link.startsWith('http') ? '_blank' : undefined} rel="noopener" aria-label={e.title}><img src={e.image} alt={e.title} loading="lazy" /></a>
                  : <div class="evbanner"><img src={e.image} alt={e.title} loading="lazy" /></div>}
              </div>
            ))}
          </div>
          {events.length > 1 && (
            <div class="evcar-dots">
              {events.map((e, i) => <button type="button" class="evcar-dot" data-i={i} aria-label={`Voir : ${e.title}`}></button>)}
            </div>
          )}
        </div>
      </div>
    </section>
  ) : (
    <hr class="rule" />
  )}
  <script is:inline>
    (function () {
      document.querySelectorAll('.evcar[data-count]').forEach(function (car) {
        var count = parseInt(car.getAttribute('data-count'), 10);
        if (!count || count < 2) return;
        var track = car.querySelector('.evcar-track');
        var dots = Array.prototype.slice.call(car.querySelectorAll('.evcar-dot'));
        var i = 0, timer = null;
        function go(n) { i = (n + count) % count; track.style.transform = 'translateX(' + (-i * 100) + '%)'; dots.forEach(function (d, k) { d.classList.toggle('active', k === i); }); }
        function start() { timer = setInterval(function () { go(i + 1); }, 8000); }
        function stop() { if (timer) { clearInterval(timer); timer = null; } }
        dots.forEach(function (d, k) { d.addEventListener('click', function () { stop(); go(k); start(); }); });
        car.addEventListener('mouseenter', stop);
        car.addEventListener('mouseleave', start);
        // Glisser au doigt (mobile) : swipe horizontal pour changer d'evenement.
        var sx = 0, sy = 0, drag = false, lock = null, w = 0;
        track.addEventListener('touchstart', function (e) { var t = e.touches[0]; sx = t.clientX; sy = t.clientY; drag = true; lock = null; w = car.clientWidth || 1; stop(); }, { passive: true });
        track.addEventListener('touchmove', function (e) {
          if (!drag) return;
          var t = e.touches[0], dx = t.clientX - sx, dy = t.clientY - sy;
          if (lock === null) { lock = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y'; if (lock === 'x') track.style.transition = 'none'; }
          if (lock === 'x') { e.preventDefault(); track.style.transform = 'translateX(calc(' + (-i * 100) + '% + ' + dx + 'px))'; }
        }, { passive: false });
        function endDrag(e) {
          if (!drag) return; drag = false;
          if (lock !== 'x') { start(); return; }
          track.style.transition = '';
          var t = (e.changedTouches && e.changedTouches[0]) || e, dx = t.clientX - sx, thr = Math.min(60, w * 0.15);
          if (dx <= -thr) go(i + 1); else if (dx >= thr) go(i - 1); else go(i);
          start();
        }
        track.addEventListener('touchend', endDrag);
        track.addEventListener('touchcancel', endDrag);
        go(0); start();
      });
    })();
  </script>

  <!-- DERNIERS REPLAYS (replacé sous les événements) -->
  {beltReplays.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <div class="eyebrow">À revoir</div>
            <h2>Derniers replays</h2>
          </div>
          <a href="/videotheque" class="link">Toute la vidéothèque →</a>
        </div>
        <div class="rcarousel">
          <button type="button" class="rcar-nav rcar-prev" aria-label="Précédent">‹</button>
          <div class="rcards">
            {beltReplays.map((v) => {
              const rd = getDiscipline(v.discipline);
              const vpt = parseProgTitle(v.title);
              return (
                <a href={`/replay/${v.id}`} class="rcard" style={`--dc:${rd.colorVar}`}>
                  <span class="rcard-h">
                    <span class="rcard-cat" style={`color:${rd.colorVar}`}>{rd.label}</span>
                    <span class="rcard-date">{v.when}</span>
                  </span>
                  <span class="rcard-img">
                    {v.id ? <img src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`} alt="" loading="lazy" onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${v.id}/hqdefault.jpg'`} /> : <span style={`background:linear-gradient(135deg,${rd.from},${rd.to})`}></span>}
                  </span>
                  <span class="rcard-t">{vpt.main || v.title}</span>
                </a>
              );
            })}
          </div>
          <button type="button" class="rcar-nav rcar-next" aria-label="Suivant">›</button>
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    (function () {
      document.querySelectorAll('.rcarousel').forEach(function (car) {
        var track = car.querySelector('.rcards');
        var prev = car.querySelector('.rcar-prev');
        var next = car.querySelector('.rcar-next');
        if (!track) return;
        function step() { var c = track.querySelector('.rcard'); return (c ? c.getBoundingClientRect().width + 12 : 200) * 2; }
        function upd() {
          var max = track.scrollWidth - track.clientWidth - 2;
          if (prev) prev.hidden = track.scrollLeft <= 2;
          if (next) next.hidden = max <= 2 || track.scrollLeft >= max;
        }
        if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
        if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
        track.addEventListener('scroll', upd);
        window.addEventListener('resize', upd);
        upd();
      });
    })();
  </script>

  <!-- SPOTLIGHT BILLARD : le podium (top 3) du classement Masters -->
  {bilTop.length > 0 && (
    <section class="section bspot-sec" style="--dc:var(--c-billard)">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <div class="eyebrow" style="color:var(--c-billard)">Le billard en image</div>
            <h2>Blackball Masters — le podium {bilSeason.label}</h2>
          </div>
          <a href={`/billard/saison/${DEFAULT_SEASON}/classement`} class="link">Classement complet →</a>
        </div>
        <div class="bspot">
        <div class="bpod">
          {bilTop.map((p) => {
            const ph = photoOf(p, DEFAULT_SEASON);
            const lab = p.rank === 1 ? 'Leader du classement' : p.rank === 2 ? 'Vice-champion' : '3ᵉ au classement';
            return (
              <a href={`/billard/joueur/${bilSlug(p.id)}`} class={`bpod-card r${p.rank}`}>
                <span class="bpod-ph">
                  {ph ? <img src={ph} alt={p.name} onerror="this.remove()" /> : <span class="bpod-av">{p.name.slice(0, 1)}</span>}
                  <span class="bpod-rk">{p.rank}</span>
                </span>
                <span class="bpod-lab">{lab}</span>
                <span class="bpod-name">{p.name}</span>
                <span class="bpod-pts mono">{p.points}<small> pts</small></span>
              </a>
            );
          })}
        </div>
        {bilTable.length > 0 && (
          <div class="bspot-rank">
            <div class="bspot-rank-h">Le classement · {bilSeason.label}</div>
            {bilTable.map((p) => (
              <a href={`/billard/joueur/${bilSlug(p.id)}`} class="bspot-row">
                <span class="bspot-rk">{p.rank}</span>
                <span class="bspot-nm">{p.name}</span>
                <span class="bspot-pts mono">{p.points}<small> pts</small></span>
              </a>
            ))}
          </div>
        )}
        </div>
      </div>
    </section>
  )}

  <!-- ACTUALITÉS -->
  {latestArticles.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <div class="eyebrow">Le mag</div>
            <h2>Actualités</h2>
          </div>
          <a href="/actualites" class="link">Toutes les actualités →</a>
        </div>
        <div class="cards">
          {latestArticles.map((a) => {
            const d = disciplines.find((x) => x.slug === a.data.discipline);
            const cover = articleCover(a);
            return (
              <a href={`/actualites/${a.id}`} class="card" style={d ? `--dc:${d.colorVar}` : ''}>
                <div class="frame">
                  {cover
                    ? <img class="photo" src={cover.src} alt="" loading="lazy" onerror={cover.fallback ? `this.onerror=null;this.src='${cover.fallback}'` : undefined} />
                    : <div class="duo" style={d ? `background:linear-gradient(135deg,${d.from},${d.to})` : 'background:linear-gradient(135deg,#1E40E5,#0a1a6b)'}></div>}
                  <div class="grad"></div>
                  {d && <div class="cap"><div class="disc"><SportIcon slug={d.slug} class="disc-tag-ic" />{d.label}</div></div>}
                </div>
                <div class="kicker">{fmtArticleDate(a.data.date)}</div>
                <h3>{a.data.title}</h3>
                <p class="ex">{a.data.excerpt}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- STATS + PARTNERS -->
  <div class="band" id="club">
    <div class="wrap">
      <div class="stats">
        {stats.map((s) => (
          <div class="stat">
            <div class="num">{s.num}{s.unit && <span style="font-size:22px">{s.unit}</span>}</div>
            <div class="lab">{s.label}</div>
          </div>
        ))}
      </div>
      <div class="partners">
        <div class="pl">Ils portent le projet</div>
        <div class="plist">
          {partners.map((p) => (
            <a href={p.url} class="ptile-link" target="_blank" rel="noopener" title={p.name}>
              <span class="ptile"><img src={p.logo} alt={p.name} loading="lazy" /></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <section class="section">
    <div class="wrap">
      <div class="cta">
        <div class="txt">
          <div class="eyebrow">{cta.eyebrow}</div>
          <h2>{cta.title}</h2>
          <p>{cta.text}<br />{cta.text2}</p>
          <div class="actions" style="justify-content:center;margin-top:22px">
            <a href={site.social.facebook} target="_blank" rel="noopener" class="btn light">Nous contacter</a>
            <a href="/le-club" class="btn outline">Découvrir LSEI</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    // Clic sur une vidéo du cadre « Dernières vidéos » → la lit dans le grand lecteur.
    (function () {
      var hero = document.querySelector('.hero .player');
      if (!hero) return;
      document.querySelectorAll('.rail .prog[data-id], .nlist-card[data-id]').forEach(function (item) {
        item.addEventListener('click', function (e) {
          e.preventDefault();
          var id = item.getAttribute('data-id');
          var title = item.getAttribute('data-title');
          var f = document.createElement('iframe');
          f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
          f.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
          f.setAttribute('allowfullscreen', '');
          f.setAttribute('title', title || 'Lecteur vidéo');
          hero.innerHTML = '';
          hero.appendChild(f);
          var h1 = document.querySelector('.hero .lead h1');
          if (h1 && title) h1.textContent = title;
          var cat = item.getAttribute('data-cat');
          var catEl = document.querySelector('.hero .hero-cat');
          if (catEl && cat) catEl.textContent = cat;
          var subEl = document.querySelector('.hero .hero-sub');
          if (subEl) subEl.textContent = item.getAttribute('data-sub') || '';
          hero.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });
    })();
  </script>
</Base>
