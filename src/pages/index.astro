  <script is:inline>
    // Décomptes du bandeau « Prochains rendez-vous » (J-x au jour près ; heures/minutes pour un direct programmé).
    (function () {
      var p = function (n) { return (n < 10 ? '0' : '') + n; };
      function tick() {
        var now = Date.now();
        document.querySelectorAll('[data-rdv-day]').forEach(function (el) {
          var d = el.getAttribute('data-rdv-day'), t = new Date(d + 'T00:00:00'), today = new Date(); today.setHours(0, 0, 0, 0);
          var j = Math.round((t - today) / 864e5), b = el.querySelector('[data-j]');
          if (j <= 0) { el.innerHTML = '<b class="rdv-now">' + (j === 0 ? "Aujourd'hui" : 'En cours') + '</b>'; return; }
          if (b) b.textContent = j;
        });
        document.querySelectorAll('[data-rdv-iso]').forEach(function (el) {
          var t = new Date(el.getAttribute('data-rdv-iso')).getTime() - now; if (t < 0) t = 0;
          var h = Math.floor(t / 36e5), m = Math.floor((t % 36e5) / 6e4);
          var hb = el.querySelector('[data-h]'), mb = el.querySelector('[data-m]');
          if (hb) hb.textContent = p(h); if (mb) mb.textContent = p(m);
        });
      }
      tick(); setInterval(tick, 30000);
    })();
  </script>

  <script is:inline>
    (function () {
      var el = document.querySelector('.hero-count');
      if (el) {
        var iso = el.getAttribute('data-count');
        var dEl = el.querySelector('[data-d]'), hEl = el.querySelector('[data-h]'), mEl = el.querySelector('[data-m]'), sEl = el.querySelector('[data-s]');
        var p = function (n) { return (n < 10 ? '0' : '') + n; };
        var tick = function () {
          var t = new Date(iso).getTime() - Date.now(); if (t < 0) t = 0;
          var s = Math.floor(t / 1000), d = Math.floor(s / 86400); s -= d * 86400;
          var h = Math.floor(s / 3600); s -= h * 3600; var m = Math.floor(s / 60); s -= m * 60;
          if (dEl) dEl.textContent = p(d); if (hEl) hEl.textContent = p(h); if (mEl) mEl.textContent = p(m); if (sEl) sEl.textContent = p(s);
        };
        tick(); setInterval(tick, 1000);
      }
    })();
    // Synchro TEMPS RÉEL de la « une » avec live.json (mis à jour toutes les 5 min) :
    // dès qu'un direct est en cours, l'accueil bascule en ● EN DIRECT et pointe dessus,
    // sans attendre une reconstruction du site.
    (function () {
      var hero = document.querySelector('.mhero');
      if (!hero) return;
      var pill = hero.querySelector('.hero-pill');
      var h1 = hero.querySelector('.mhero-h');
      var playBtn = hero.querySelector('.hero-play');
      var count = hero.querySelector('.hero-count');
      var when = hero.querySelector('.mhero-when');
      var sub = hero.querySelector('.mhero-sub');
      var more = hero.querySelector('.mhero-more');
      var singleMedia = hero.querySelector('.mhero-media');
      var singleIn = hero.querySelector('.mhero-in');
      var dualMedia = hero.querySelector('.mhero-dual-media');
      var dual = hero.querySelector('.mhero-dual');
      var heroColors = {}; try { heroColors = JSON.parse(document.getElementById('hero-colors').textContent); } catch (e) {}
      function clean(t) { var p = (t || '').split('|').map(function (s) { return s.trim(); }).filter(Boolean); return p.length ? p[p.length - 1] : (t || ''); }
      function ctxOf(l) { var c = l.context || ''; if (l.place) c = c ? (c + ' · 📍 ' + l.place) : ('📍 ' + l.place); return c; }
      // Fond AUTO (mode simple) : couleurs + icône du hero au sport du direct.
      function setSport(disc) {
        if (!disc) return;
        hero.setAttribute('data-sport', disc);
        var c = heroColors[disc]; if (c) { hero.style.setProperty('--h-from', c.from); hero.style.setProperty('--h-to', c.to); }
        hero.style.setProperty('--hero-accent', 'var(--c-' + disc + ')');
        if (singleMedia) singleMedia.querySelectorAll('.mhero-ico-item').forEach(function (it) { it.classList.toggle('is-on', it.getAttribute('data-sport') === disc); });
      }
      function setIco(slot, disc) { if (slot) slot.querySelectorAll('.mhero-ico-item').forEach(function (it) { it.classList.toggle('is-on', it.getAttribute('data-sport') === disc); }); }
      function fillEv(ev, l) {
        if (!ev) return;
        var c = heroColors[l.discipline] || {};
        var tag = ev.querySelector('.mhero-dual-tag');
        if (tag) { tag.textContent = c.label || l.discipline || 'Direct'; tag.style.background = 'var(--c-' + l.discipline + ')'; }
        var h = ev.querySelector('.mhero-dual-h'); if (h) h.textContent = l.match || clean(l.title);
        var s = ev.querySelector('.mhero-dual-sub'); if (s) s.textContent = ctxOf(l);
      }
      // Mode DOUBLE : 2 directs de sports différents en même temps → hero « mélange ».
      function showDual(a, b) {
        var ca = heroColors[a.discipline] || {}, cb = heroColors[b.discipline] || {};
        hero.style.setProperty('--mix-l', ca.from); hero.style.setProperty('--mix-l2', ca.to);
        hero.style.setProperty('--mix-r', cb.from); hero.style.setProperty('--mix-r2', cb.to);
        if (dualMedia) { setIco(dualMedia.querySelector('.mhero-ico--l'), a.discipline); setIco(dualMedia.querySelector('.mhero-ico--r'), b.discipline); }
        fillEv(dual && dual.querySelector('.mhero-dual-ev--l'), a);
        fillEv(dual && dual.querySelector('.mhero-dual-ev--r'), b);
        if (singleMedia) singleMedia.style.display = 'none';
        if (singleIn) singleIn.style.display = 'none';
        if (more) more.style.display = 'none';
        if (dualMedia) dualMedia.style.display = '';
        if (dual) dual.style.display = '';
      }
      // Mode PLUSIEURS DIRECTS : une carte par direct (image, sport, compétition, match, lieu, bouton).
      var multi = hero.querySelector('.mhero-multi');
      function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt) e.textContent = txt; return e; }
      function showMulti(list) {
        if (!multi) return;
        var grid = multi.querySelector('.mhero-multi-grid'), nb = multi.querySelector('[data-n]');
        if (nb) nb.textContent = list.length;
        grid.innerHTML = ''; grid.setAttribute('data-count', Math.min(list.length, 4));
        list.slice(0, 4).forEach(function (l) {
          var c = heroColors[l.discipline] || {};
          var a = el('a', 'mm-card'); a.href = 'https://www.youtube.com/watch?v=' + l.id; a.target = '_blank'; a.rel = 'noopener';
          a.style.setProperty('--dc', 'var(--c-' + (l.discipline || 'billard') + ')');
          var shot = el('span', 'mm-shot'), img = document.createElement('img');
          img.alt = ''; img.onerror = function () { if (!this.dataset.f) { this.dataset.f = 1; this.src = 'https://i.ytimg.com/vi/' + l.id + '/hqdefault.jpg'; } };
          img.src = 'https://i.ytimg.com/vi/' + l.id + '/maxresdefault_live.jpg';
          shot.appendChild(img); shot.appendChild(el('span', 'mm-live', '● En direct'));
          var play = el('span', 'mm-play'); play.innerHTML = '<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M8 5v14l11-7z" fill="#fff"/></svg>'; shot.appendChild(play);
          var meta = el('span', 'mm-meta');
          meta.appendChild(el('span', 'mm-tag', c.label || l.discipline || 'Direct'));
          if (l.context) meta.appendChild(el('span', 'mm-ctx', l.context));
          meta.appendChild(el('span', 'mm-h', l.match || clean(l.title)));
          if (l.place) meta.appendChild(el('span', 'mm-place', '📍 ' + l.place));
          meta.appendChild(el('span', 'mm-btn', '▸ Regarder'));
          a.appendChild(shot); a.appendChild(meta); grid.appendChild(a);
        });
        if (list[0] && list[0].discipline) setSport(list[0].discipline);
        if (singleIn) singleIn.style.display = 'none';
        if (dualMedia) dualMedia.style.display = 'none';
        if (dual) dual.style.display = 'none';
        if (singleMedia) singleMedia.style.display = '';
        hero.classList.add('is-multi');
        multi.style.display = '';
      }
      function showSingle() {
        if (multi) multi.style.display = 'none';
        hero.classList.remove('is-multi');
        if (dualMedia) dualMedia.style.display = 'none';
        if (dual) dual.style.display = 'none';
        if (singleMedia) singleMedia.style.display = '';
        if (singleIn) singleIn.style.display = '';
      }
      // GARDE-FOU : la « une » est un direct programmé dont l'heure de début est passée
      // (≤ 3 h) → on l'affiche EN DIRECT, UNIQUEMENT quand la détection (live.json) est KO.
      // Dès que live.json redevient fiable et ne voit plus de direct, on RÉTABLIT l'état
      // d'origine (fin du direct) — sinon le bandeau resterait « en direct » après le match.
      var heroIso = count ? count.getAttribute('data-count') : null;
      function heroStarted() {
        if (!heroIso) return false;
        var t = new Date(heroIso).getTime();
        return t <= Date.now() && Date.now() < t + 3 * 3600000;
      }
      var _orig = null;
      function _snap() {
        if (_orig) return;
        _orig = { pill: pill ? pill.innerHTML : '', pillCls: pill ? pill.className : '', btn: playBtn ? playBtn.textContent : '',
          count: count ? count.style.display : '', cal: (hero.querySelector('.hero-cal') || {}).style ? hero.querySelector('.hero-cal').style.display : '' };
        var tg = (hero.querySelector('.mhero-shot') || {}).querySelector ? hero.querySelector('.mhero-shot').querySelector('.mhero-shot-tag') : null;
        _orig.tag = tg ? tg.textContent : ''; _orig.tagCls = tg ? tg.className : ''; _orig.tagDisp = tg ? tg.style.display : '';
      }
      function flipSelfLive() {
        _snap();
        if (pill) { pill.textContent = '● En direct'; pill.classList.add('is-live'); pill.classList.remove('is-soon'); }
        if (playBtn) playBtn.textContent = '▸ Regarder le direct';
        var shot = hero.querySelector('.mhero-shot');
        var tg = shot && shot.querySelector('.mhero-shot-tag'); if (tg) { tg.textContent = '● En direct'; tg.classList.add('is-live'); tg.style.display = ''; }
        if (count) count.style.display = 'none';
        var cal = hero.querySelector('.hero-cal'); if (cal) cal.style.display = 'none';
      }
      function revertSelf() {
        if (!_orig) return;
        if (pill) { pill.innerHTML = _orig.pill; pill.className = _orig.pillCls; }
        if (playBtn) playBtn.textContent = _orig.btn;
        var shot = hero.querySelector('.mhero-shot');
        var tg = shot && shot.querySelector('.mhero-shot-tag'); if (tg) { tg.textContent = _orig.tag; tg.className = _orig.tagCls; tg.style.display = _orig.tagDisp; }
        if (count) count.style.display = _orig.count;
        var cal = hero.querySelector('.hero-cal'); if (cal) cal.style.display = _orig.cal;
      }
      function sync() {
        fetch('/live.json', { cache: 'no-store' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            var lives = (d && d.lives) ? d.lives : (d && d.live && d.id ? [{ id: d.id, title: d.title || 'Direct' }] : []);
            // 2 directs ou plus (même sport ou non) → une carte image + bouton par direct.
            if (lives.length >= 2) { if (more) more.style.display = 'none'; showMulti(lives); return; }
            showSingle();
            if (more) more.style.display = 'none';
            if (!lives.length) {
              // live.json fiable (error:false) = vérité : s'il n'y a plus de direct, on rétablit
              // l'état (fin du match). Sinon (live.json KO) → garde-fou si l'heure est passée.
              if (d && d.error !== true) revertSelf();
              else if (heroStarted()) flipSelfLive();
              return;
            }
            var l = lives[0];
            if (l.discipline) setSport(l.discipline);
            // Contexte « guide TV » (compétition · phase · saison) + lieu, depuis live.json enrichi.
            var ctx = l.context || '';
            if (l.place) ctx = ctx ? (ctx + ' · 📍 ' + l.place) : ('📍 ' + l.place);
            if (pill) { pill.textContent = '● En direct'; pill.classList.add('is-live'); pill.classList.remove('is-soon'); }
            if (h1) h1.textContent = l.match || clean(l.title);
            if (playBtn) { playBtn.setAttribute('href', 'https://www.youtube.com/watch?v=' + l.id); playBtn.setAttribute('target', '_blank'); playBtn.textContent = '▸ Regarder le direct'; }
            var shot = hero.querySelector('.mhero-shot');
            if (shot) {
              shot.setAttribute('href', 'https://www.youtube.com/watch?v=' + l.id);
              var im = shot.querySelector('img'); if (im) { im.dataset.f = ''; im.onerror = function () { if (!this.dataset.f) { this.dataset.f = 1; this.src = 'https://i.ytimg.com/vi/' + l.id + '/hqdefault.jpg'; } }; im.src = 'https://i.ytimg.com/vi/' + l.id + '/maxresdefault_live.jpg'; }
              var tg = shot.querySelector('.mhero-shot-tag'); if (tg) { tg.textContent = '● En direct'; tg.classList.add('is-live'); tg.style.display = ''; }
            }
            if (count) count.style.display = 'none';
            if (when) when.style.display = 'none';
            if (sub) { if (ctx) { sub.textContent = ctx; sub.style.display = ''; } else { sub.style.display = 'none'; } }
          })
          .catch(function () { if (heroStarted()) flipSelfLive(); }); // live.json injoignable → garde-fou
      }
      sync(); setInterval(sync, 60000);
    })();
  </script>

