---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import Thumb from '../components/Thumb.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { disciplines, getDiscipline, partners, stats, cta, goodies, site } from '../data/site';
import SportIcon from '../components/SportIcon.astro';
import { getLiveFeature, getBroadcasts, getReplays, getChannelStats, tagStyle } from '../lib/youtube';
import { parseProgTitle } from '../lib/programmeTitle';
import { getCollection } from 'astro:content';
import { PLATFORMS } from '../lib/social';
import { articleCover } from '../lib/articles';
import { assetExists, assetUrl, imgOk } from '../lib/publicAssets';
import { showcaseSeason, getSeasons, cal2627 } from '../data/billard/seasons';
import { femmesShowcaseSeason, getFemmesSeasons } from '../data/billard/seasonsFemmes';
import { photoOf, playerSlugs } from '../lib/billardStats';
import { nm1Standings, nmClubBy, NM1_POOL, clubHasSite, nm1Calendar, poolCalendar } from '../data/basket';

// Chiffres-clés : tirés en direct de l'API YouTube (abonnés, vues, vidéos) + nb de
// disciplines. Toujours à jour, aucun chiffre saisi à la main. Repli sur les chiffres
// statiques (src/data/site.ts) si l'API n'est pas disponible au build (dev local sans clé).
const _ch = await getChannelStats();
// Format compact FR SANS surestimer : on tronque (14 200 → « 14 K », pas « 15 K »),
// et l'unité « + » signale « au moins ».
const _compact = (n: number): string => {
  if (n >= 1_000_000) return String(Math.floor(n / 100_000) / 10).replace('.', ',') + ' M';
  if (n >= 1_000) return Math.floor(n / 1_000) + ' K';
  return String(n);
};
// Chiffres qui ne dépendent PAS de l'API (toujours affichés).
const _foundedStat = { num: '2005', label: 'Année de création', raw: true, ic: 'flag' };
const _discStat = { num: String(disciplines.length), label: 'Disciplines couvertes', ic: 'grid' };
const _partnersStat = { num: String(partners.length), label: 'Partenaires du projet', ic: 'partners' };
const liveStats = _ch
  ? [
      _foundedStat,
      { num: _compact(_ch.subscribers), unit: '+', label: 'Abonnés YouTube', ic: 'users' },
      { num: _compact(_ch.views), unit: '+', label: 'Vues cumulées', ic: 'eye' },
      { num: _compact(_ch.videos), unit: _ch.videos >= 1000 ? '+' : '', label: 'Vidéos en ligne', ic: 'video' },
      _discStat,
      _partnersStat,
    ]
  : [_foundedStat, _discStat, _partnersStat];
const STAT_ICONS: Record<string, string> = {
  flag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.2 20a6 6 0 0 1 11.6 0"/><path d="M16 5.4a3 3 0 0 1 0 5.5M21 20a6 6 0 0 0-4-5.7"/></svg>',
  eye: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>',
  video: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="M16 10l6-3v10l-6-3z"/></svg>',
  grid: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
  partners: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 6.6a4.5 4.5 0 0 0-6.4 0L12 9l-2.4-2.4a4.5 4.5 0 1 0-6.4 6.4L12 21.8l8.8-8.8a4.5 4.5 0 0 0 0-6.4z"/></svg>',
};

// « Le mag » de l'accueil : fil UNIFIÉ des 3 dernières actualités — articles
// éditoriaux ET publications réseaux (mêmes contenus que /actualites), les plus
// récents d'abord. Avant, l'accueil ne lisait QUE les posts réseaux → les articles
// publiés (plus récents) n'y apparaissaient pas.
const _newsArticles = (await getCollection('articles', ({ data }) => !data.draft && data.date.valueOf() <= Date.now()))
  .map((a) => {
    const cover = articleCover(a);
    return {
      kind: 'article' as const, href: `/actualites/${a.id}`, date: a.data.date,
      img: cover?.src ?? null, imgFallback: cover?.fallback ?? null, icon: '📰',
      text: a.data.title, tag: 'Article',
      color: disciplines.find((d) => d.slug === a.data.discipline)?.colorVar ?? 'var(--accent)',
      more: "Lire l'article →",
    };
  });
const _newsSocial = (await getCollection('social', ({ data }) => !data.draft))
  .map((p) => {
    const pf = PLATFORMS[p.data.platform] ?? PLATFORMS.facebook;
    return {
      kind: 'social' as const, href: `/actualites/reseaux/${p.id}`, date: p.data.date,
      img: imgOk(p.data.image) ? p.data.image! : null, imgFallback: null, icon: pf.icon,
      text: p.data.caption, tag: pf.label, color: pf.color, more: 'Voir la publication →',
    };
  });
const latestPosts = [..._newsArticles, ..._newsSocial]
  .sort((a, b) => (b.date.valueOf() - a.date.valueOf()) || (a.href < b.href ? -1 : 1))
  .slice(0, 3);
const fmtArticleDate = (d: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

// Spotlight billard : haut du classement de la saison « vitrine » (la plus récente avec
// des résultats → bascule auto sur 2026-2027 dès le 1er TN). Top 4 : vainqueur, finaliste
// et les deux demi-finalistes (= les 4 premiers du classement).
const bilSeason = showcaseSeason();
const bilPlayers = (bilSeason.results?.players ?? []) as any[];
const bilRanked = bilPlayers.filter((p) => !p.invite).sort((a, b) => a.rank - b.rank);
// En cours tant que le Championnat de France n'est pas dans les résultats.
const bilInProgress = !((bilSeason.results?.tournaments ?? []) as any[]).some((t) => t.kind === 'france');
const bilTop = bilRanked.slice(0, 4);          // top 4 (2 cartes × 2)

// Aperçu Basketball (NM1 Poule B) : uniquement le top 5 du classement officiel
// (pas de club mis en avant → neutralité ; le détail est sur la page /basket).
const nbTop5 = nm1Standings().slice(0, 5);
const nbClub = getDiscipline('basket');
const nbLogo = (slug: string) => { const c = nmClubBy(slug); return c && assetExists(c.logo) ? assetUrl(c.logo!) : null; };
const nbHref = (slug: string) => (clubHasSite(slug) ? `/clubs/${slug}` : null);
const { slugOf: bilSlug } = playerSlugs(getSeasons());

// Même principe pour le Blackball FEMMES : top 4 de la saison vitrine (sous le Masters).
const femSeason = femmesShowcaseSeason();
const femRanked = ((femSeason.results?.players ?? []) as any[]).filter((p) => !p.invite).sort((a, b) => a.rank - b.rank);
const femInProgress = !((femSeason.results?.tournaments ?? []) as any[]).some((t) => t.kind === 'france');
const femTop = femRanked.slice(0, 4);
const { slugOf: femSlug } = playerSlugs(getFemmesSeasons());

const rawLive = await getLiveFeature();
// `live` (la « une » du header) est finalisé PLUS BAS, une fois `programme` construit :
// s'il n'y a aucun direct détecté, on met en avant la VIDÉO du prochain rendez-vous
// programmé (ex. la première YouTube du prochain match), et à défaut seulement une
// carte vers le calendrier basket. Voir le bloc « une du header » après `programme`.
let live: any = rawLive;

// « Au programme » : lives YouTube + annonces manuelles (/admin), triés par date.
// UNE seule ligne par discipline = le PROCHAIN rendez-vous de chaque sport.
// Quand un live se termine, il sort de la fenêtre et le suivant du même sport
// prend sa place automatiquement (à la reconstruction suivante).
const _now = Date.now();
const _manualProg = (await getCollection('programme', ({ data }) => !data.draft)).map((p) => ({
  sport: p.data.sport as string, date: p.data.date as Date, live: false,
  thumb: p.data.image as string | undefined, category: p.data.category || '', title: p.data.title || '',
  href: '/programme', id: undefined as string | undefined,   // annonce pas encore sur YouTube → page programme
}));
const _autoProg = (await getBroadcasts()).map((b) => ({
  sport: b.discipline as string, date: new Date(b.date), live: b.live,
  thumb: `https://i.ytimg.com/vi/${b.id}/maxresdefault.jpg`, category: '', title: b.title,
  href: `https://www.youtube.com/watch?v=${b.id}`, id: b.id,   // live prêt sur YouTube → lu dans le grand lecteur
}));
// Auto (vrais lives YouTube) en premier : en cas d'égalité de date avec une annonce
// manuelle du même sport, c'est le vrai live (lien vidéo) qui l'emporte.
const _progSorted = [..._autoProg, ..._manualProg]
  .filter((it) => it.live || it.date.valueOf() + 3 * 3600 * 1000 >= _now)
  .sort((a, b) => (a.live === b.live ? a.date.valueOf() - b.date.valueOf() : a.live ? -1 : 1));
const _CAP_PER_SPORT = 1, _MAX_ITEMS = 7, _perSport = new Map<string, number>();
const programme: typeof _progSorted = [];
for (const it of _progSorted) {
  const c = _perSport.get(it.sport) || 0;
  if (c >= _CAP_PER_SPORT) continue;      // diversité : plafond par discipline
  _perSport.set(it.sport, c + 1);
  programme.push(it);
  if (programme.length >= _MAX_ITEMS) break;
}

// ── La « une » du header ───────────────────────────────────────────────────
// Si l'API YouTube détecte un direct (live/upcoming), on le garde tel quel.
// Sinon (rien en direct, ou juste un vieux replay), on met en avant la VIDÉO du
// prochain rendez-vous PROGRAMMÉ — la première/affiche YouTube du prochain match,
// celle qui a un id vidéo + une miniature → le header affiche bien la vidéo + le
// bouton play, comme prévu. À défaut de vidéo programmée, on retombe sur une simple
// carte vers le calendrier basket (prochain match de Fougères à domicile, ≤ 16 j).
if (!rawLive || rawLive.status === 'replay') {
  const _up = programme.find((it) => it.id && (it.live || it.date.valueOf() >= _now - 2 * 3600 * 1000));
  if (_up) {
    live = {
      discipline: _up.sport, id: _up.id, isLive: !!_up.live,
      status: _up.live ? 'live' : 'upcoming',
      caption: _up.sport === 'basket' ? `Basket · ${NM1_POOL}` : (getDiscipline(_up.sport as any)?.label ?? _up.sport),
      title: _up.title, href: _up.href, thumb: _up.thumb, date: _up.date,
    };
  } else {
    const _todayHero = new Date().toISOString().slice(0, 10);
    const _nextHome = poolCalendar().find((m) => m.homeSlug === 'fougeres' && m.homeScore == null && m.date >= _todayHero);
    if (_nextHome) {
      const _md = new Date(`${_nextHome.date}T20:00:00+02:00`);
      if ((_md.getTime() - _now) / 86400000 <= 16) {
        const _away = nmClubBy(_nextHome.awaySlug)?.name ?? _nextHome.awaySlug;
        live = {
          discipline: 'basket', id: undefined, isLive: false, status: 'upcoming',
          caption: `Basket · ${NM1_POOL}`, title: `Pays de Fougères vs ${_away}`,
          href: '/basket', thumb: undefined, date: _md,
        };
      }
    }
  }
}

const railDay = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/Paris' });
const railTime = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' });

const replays = await getReplays({ limit: 3 });
// Bandeau bas de la « une » (option C) : les derniers replays (les directs terminés y arrivent).
// « Derniers replays » : replays des 2 DERNIERS MOIS, triés par fraîcheur (getReplays() est
// déjà trié du plus récent au plus ancien). 1 par discipline, SAUF billard et basket (jusqu'à 3).
const _cut = new Date(_now); _cut.setMonth(_cut.getMonth() - 2);
const _cutMs = _cut.getTime();
const _allReplays = await getReplays();
const _maxPer = (d: string) => (d === 'billard' || d === 'basket' ? 3 : 1);
const _replCount = new Map<string, number>();
const beltReplays: typeof _allReplays = [];
for (const v of _allReplays) {
  if (!v.date || new Date(v.date).getTime() < _cutMs) continue;   // fenêtre 2 mois
  const c = _replCount.get(v.discipline) || 0;
  if (c >= _maxPer(v.discipline)) continue;                        // plafond par discipline
  _replCount.set(v.discipline, c + 1);
  beltReplays.push(v);
}
// Version TELEPHONE/TABLETTE de « Derniers replays » : le dernier billard + le dernier basket.
const replaysMobile = [
  ...(await getReplays({ discipline: 'billard', limit: 1 })),
  ...(await getReplays({ discipline: 'basket', limit: 1 })),
];
const liveCount = programme.filter((p) => p.live).length;
// Si aucun direct/programme, le rail affiche la DERNIÈRE vidéo de CHAQUE discipline
// (une par sport), en gardant l'ordre par heure réelle de diffusion la plus récente.
let railReplays: Awaited<ReturnType<typeof getReplays>> = [];
if (!programme.length) {
  const all = await getReplays();
  const seen = new Set<string>();
  for (const v of all) {
    if (!seen.has(v.discipline)) {
      seen.add(v.discipline);
      railReplays.push(v);
    }
  }
}

const liveDisc = live ? getDiscipline(live.discipline) : null;
// Couleurs + libellé par sport (pour le swap temps réel du hero côté client, simple ET double).
const heroColors = Object.fromEntries(disciplines.map((d) => [d.slug, { from: d.from, to: d.to, label: d.label }]));

// Maillage low-poly « double » : facettes var(--mix-l) à gauche, var(--mix-r) à droite
// (recolorées par les 2 disciplines quand 2 directs simultanés).
const POLY_DUAL = (() => {
  const COLS = 12, ROWS = 5, W = 1200, H = 420, cw = W / COLS, ch = H / ROWS;
  const tris: { pts: string; col: string; op: string }[] = [];
  for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) {
    const x0 = c * cw, x1 = (c + 1) * cw, y0 = r * ch, y1 = (r + 1) * ch;
    const cells: number[][][] = ((r + c) % 2 === 0)
      ? [[[x0, y0], [x1, y0], [x0, y1]], [[x1, y0], [x1, y1], [x0, y1]]]
      : [[[x0, y0], [x1, y0], [x1, y1]], [[x0, y0], [x1, y1], [x0, y1]]];
    cells.forEach((t) => {
      const xc = (t[0][0] + t[1][0] + t[2][0]) / 3;
      const col = xc < W * 0.5 ? 'var(--mix-l)' : 'var(--mix-r)';
      const op = (0.02 + Math.abs(xc / W - 0.5) * 2 * 0.14).toFixed(3);
      tris.push({ pts: t.map((p) => p.map(Math.round).join(',')).join(' '), col, op });
    });
  }
  return tris;
})();

// Fond « low-poly » : maillage de triangles, recoloré par la discipline via --h-from/--h-to.
// Plus visible à droite (côté couleur), s'efface vers le texte à gauche.
const POLY = (() => {
  const COLS = 10, ROWS = 5, W = 1200, H = 420, cw = W / COLS, ch = H / ROWS;
  const tris: { pts: string; col: string; op: string }[] = [];
  for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) {
    const x0 = c * cw, x1 = (c + 1) * cw, y0 = r * ch, y1 = (r + 1) * ch;
    const cells: number[][][] = ((r + c) % 2 === 0)
      ? [[[x0, y0], [x1, y0], [x0, y1]], [[x1, y0], [x1, y1], [x0, y1]]]
      : [[[x0, y0], [x1, y0], [x1, y1]], [[x0, y0], [x1, y1], [x0, y1]]];
    cells.forEach((t, k) => {
      const xc = (t[0][0] + t[1][0] + t[2][0]) / 3, yc = (t[0][1] + t[1][1] + t[2][1]) / 3;
      const op = (0.015 + (xc / W) * 0.15 + (1 - yc / H) * 0.03).toFixed(3);
      const col = ((r * COLS + c + k) % 3 === 0) ? 'var(--h-to)' : 'var(--h-from)';
      tris.push({ pts: t.map((p) => p.map(Math.round).join(',')).join(' '), col, op });
    });
  }
  return tris;
})();

// (Le hero de l'accueil est désormais auto-généré par sport — plus d'image de fond fixe.)
const tagLabel = (t: string) => (t === 'magazine' ? 'Magazine' : getDiscipline(t as any).label);
// Catégorie de la vidéo à la une (déduite du titre, ex. « Femmes »), sinon la discipline.
const fmtCat = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : '');
const heroPt = live ? parseProgTitle(live.title) : null;
const heroCat = live ? (fmtCat(heroPt!.kicker) || liveDisc?.name || '') : '';
const heroTitle = heroPt?.main || (live?.title ?? '');   // titre nettoyé (sans les « | » ni emoji)
const heroSub = heroPt ? heroPt.badges.join(' · ') : ''; // ex. « 26/27 · 1/4 FINALE »
const heroStatusLabel = live ? (live.status === 'live' ? 'En direct' : live.status === 'upcoming' ? 'Bientôt' : 'À revoir') : '';

// À la une : date de l'événement (croisée avec le programme, même id) → date lisible,
// décompte et lien « Ajouter au calendrier » (Google Agenda généré depuis la date).
const heroProg = live?.id ? programme.find((it) => it.id === live.id) : null;
const heroDate = heroProg?.date ?? (live as any)?.date ?? null;
const _heroFullDate = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' });
const heroDateLabel = heroDate
  ? (() => { const s = _heroFullDate.format(heroDate); return s.charAt(0).toUpperCase() + s.slice(1) + ' · ' + railTime.format(heroDate).replace(':', 'h'); })()
  : '';
const heroWhenLabel = live?.isLive ? [live.venue, live.viewers].filter(Boolean).join(' · ') : heroDateLabel;
const heroIso = heroDate ? heroDate.toISOString() : '';
const _gcalFmt = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
const gcalUrl = heroDate
  ? `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(heroTitle + ' — LSEI')}&dates=${_gcalFmt(heroDate)}/${_gcalFmt(new Date(heroDate.getTime() + 2 * 3600 * 1000))}&details=${encodeURIComponent('En direct sur LSEI — Le Sport en Image · https://lsei.tv/direct')}`
  : '';

// Bouton « Regarder » de la une :
// - diffusion À VENIR → on envoie vers la CHAÎNE (le lien d'une vidéo à venir mène à son
//   replay une fois passée, tant que le site n'a pas été reconstruit) ;
// - direct EN COURS ou REPLAY → vers la vidéo précise.
// (Quand un direct démarre, le script temps réel repointe de toute façon le bouton dessus.)
const heroBtnHref = !live ? site.youtubeUrl
  : live.status === 'upcoming' ? (live.id ? site.youtubeUrl : (live.href || site.youtubeUrl))
  : (live.id ? `https://www.youtube.com/watch?v=${live.id}` : (live.href || site.youtubeUrl));

// Concept 3 « Prochain direct » : le direct programmé le plus proche → carte compte à rebours.
const nextLive = programme.find((it) => !it.live && it.date.valueOf() > _now) || null;
const restProg = programme.filter((it) => it !== nextLive);
const nextPt = nextLive && !nextLive.category ? parseProgTitle(nextLive.title) : null;
const nextMain = nextLive ? (nextLive.category || nextPt?.main || nextLive.title) : '';
const nextSub = nextLive ? [railDay.format(nextLive.date).replace('.', ''), railTime.format(nextLive.date).replace(':', 'h')].join(' · ') : '';

// Image de la « une » : la miniature YouTube de la vidéo à la une (grande taille, repli auto en hqdefault).
const heroShot = live?.id ? `https://i.ytimg.com/vi/${live.id}/maxresdefault.jpg` : (live?.thumb || '');
const heroShotFallback = live?.id ? `https://i.ytimg.com/vi/${live.id}/hqdefault.jpg` : '';

// « Prochains rendez-vous » (bandeau sous la une) : le direct YouTube programmé (heure exacte, décompte)
// + les prochaines dates CONNUES des calendriers du site : étape du circuit Blackball, match à domicile
// de Pays de Fougères (NM1). Toujours quelque chose à annoncer, même sans direct programmé sur YouTube.
const _todayIso = new Date(_now).toISOString().slice(0, 10);
const _dLong = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/Paris' });
type Rdv = { sport: string; kicker: string; title: string; when: string; place?: string; iso: string; day: string; exact: boolean; href: string };
const rdv: Rdv[] = [];
if (nextLive) rdv.push({ sport: nextLive.sport, kicker: 'Direct programmé', title: nextMain, when: nextSub, iso: nextLive.date.toISOString(), day: nextLive.date.toISOString().slice(0, 10), exact: true, href: nextLive.href });
const _tn = cal2627.find((e) => e.start && e.start >= _todayIso && e.kind !== 'mondial');
if (_tn && !rdv.some((r) => r.sport === 'billard')) rdv.push({ sport: 'billard', kicker: 'Blackball · circuit national', title: _tn.name, when: _tn.date, place: _tn.place, iso: '', day: _tn.start!, exact: false, href: '/billard/blackball/' });
const _pfb = nm1Calendar.find((m) => m.homeSlug === 'fougeres' && m.date >= _todayIso && m.homeScore == null);
if (_pfb && !rdv.some((r) => r.sport === 'basket')) rdv.push({ sport: 'basket', kicker: 'Basket · Nationale 1', title: `Pays de Fougères – ${nmClubBy(_pfb.awaySlug)?.name ?? _pfb.awaySlug}`, when: (() => { const s = _dLong.format(new Date(`${_pfb.date}T12:00:00Z`)).replace('.', ''); return s.charAt(0).toUpperCase() + s.slice(1); })(), place: 'Fougères · à domicile', iso: '', day: _pfb.date, exact: false, href: '/basket/' });
rdv.sort((a, b) => (a.day < b.day ? -1 : 1));
const rdvShow = rdv.slice(0, 3);

// Cartes des disciplines : fond = miniature de la dernière vidéo du sport (mqdefault = vrai 16:9, sans bandes noires).
const discThumb: Record<string, string> = {};
for (const v of _allReplays) if (!discThumb[v.discipline]) discThumb[v.discipline] = `https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`;

// Carrousel « prochains directs » : tous les directs À VENIR, défilement 10 s, chacun
// avec son propre décompte (et bascule « en direct » quand l'heure est atteinte).
const slides = programme
  .filter((it) => !it.live && it.date.valueOf() > _now)
  .map((it) => {
    const pt = it.category ? null : parseProgTitle(it.title);
    return {
      href: it.href, id: it.id as string | undefined, sport: it.sport, thumb: it.thumb,
      main: it.category || pt?.main || it.title,
      iso: it.date.toISOString(),
      when: [railDay.format(it.date).replace('.', ''), railTime.format(it.date).replace(':', 'h')].join(' · '),
    };
