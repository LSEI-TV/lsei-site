---
// HUB BASKETBALL — page « championnat » NM1 : logos des clubs + calendrier + classement.
// Clic sur un club (avec mini-site) → /clubs/<slug>. « Site dans le site » façon NBA.
import Base from '../layouts/Base.astro';
import { getDiscipline } from '../data/site';
import { NM1_LABEL, NM1_POOL, SEASON, SEASON_START, nmClubs, nmClubBy, nm1Standings, seasonStarted, standingsUpdated, standingsIsOfficial, clubHasSite, poolCalendar } from '../data/basket';
import { assetExists, assetUrl } from '../lib/publicAssets';

const d = getDiscipline('basket');
const standings = nm1Standings();
const started = seasonStarted();
const standingsMaj = standingsUpdated
  ? new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', timeZone: 'Europe/Paris' }).format(new Date(standingsUpdated))
  : null;
const fmtDay = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/Paris' });
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Calendrier complet de la Poule B, groupé par date.
const poolCal = poolCalendar();
const byDate: Record<string, typeof poolCal> = {};
for (const m of poolCal) (byDate[m.date] ??= []).push(m);
const calDates = Object.keys(byDate).sort();
const fmtCalDate = (iso: string) => cap(new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Paris' }).format(new Date(iso + 'T00:00:00')));
// Filtres du calendrier : équipes (triées) + mois présents.
const clubsSorted = [...nmClubs].sort((a, b) => a.name.localeCompare(b.name, 'fr'));
const MONTHS: Record<string, string> = { '09': 'Sept.', '10': 'Oct.', '11': 'Nov.', '12': 'Déc.', '01': 'Janv.', '02': 'Févr.', '03': 'Mars', '04': 'Avr.', '05': 'Mai', '06': 'Juin' };
const monthsPresent = [...new Set(calDates.map((d) => d.slice(0, 7)))].sort();
const monthLabel = (ym: string) => MONTHS[ym.slice(5, 7)] ?? ym;
const clubHref = (slug: string) => (clubHasSite(slug) ? `/clubs/${slug}` : null);

// En-tête : prochain match + dernier résultat du Pays de Fougères, son rang, la journée en cours.
const todayIso = new Date().toISOString().slice(0, 10);
const pfbGames = poolCal.filter((m) => m.homeSlug === 'fougeres' || m.awaySlug === 'fougeres');
const pfbNext = pfbGames.find((m) => m.date >= todayIso && m.homeScore == null);
const pfbLast = [...pfbGames].reverse().find((m) => m.homeScore != null && m.awayScore != null);
const pfbRank = standings.findIndex((r) => r.slug === 'fougeres') + 1;
const playedDays = calDates.filter((dt) => byDate[dt].some((m) => m.homeScore != null));
const daysTo = (iso: string) => Math.round((Date.parse(iso + 'T12:00:00Z') - Date.parse(todayIso + 'T12:00:00Z')) / 86400000);
const jx = (iso: string) => { const n = daysTo(iso); return n <= 0 ? "Aujourd'hui" : n === 1 ? 'Demain' : `J-${n}`; };
const logoOf = (slug: string) => { const c = nmClubBy(slug); return c && assetExists(c.logo) ? assetUrl(c.logo!) : null; };
const lastWin = pfbLast ? ((pfbLast.homeSlug === 'fougeres') === (pfbLast.homeScore! > pfbLast.awayScore!)) : null;
---
<Base title={`Basketball ${NM1_LABEL} (NM1) — ${NM1_POOL}`} description={`${NM1_LABEL} (NM1) ${NM1_POOL} ${SEASON} sur LSEI : les clubs, le calendrier, le classement et les vidéos — du Pays de Fougères Basket à toute la poule.`} active="disciplines">
  <section class="nb-hero" style={`--dc:${d.colorVar}`}>
    <div class="wrap nb-hero-in">
      <div class="nb-hero-txt">
        <div class="nb-crumb"><a href="/disciplines/">Disciplines</a><span aria-hidden="true">›</span>Basketball</div>
        <h1 class="nb-h">Basketball<span>{NM1_LABEL}</span></h1>
        <p class="nb-p">Saison {SEASON} · {NM1_POOL}. Les clubs du championnat, le classement et le calendrier complet. Cliquez sur un club pour entrer dans son espace.</p>
        <div class="nb-kpis">
          <div><b>{nmClubs.length}</b><span>clubs</span></div>
          <div><b>{playedDays.length}</b><span>journée{playedDays.length > 1 ? 's' : ''} jouée{playedDays.length > 1 ? 's' : ''}</span></div>
          {pfbRank > 0 && started && <div><b>{pfbRank}<sup>{pfbRank === 1 ? 'er' : 'e'}</sup></b><span>Pays de Fougères</span></div>}
        </div>
      </div>
      {(pfbNext || pfbLast) && (
        <div class="nb-match-card">
          {pfbNext && (
            <div class="nb-mc-next">
              <div class="nb-mc-k"><span>Prochain match · Pays de Fougères</span><b>{jx(pfbNext.date)}</b></div>
              <div class="nb-mc-teams">
                {[pfbNext.homeSlug, pfbNext.awaySlug].map((sl, i) => (
                  <Fragment>
                    {i === 1 && <span class="nb-mc-vs">VS</span>}
                    <span class="nb-mc-team">
                      <span class="nb-mc-logo">{logoOf(sl) ? <img src={logoOf(sl)!} alt="" /> : <span>{nmClubBy(sl)?.short}</span>}</span>
                      <span class="nb-mc-name">{nmClubBy(sl)?.name}</span>
                    </span>
                  </Fragment>
                ))}
              </div>
              <div class="nb-mc-when">{fmtCalDate(pfbNext.date)}{pfbNext.round ? ` · Journée ${pfbNext.round}` : ''} · {pfbNext.homeSlug === 'fougeres' ? 'à domicile' : 'à l\'extérieur'}</div>
            </div>
          )}
          {pfbLast && (
            <div class={`nb-mc-last ${lastWin ? 'is-win' : 'is-loss'}`}>
              <span class="nb-mc-res">{lastWin ? 'V' : 'D'}</span>
              <span class="nb-mc-last-t">Dernier résultat : <b>{nmClubBy(pfbLast.homeSlug)?.name} {pfbLast.homeScore} – {pfbLast.awayScore} {nmClubBy(pfbLast.awaySlug)?.name}</b></span>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="section nb-body">
    <div class="wrap">
      {!started && (
        <div class="nb-info">🗓️ <b>Saison {SEASON} · {NM1_POOL}</b> — le championnat débute le {SEASON_START}. Les scores et le classement s'afficheront au fil des journées.</div>
      )}

      <!-- CLUBS -->
      <div class="sec-head"><div><div class="eyebrow" style={`color:${d.colorVar}`}>Les clubs</div><h2>Les {nmClubs.length} clubs de la <em>{NM1_POOL}</em></h2></div></div>
      <div class="nb-clubs">
        {nmClubs.map((c) => {
          const href = clubHref(c.slug);
          const inner = (
            <Fragment>
              <span class="nb-club-band" aria-hidden="true"></span>
              <span class="nb-logo" style={`--cc:${c.color}`}>
                {assetExists(c.logo) ? <img src={assetUrl(c.logo!)} alt={c.name} loading="lazy" /> : <span class="nb-logo-txt">{c.short}</span>}
              </span>
              <span class="nb-club-name">{c.name}</span>
              <span class="nb-club-city">{c.city}</span>
              {href ? <span class="nb-club-cta" style={`color:${c.color}`}>Voir le club →</span> : <span class="nb-club-soon">Bientôt</span>}
            </Fragment>
          );
          return href
            ? <a href={href} class="nb-club is-active" style={`--cc:${c.color}`}>{inner}</a>
            : <div class="nb-club" style={`--cc:${c.color}`}>{inner}</div>;
        })}
      </div>

      <div class="nb-cols">
      <!-- CLASSEMENT (Poule B) -->
      <div class="nb-standings">
        <div class="sec-head"><div><div class="eyebrow" style={`color:${d.colorVar}`}>Classement</div><h2>Le <em>classement</em></h2></div></div>
        <div class="nb-rank-box">
        <table class="nb-rank">
          <thead><tr><th>#</th><th>Club</th><th>J</th><th>V</th><th>D</th><th>Pts</th></tr></thead>
          <tbody>
            {standings.map((r, i) => {
              const c = nmClubBy(r.slug);
              const href = clubHref(r.slug);
              return (
                <tr class={`${r.slug === 'fougeres' ? 'is-me' : ''} ${i < 3 ? 'is-top' : ''}`}>
                  <td class="nb-rk">{i + 1}</td>
                  <td class="nb-rc"><span class="nb-rlogo">{logoOf(r.slug) ? <img src={logoOf(r.slug)!} alt="" loading="lazy" /> : <span class="nb-dot" style={`background:${c?.color}`}></span>}</span>{href ? <a class="nb-rc-link" href={href}>{c?.name ?? r.slug}</a> : <span>{c?.name ?? r.slug}</span>}</td>
                  <td>{r.played}</td><td>{r.w}</td><td>{r.l}</td><td class="nb-pts">{r.pts}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        </div>
        {standingsIsOfficial && standingsMaj && (
          <p class="nb-rank-src">Classement officiel FFBB (<a href="https://nm1.ffbb.com/saison-reguliere/classement" target="_blank" rel="noopener">nm1.ffbb.com</a>) · mis à jour le {standingsMaj}.</p>
        )}
      </div>

      <!-- CALENDRIER complet de la Poule B -->
      {calDates.length > 0 && (
        <div class="nb-fullcal" id="nb-fullcal">
          <div class="sec-head"><div><div class="eyebrow" style={`color:${d.colorVar}`}>Calendrier · {SEASON}</div><h2>Tous les <em>matchs</em></h2></div></div>

          <div class="fc-filters">
            <select class="fc-select" id="fc-team" aria-label="Filtrer par équipe">
              <option value="all">Toutes les équipes</option>
              {clubsSorted.map((c) => <option value={c.slug}>{c.name}</option>)}
            </select>
            <div class="fc-months" id="fc-months">
              <button class="fc-mn is-on" data-month="all" type="button">Tous</button>
              {monthsPresent.map((ym) => <button class="fc-mn" data-month={ym} type="button">{monthLabel(ym)}</button>)}
            </div>
          </div>

          <div class="fc-list" id="fc-list">
            {calDates.map((date) => (
              <div class="fc-day" data-date={date} data-month={date.slice(0, 7)}>
                <div class="fc-date">{fmtCalDate(date)}</div>
                <div class="fc-games">
                  {byDate[date].map((m) => {
                    const h = nmClubBy(m.homeSlug), a = nmClubBy(m.awaySlug);
                    const hh = clubHref(m.homeSlug), ah = clubHref(m.awaySlug);
                    const played = m.homeScore != null && m.awayScore != null;
                    return (
                      <div class="fc-game" data-h={m.homeSlug} data-a={m.awaySlug}>
                        <span class="fc-team th">
                          {hh ? <a class="fc-tn" href={hh}>{h?.name}</a> : <span class="fc-tn">{h?.name}</span>}
                          <span class="fc-badge">{h && assetExists(h.logo) ? <img src={assetUrl(h.logo!)} alt="" loading="lazy" /> : <span class="fc-dot" style={`background:${h?.color}`}></span>}</span>
                        </span>
                        <span class="fc-sc">{played ? `${m.homeScore} – ${m.awayScore}` : 'vs'}</span>
                        <span class="fc-team ta">
                          <span class="fc-badge">{a && assetExists(a.logo) ? <img src={assetUrl(a.logo!)} alt="" loading="lazy" /> : <span class="fc-dot" style={`background:${a?.color}`}></span>}</span>
                          {ah ? <a class="fc-tn" href={ah}>{a?.name}</a> : <span class="fc-tn">{a?.name}</span>}
                        </span>
                        <span class="fc-loc" hidden></span>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
          <p class="fc-empty" id="fc-empty" hidden>Aucun match pour ce filtre.</p>
        </div>
      )}
      </div>
    </div>
  </section>

  <script is:inline>
    // Calendrier : filtre par équipe + par mois, grisage des passés et mise en
    // avant de la prochaine journée (recalculés sur les jours visibles).
    (function () {
      try {
        var d = new Date();
        var today = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        var teamSel = document.getElementById('fc-team');
        var monthsWrap = document.getElementById('fc-months');
        var empty = document.getElementById('fc-empty');
        var days = [].slice.call(document.querySelectorAll('#fc-list .fc-day'));
        var team = 'all', month = 'all';

        function apply() {
          var visible = 0, nextDone = false;
          days.forEach(function (day) {
            var monthOk = (month === 'all' || day.getAttribute('data-month') === month);
            var anyGame = false;
            [].slice.call(day.querySelectorAll('.fc-game')).forEach(function (g) {
              var ok = monthOk && (team === 'all' || g.getAttribute('data-h') === team || g.getAttribute('data-a') === team);
              g.hidden = !ok;
              if (ok) anyGame = true;
              var loc = g.querySelector('.fc-loc');
              if (loc) {
                if (ok && team !== 'all') {
                  var dom = g.getAttribute('data-h') === team;
                  loc.textContent = dom ? 'Domicile' : 'Extérieur';
                  loc.className = 'fc-loc ' + (dom ? 'dom' : 'ext');
                  loc.hidden = false;
                } else { loc.hidden = true; }
              }
            });
            day.classList.remove('is-past', 'is-next');
            if (!anyGame) { day.hidden = true; return; }
            day.hidden = false; visible++;
            var dt = day.getAttribute('data-date');
            if (dt && dt < today) day.classList.add('is-past');
            else if (dt && !nextDone) { day.classList.add('is-next'); nextDone = true; }
          });
          if (empty) empty.hidden = visible > 0;
        }

        if (teamSel) teamSel.addEventListener('change', function () { team = teamSel.value; apply(); });
        if (monthsWrap) monthsWrap.addEventListener('click', function (e) {
          var b = e.target.closest ? e.target.closest('.fc-mn') : null;
          if (!b) return;
          month = b.getAttribute('data-month');
          monthsWrap.querySelectorAll('.fc-mn').forEach(function (x) { x.classList.toggle('is-on', x === b); });
          apply();
        });

        // Par défaut : le MOIS EN COURS (vraie date). Sinon le prochain mois dispo,
        // sinon le dernier. Suit donc tout seul le calendrier réel au fil des mois.
        if (monthsWrap) {
          var curYM = today.slice(0, 7);
          var btns = [].slice.call(monthsWrap.querySelectorAll('.fc-mn')).filter(function (b) { return b.getAttribute('data-month') !== 'all'; });
          var target = null;
          for (var i = 0; i < btns.length; i++) if (btns[i].getAttribute('data-month') === curYM) { target = btns[i]; break; }
          if (!target) for (var j = 0; j < btns.length; j++) if (btns[j].getAttribute('data-month') >= curYM) { target = btns[j]; break; }
          if (!target && btns.length) target = btns[btns.length - 1];
          if (target) {
            month = target.getAttribute('data-month');
            monthsWrap.querySelectorAll('.fc-mn').forEach(function (x) { x.classList.toggle('is-on', x === target); });
          }
        }
        apply();
      } catch (e) {}
    })();
  </script>
</Base>

<style>
  /* ---------- En-tête sombre ---------- */
  .nb-hero { position: relative; color: #fff; overflow: hidden;
    background: radial-gradient(70% 140% at 88% 10%, color-mix(in srgb, var(--dc) 38%, #0A0E1A) 0%, #0A0E1A 64%), #0A0E1A; }
  .nb-hero::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--brand-bars, var(--dc)); }
  .nb-hero::after { content: ""; position: absolute; right: -90px; bottom: -150px; width: 440px; height: 440px; border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--dc) 30%, transparent); box-shadow: inset 0 0 0 70px color-mix(in srgb, var(--dc) 5%, transparent); pointer-events: none; }
  .nb-hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 40px; align-items: center; padding-top: 50px; padding-bottom: 46px; }
  .nb-crumb { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55); }
  .nb-crumb a { color: var(--dc); text-decoration: none; }
  .nb-h { font-family: var(--display); font-weight: 800; text-transform: uppercase; letter-spacing: -.02em; font-size: clamp(42px, 6vw, 78px); line-height: .92; margin: 12px 0 0; color: #fff; }
  .nb-h span { display: block; font-size: .42em; letter-spacing: .02em; margin-top: 8px; color: var(--dc); }
  .nb-p { color: rgba(255,255,255,.8); font-size: 16px; line-height: 1.5; margin: 16px 0 0; max-width: 560px; text-align: start; }
  .nb-kpis { display: flex; flex-wrap: wrap; gap: 12px 34px; margin-top: 24px; }
  .nb-kpis div { display: flex; flex-direction: column; }
  .nb-kpis b { font-family: var(--display); font-weight: 800; font-size: 34px; line-height: 1; color: #fff; }
  .nb-kpis sup { font-size: .45em; }
  .nb-kpis span { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55); margin-top: 4px; }
  .nb-match-card { border-radius: 16px; overflow: hidden; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); box-shadow: 0 24px 50px -24px rgba(0,0,0,.8); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .nb-mc-next { padding: 20px 22px 18px; border-top: 4px solid var(--dc); }
  .nb-mc-k { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.65); }
  .nb-mc-k b { flex: none; white-space: nowrap; color: #fff; background: var(--dc); padding: 3px 10px; border-radius: 999px; letter-spacing: .04em; }
  .nb-mc-teams { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; margin-top: 18px; }
  .nb-mc-team { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; min-width: 0; }
  .nb-mc-logo { width: 84px; height: 84px; border-radius: 50%; background: #fff; display: grid; place-items: center; overflow: hidden; box-shadow: 0 10px 24px -10px rgba(0,0,0,.6); }
  .nb-mc-logo img { width: 86%; height: 86%; object-fit: contain; }
  .nb-mc-logo span { font-family: var(--display); font-weight: 800; color: #0A0E1A; font-size: 22px; }
  .nb-mc-name { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 15px; line-height: 1.05; }
  .nb-mc-vs { font-family: var(--display); font-weight: 800; font-size: 26px; color: var(--dc); }
  .nb-mc-when { margin-top: 16px; text-align: center; font-size: 13.5px; font-weight: 700; color: rgba(255,255,255,.8); }
  .nb-mc-last { display: flex; align-items: center; gap: 12px; padding: 12px 22px; background: rgba(0,0,0,.25); border-top: 1px solid rgba(255,255,255,.1); font-size: 13px; color: rgba(255,255,255,.75); }
  .nb-mc-last b { color: #fff; }
  .nb-mc-res { flex: none; width: 26px; height: 26px; border-radius: 6px; display: grid; place-items: center; font-weight: 800; font-size: 13px; color: #fff; }
  .nb-mc-last.is-win .nb-mc-res { background: #2e9e52; }
  .nb-mc-last.is-loss .nb-mc-res { background: #d0433a; }

  /* ---------- Corps de page ---------- */
  .nb-body { background-image: radial-gradient(rgba(20, 30, 50, .055) 1px, transparent 1.4px); background-size: 22px 22px; }
  .nb-body .sec-head h2 em { font-style: normal; background: linear-gradient(90deg, var(--b-blue, #009FE3), var(--b-pink, #E6007E)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nb-cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 34px; align-items: start; margin-top: 46px; }
  .nb-cols .nb-standings { position: sticky; top: 90px; max-width: none; }
  .nb-cols .nb-fullcal { margin-top: 0; }
  .nb-rank-box { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; box-shadow: 0 1px 2px rgba(16,24,40,.05), 0 10px 26px -14px rgba(16,24,40,.16); }
  .nb-rank-box .nb-rank th { background: var(--surface-2); padding: 10px 6px; }
  .nb-rank-box .nb-rank td { padding: 9px 6px; }
  .nb-rank-box .nb-rank tr:last-child td { border-bottom: 0; }
  .nb-rank .nb-rk { width: 34px; }
  .nb-rank tr.is-top .nb-rk { color: var(--dc, var(--c-basket)); }
  .nb-rank tr.is-me td { background: color-mix(in srgb, var(--c-basket) 12%, transparent); }
  .nb-rank tr.is-me td:first-child { box-shadow: inset 4px 0 0 var(--c-basket); }
  .nb-rlogo { flex: none; width: 26px; height: 26px; display: grid; place-items: center; }
  .nb-rlogo img { max-width: 100%; max-height: 100%; object-fit: contain; }

  .nb-info { background: color-mix(in srgb, var(--dc) 8%, var(--surface)); border: 1px solid color-mix(in srgb, var(--dc) 30%, var(--line)); color: var(--ink); border-radius: 10px; padding: 11px 15px; font-size: 13.5px; margin-bottom: 26px; }

  /* Clubs */
  .nb-clubs { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; margin-bottom: 12px; }
  .nb-club { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 0 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); text-decoration: none; color: inherit;
    box-shadow: 0 1px 2px rgba(16,24,40,.05), 0 10px 26px -14px rgba(16,24,40,.16); transition: border-color .2s, transform .25s cubic-bezier(.2,.7,.2,1), box-shadow .25s; }
  .nb-club.is-active:hover { border-color: var(--cc); transform: translateY(-4px); box-shadow: 0 22px 40px -18px color-mix(in srgb, var(--cc) 55%, rgba(16,24,40,.4)); }
  .nb-club-band { align-self: stretch; height: 46px; margin: 0 -14px; background: linear-gradient(135deg, var(--cc), color-mix(in srgb, var(--cc) 55%, #0A0E1A)); }
  .nb-logo { width: 78px; height: 78px; margin-top: -39px; border-radius: 50%; display: grid; place-items: center; overflow: hidden; background: #fff; border: 3px solid var(--surface); box-shadow: 0 8px 18px -8px rgba(0,0,0,.45); transition: transform .3s; }
  .nb-club.is-active:hover .nb-logo { transform: scale(1.08); }
  .nb-logo img { width: 86% !important; height: 86% !important; }
