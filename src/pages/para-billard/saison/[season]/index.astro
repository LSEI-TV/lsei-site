---
import Base from '../../../../layouts/Base.astro';
import HubNav from '../../../../components/HubNav.astro';
import SeasonHero from '../../../../components/SeasonHero.astro';
import { seasonNext } from '../../../../lib/seasonNext';
import PlayerSearch from '../../../../components/PlayerSearch.astro';
import AffichesTournois from '../../../../components/AffichesTournois.astro';
import VideoPlayer from '../../../../components/VideoPlayer.astro';
import { getReplays } from '../../../../lib/youtube';
import { getDiscipline } from '../../../../data/site';
import { photoOf, fromPov, seasonHighlights, playerSlugs, tournamentPodiumById } from '../../../../lib/billardStats';
import { getParaSeasons, getParaPalmares, PARA_DEFAULT_SEASON } from '../../../../data/billard/seasonsPara';
const { slugOf } = playerSlugs(getParaSeasons());
import type { Season } from '../../../../data/billard/seasons';

export function getStaticPaths() {
  return getParaSeasons().map((s) => ({ params: { season: s.slug }, props: { season: s } }));
}
const { season } = Astro.props as { season: Season };
const base = `/para-billard/saison/${season.slug}`;
const calSeason = season;

const R: any = season.results;
const hasData = !!R;
const players: any[] = hasData ? R.players : [];
const matches: any[] = hasData ? R.matches : [];
const top5 = players.slice(0, 5);
const spot = players[0];
const nCal = calSeason.calendar.length;
const { nextIdx, nextJx } = seasonNext(calSeason.calendar);
const spotPhoto = spot ? photoOf(spot, season.slug) : null;
const spotResults = spot ? matches.filter((m) => m.aId === spot.id || m.bId === spot.id).sort((a, b) => (a.date < b.date ? 1 : -1)).map((m) => fromPov(m, spot.id)).slice(0, 4) : [];
const recent = hasData ? [...matches].sort((a, b) => (a.date < b.date ? 1 : -1)).slice(0, 5) : [];
const tourById = (tid: string) => (hasData ? R.tournaments.find((t: any) => t.id === tid) : undefined);
const hi = hasData && matches.length ? seasonHighlights(R) : null;
const palmares = getParaPalmares();
const cnt = hasData ? { players: players.length, tourns: R.tournaments.length, matches: matches.length } : null;

// Vidéo à la une : la dernière vidéo Para-billard FAUTEUIL de cette saison (hors malvoyants).
const d = getDiscipline('billard');
const seasonVideoKey = season.slug.replace('-', '/');
const vids = (await getReplays({ discipline: 'billard' })).filter((v) => v.season === seasonVideoKey && v.category === 'Para-billard' && !/malvoyant/i.test(v.title));
const featured = vids[0];

const fmtShort = (iso: string) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short' }).format(new Date(iso));
const evDate = (s: string) => (/^\d{4}-\d{2}-\d{2}$/.test(s) ? fmtShort(s) : s);
---
<Base title={`Para-billard fauteuil — Blackball Para-billard fauteuil ${season.label}`} description={`L'univers Para-billard fauteuil de LSEI : classement, joueurs et statistiques, saison ${season.label}.`} active="disciplines">
  <HubNav season={season.slug} dataSeason={hasData ? season.slug : PARA_DEFAULT_SEASON} active="accueil" root="/para-billard" brand="Para-billard" sub="· Fauteuil" joueursLabel="Joueurs" videosHref="/disciplines/billard/categorie/para-billard" />
  <div class="sz">
  <SeasonHero season={season} title="Para-billard fauteuil" crumb={[{ label: 'Para fauteuil' }]}
    desc={`Le circuit national de para-billard fauteuil de la FFB : ${nCal} rendez-vous. Classement, joueurs, fiches carrière et confrontations de la saison.`}
    pickerRoot="/para-billard" pickerSeasons={getParaSeasons()} rankedLabel="joueurs classés" feminine={false}
    nRanked={players.length} nMatches={matches.length} spot={spot} spotPhoto={spotPhoto} spotResults={spotResults} spotHref={spot ? `/para-billard/joueur/${slugOf(spot.id)}` : undefined} />

  <section class="section hub-top" style="--dc:var(--c-billard)">
    <div class="wrap hub-hero">
      <div class="hub-lead">
        {featured ? (
          <>
            <VideoPlayer id={featured.id} from={d.from} to={d.to} caption={featured.caption} title={featured.title} image={featured.thumb} />
            <div class="hub-kick">À la une · Dernière vidéo</div>
            <h2 class="hub-h1">{featured.title}</h2>
          </>
        ) : hasData ? (
          <>
            <div class="hub-kick">Blackball Para-billard fauteuil · {season.label}</div>
            <h2 class="hub-h1">Le circuit national Para-billard fauteuil</h2>
            <p class="dek" style="margin-top:8px">{cnt!.players} joueurs classés, {cnt!.tourns} étapes, {cnt!.matches} matchs. Le para-billard fauteuil de la Fédération Française de Billard : classement, fiches carrière et confrontations.</p>
          </>
        ) : (
          <>
            <div class="hub-kick">Blackball Para-billard fauteuil · {season.label}</div>
            <h2 class="hub-h1">Saison à venir</h2>
            <p class="dek" style="margin-top:8px">La saison {season.label} démarre bientôt. Voici le calendrier officiel — classement, joueurs et statistiques s'afficheront au fil des étapes.</p>
          </>
        )}

        <div class="parcours parcours-box">
          <div class="parcours-h"><span>Le calendrier</span> {calSeason.label} · {calSeason.calendar.length} rendez-vous</div>
          <div class="parcours-grid">
            {calSeason.calendar.map((e, i) => {
              const st = nextIdx < 0 || i < nextIdx ? ' is-past' : i === nextIdx ? ' is-next' : '';
              const etTour = hasData ? (R.tournaments as any[]).find((t: any) => t.level === e.short || (e.kind === 'france' && t.kind === 'france')) : null;
              const pod = etTour ? tournamentPodiumById(R, etTour.id) : [];
              const row = (
                <>
                  <span class="et-num">{e.short}{i === nextIdx && <em class="et-jx">{nextJx}</em>}</span>
                  <span class="et-city">{e.place}</span>
                  <span class="et-date">{evDate(e.date)}</span>
                  {e.winner && <span class="et-winner">{e.winner.name}</span>}
                </>
              );
              if (pod.length > 0) {
                return (
                  <div class={`etape k-${e.kind}${st} etape--acc`} title={e.name}>
                    <button type="button" class="et-row" data-accordion aria-expanded="false">
                      {row}
                      <span class="et-chev car-schev" aria-hidden="true">▾</span>
                    </button>
                    <div class="et-pod" hidden>
                      <div class="et-pod-grid">
                        {pod.map(({ player: p, place }) => {
                          const ph = photoOf(p, season.slug);
                          return (
                            <a href={`/para-billard/joueur/${slugOf(p.id)}`} class={`et-pod-card r${place}`}>
                              <span class="et-pod-ph"><span class="bavatar">{p.name.slice(0, 1)}</span>{ph && <img src={ph} alt={p.name} loading="lazy" onerror="this.remove()" />}<span class="et-pod-rk">{place}</span></span>
                              <span class="et-pod-lab">{place === 1 ? 'Vainqueur' : place === 2 ? 'Finaliste' : 'Demi-finaliste'}</span>
                              <span class="et-pod-name">{p.name}</span>
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                );
              }
              return <div class={`etape k-${e.kind}${st}`} title={e.name}>{row}</div>;
            })}
          </div>
        </div>
      </div>

      <aside class="hub-side">
        <div class="hub-card hub-search">
          <div class="hub-card-h"><span>Rechercher un joueur</span></div>
          <PlayerSearch placeholder="Nom d'un joueur…" seasons={getParaSeasons()} hrefBase="/para-billard/joueur/" />
        </div>

        {hasData ? (
        <Fragment>
        <div class="hub-card">
          <div class="hub-card-h"><span>Classement · Top 5</span><a href={`${base}/classement`}>Tout →</a></div>
          {top5.map((p) => {
            const src = photoOf(p, season.slug);
            return (
              <a href={`/para-billard/joueur/${slugOf(p.id)}`} class="pod-row">
                <span class="pod-rank">{p.rank}</span>
                <span class="bphoto pod-ph"><span class="bavatar">{p.name.slice(0, 1)}</span>{src && <img src={src} alt="" onerror="this.remove()" />}</span>
                <span class="pod-name">{p.name}</span>
                <span class="pod-pts">{p.points}<small>pts</small></span>
              </a>
            );
          })}
          <a href={`${base}/comparateur`} class="hub-card-cta">Comparer deux joueurs</a>
        </div>

        <div class="hub-card">
          <div class="hub-card-h"><span>Derniers résultats</span><a href={`${base}/classement`}>Classement →</a></div>
          <div class="hub-results">
            {recent.map((m) => {
              const t = tourById(m.tid);
              const aWin = m.sA > m.sB;
              return (
                <div class="hr-row">
                  <a href={`/para-billard/joueur/${slugOf(m.aId)}`} class={`hr-p ${aWin ? 'w' : ''}`}>{m.aName}</a>
                  <span class="hr-sc mono">{m.sA}<i>—</i>{m.sB}</span>
                  <a href={`/para-billard/joueur/${slugOf(m.bId)}`} class={`hr-p r ${!aWin ? 'w' : ''}`}>{m.bName}</a>
                  <span class="hr-meta">{t?.level} · {evDate(m.date)}</span>
                </div>
              );
            })}
          </div>
        </div>
        </Fragment>
        ) : (
        <div class="hub-card">
          <div class="hub-card-h"><span>Classement · Joueurs · Résultats</span></div>
          <p class="dek" style="margin:6px 0 0">Ils s'afficheront ici au fil de la saison {season.label}, dès les premières étapes disputées.</p>
        </div>
        )}

        <AffichesTournois calendar={calSeason.calendar} seasonSlug={calSeason.slug} seasonStatus={season.status} />
      </aside>
    </div>
  </section>

  {hi && (
    <section class="section sz-facts-sec">
      <div class="wrap">
        <div class="sec-head"><div><div class="eyebrow" style="color:var(--c-billard)">En chiffres</div><h2>Les <em>faits marquants</em> de la saison</h2></div></div>
        <div class="facts">
          <div class="fact">
            <div class="fact-lab">Plus large victoire</div>
            <div class="fact-val">{hi.biggest.sw}–{hi.biggest.sl}</div>
            <div class="fact-sub"><a href={`/para-billard/joueur/${slugOf(hi.biggest.winId)}`}>{hi.biggest.winName}</a> contre {hi.biggest.loseName}</div>
          </div>
          <div class="fact">
            <div class="fact-lab">Plus longue série</div>
            <div class="fact-val">{hi.streak.n} victoires</div>
            <div class="fact-sub">d'affilée · <a href={`/para-billard/joueur/${slugOf(hi.streak.id)}`}>{hi.streak.name}</a></div>
          </div>
          <div class="fact">
            <div class="fact-lab">Plus de victoires</div>
            <div class="fact-val">{hi.topWins.wins} matchs</div>
            <div class="fact-sub">gagnés · <a href={`/para-billard/joueur/${slugOf(hi.topWins.id)}`}>{hi.topWins.name}</a></div>
          </div>
          <div class="fact">
            <div class="fact-lab">Meilleur pourcentage</div>
            <div class="fact-val">{hi.bestPct.winPct}%</div>
            <div class="fact-sub">de victoires · <a href={`/para-billard/joueur/${slugOf(hi.bestPct.id)}`}>{hi.bestPct.name}</a></div>
          </div>
          <div class="fact">
            <div class="fact-lab">Le plus actif</div>
            <div class="fact-val">{hi.mostActive.played} matchs</div>
            <div class="fact-sub">disputés · <a href={`/para-billard/joueur/${slugOf(hi.mostActive.id)}`}>{hi.mostActive.name}</a></div>
          </div>
          <div class="fact">
            <div class="fact-lab">Le saviez-vous</div>
            <div class="fact-val">{hi.totalManches} manches</div>
            <div class="fact-sub">jouées en {hi.totalMatches} matchs cette saison</div>
          </div>
        </div>
        <p class="fact-totals">Bilan de la saison : <b>{hi.tournCount}</b> étapes · <b>{hi.playerCount}</b> joueurs · <b>{hi.totalMatches}</b> matchs disputés.</p>
      </div>
    </section>
  )}

  {palmares.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="sec-head"><div><div class="eyebrow" style="color:var(--c-billard)">Histoire</div><h2>Le <em>palmarès</em> du Para-billard fauteuil</h2></div></div>
        <div class="palmares">
          {palmares.map((p) => {
            const champPhoto = photoOf(p.champ as any, (p as any).slug);
            const cdfPhoto = p.cdf ? photoOf(p.cdf as any, (p as any).slug) : null;
            return (
            <div class="palm-row">
              <div class="palm-season">{p.label}</div>
              <a href={`/para-billard/joueur/${slugOf(p.champ.id)}`} class="palm-card palm-champ">
                <span class="palm-ph"><span class="bavatar">{p.champ.name.slice(0, 1)}</span>{champPhoto && <img src={champPhoto} alt={p.champ.name} loading="lazy" onerror="this.remove()" />}</span>
                <span class="palm-body">
                  <span class="palm-lab">Champion de saison</span>
                  <span class="palm-name">{p.champ.name}</span>
                  <span class="palm-sub">{p.champ.points} pts</span>
                </span>
              </a>
              {p.cdf ? (
                <a href={`/para-billard/joueur/${slugOf(p.cdf.id)}`} class="palm-card palm-cdf">
                  <span class="palm-ph"><span class="bavatar">{p.cdf.name.slice(0, 1)}</span>{cdfPhoto && <img src={cdfPhoto} alt={p.cdf.name} loading="lazy" onerror="this.remove()" />}</span>
                  <span class="palm-body">
                    <span class="palm-lab">Champion de France</span>
                    <span class="palm-name">{p.cdf.name}</span>
                  </span>
                </a>
              ) : (
                <div class="palm-card palm-cdf palm-empty">
                  <span class="palm-body">
                    <span class="palm-lab">Champion de France</span>
                    <span class="palm-name">—</span>
                  </span>
                </div>
              )}
            </div>
            );
          })}
        </div>
      </div>
    </section>
  )}
  </div>
</Base>

<style>
  /* ===== Calendrier = agenda vertical ; chaque étape jouée se déplie sur son podium ===== */
  .parcours-grid { display: flex; flex-direction: column; gap: 8px; }
  .etape { position: relative; display: flex; flex-direction: column; border: 1px solid var(--line); border-left: 4px solid var(--c-billard);
    border-radius: 8px; background: var(--surface); padding: 0; transition: border-color .15s, box-shadow .15s; }
  .etape.k-mondial { border-left-color: #C79A1E; } .etape.k-coupe { border-left-color: var(--c-subbuteo); } .etape.k-france { border-left-color: var(--live); }
  .etape:not(.etape--acc) { flex-direction: row; align-items: center; gap: 14px; padding: 11px 16px; }
  .etape--acc > .et-row { display: flex; align-items: center; gap: 14px; width: 100%; padding: 11px 16px; background: none; border: 0; font: inherit; color: inherit; text-align: left; cursor: pointer; }
  .etape .et-num { flex: none; display: inline-flex; align-items: center; font-family: var(--display); font-weight: 700; font-size: 13px; letter-spacing: .03em;
    color: #fff; background: var(--c-billard); padding: 2px 11px; border-radius: 6px; }
  .etape.k-mondial .et-num { background: #C79A1E; color: #3a2a05; } .etape.k-coupe .et-num { background: var(--c-subbuteo); } .etape.k-france .et-num { background: var(--live); }
  .et-jx { font-style: normal; margin-left: 7px; font-size: 10px; font-weight: 800; color: var(--c-billard); background: #fff; padding: 1px 7px; border-radius: 100px; }
  .et-city { flex: 1; min-width: 0; margin: 0; font-size: 14px; font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .et-date { flex: none; min-width: 112px; margin: 0; text-align: right; font-size: 11.5px; color: var(--ink-faint); font-family: var(--mono); }
  .et-winner { flex: none; margin: 0; padding: 0; border: 0; font-size: 11.5px; font-weight: 700; color: #C79A1E; white-space: nowrap; }
  .et-chev { flex: none; color: var(--ink-faint); font-size: 12px; }
  .etape.is-next { border-color: var(--c-billard); box-shadow: inset 0 0 0 1px var(--c-billard); background: color-mix(in srgb, var(--c-billard) 6%, var(--surface)); }
  .etape.etape--acc:hover { border-color: color-mix(in srgb, var(--c-billard) 50%, var(--line)); box-shadow: 0 4px 14px color-mix(in srgb, var(--c-billard) 12%, transparent); }
  .etape--acc > .et-row:hover .et-city, .etape--acc > .et-row[aria-expanded="true"] .et-city { color: var(--c-billard); }
  .etape--acc > .et-row[aria-expanded="true"] .et-chev { color: var(--c-billard); }
  .et-pod { padding: 2px 16px 16px; border-top: 1px dashed var(--line); }
  .et-pod-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 14px; }
  .et-pod-card { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 3px; padding: 13px 6px 11px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); text-decoration: none; transition: border-color .15s, transform .15s; }
  .et-pod-card:hover { transform: translateY(-3px); border-color: var(--c-billard); }
  .et-pod-card.r1 { border-color: color-mix(in srgb, #E8B008 55%, var(--line)); background: color-mix(in srgb, #E8B008 8%, var(--surface)); }
  .et-pod-ph { position: relative; width: 52px; height: 52px; border-radius: 50%; overflow: hidden; background: var(--surface-2); border: 2px solid var(--line); display: grid; place-items: center; }
  .et-pod-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .et-pod-card.r1 .et-pod-ph { border-color: #E8B008; }
  .et-pod-ph .bavatar { font-family: var(--display); font-weight: 800; font-size: 18px; color: var(--ink-faint); }
  .et-pod-rk { position: absolute; right: -2px; bottom: -2px; width: 19px; height: 19px; display: grid; place-items: center; border-radius: 50%; font-size: 10.5px; font-weight: 800; color: #fff; background: var(--c-billard); border: 2px solid var(--surface); }
  .et-pod-card.r1 .et-pod-rk { background: #E8B008; }
  .et-pod-lab { font-size: 10px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase; color: var(--c-billard); }
  .et-pod-card.r1 .et-pod-lab { color: #b08400; }
  .et-pod-name { font-size: 12px; font-weight: 700; color: var(--ink); line-height: 1.15; }
  @media (max-width: 560px) { .et-pod-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .et-date { min-width: 0; } }

  /* palmarès : photo du champion sur la carte */
  .palm-card { flex-direction: row; align-items: center; gap: 12px; }
  .palm-ph { position: relative; width: 46px; height: 46px; border-radius: 50%; overflow: hidden; background: var(--surface-2); border: 2px solid var(--line); display: grid; place-items: center; flex: none; }
  .palm-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .palm-ph .bavatar { font-family: var(--display); font-weight: 800; font-size: 17px; color: var(--ink-faint); }
  .palm-champ .palm-ph { border-color: color-mix(in srgb, #E8B008 55%, var(--line)); }
  .palm-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
</style>
