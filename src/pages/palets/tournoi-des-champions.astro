---
// TOURNOI DES CHAMPIONS (palets) — page annuelle : palmarès + une édition à la fois
// (onglets, sans changement de page). Données : src/data/palets/tournoi-champions.ts.
import Base from '../../layouts/Base.astro';
import { getDiscipline } from '../../data/site';
import { editions, players, playerName, careerOf, QUALIFIED, ORGANIZER, type TdcEdition, type TdcMatch } from '../../data/palets/tournoi-champions';
import { assetExists } from '../../lib/publicAssets';

const d = getDiscipline('palets');
// Éditions JOUÉES (avec résultats) vs à venir. Le héros/palmarès portent sur la
// dernière jouée ; l'édition à venir s'affiche en « prochain rendez-vous ».
const played = editions.filter((e) => e.final);
const latest = played[0] ?? editions[0];
const allIds = new Set(editions.flatMap((e) => e.pool.map((r) => r.id)));
const champions = new Set(played.map((e) => e.final!.win));

const photo = (id: string) => {
  const p = `/tournoi-des-champions/joueurs/${id}.webp`;
  return assetExists(p) ? p : null;
};
const initials = (id: string) => { const p = players[id]; return p ? `${p.first[0]}${p.last[0]}` : '?'; };
const club = (id: string) => players[id]?.club ?? 'Sans club';
const fmtDate = (iso: string) => new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso + 'T12:00:00Z'));
const signed = (n: number) => (n > 0 ? `+${n}` : `${n}`);

// Parcours d'un joueur dans une édition → badge + ordre d'affichage.
function stageOf(e: TdcEdition, id: string) {
  if (e.final.win === id) return { label: 'Champion', cls: 'gold', rank: 0 };
  if (e.final.lose === id) return { label: 'Finaliste', cls: 'silver', rank: 1 };
  if (e.semis.some((m) => m.lose === id)) return { label: 'Demi-finale', cls: 'semi', rank: 2 };
  if (e.quarters.some((m) => m.lose === id)) return { label: 'Quart de finale', cls: 'qf', rank: 3 };
  return { label: 'Phase de poule', cls: 'pool', rank: 4 };
}
const poolPos = (e: TdcEdition, id: string) => e.pool.findIndex((r) => r.id === id) + 1;
const roster = (e: TdcEdition) =>
  e.pool.map((r) => ({ id: r.id, stage: stageOf(e, r.id), pos: poolPos(e, r.id) }))
    .sort((a, b) => a.stage.rank - b.stage.rank || a.pos - b.pos);
const rounds = (e: TdcEdition): { name: string; games: TdcMatch[] }[] => [
  { name: 'Quarts de finale', games: e.quarters },
  { name: 'Demi-finales', games: e.semis },
  { name: 'Finale', games: [e.final] },
];
---
<Base
  title="Tournoi des Champions — Palets"
  description={`Le Tournoi des Champions de palets, chaque année en janvier : palmarès, tableau final, classement de poule et joueurs. Édition ${latest.year} remportée par ${playerName(latest.final.win)}.`}
  active="disciplines"
  image={latest.video ? `https://i.ytimg.com/vi/${latest.video}/maxresdefault.jpg` : undefined}
>
  <section class="tdc-hero" style={`--dc:${d.colorVar}`}>
    <div class="wrap tdc-hero-in">
      <div>
        <div class="tdc-crumb"><a href="/disciplines/palets">Palets</a><span aria-hidden="true">›</span>Tournoi des Champions</div>
        <h1 class="tdc-h">Tournoi<small>des</small><span>Champions</span></h1>
        <p class="tdc-p">Chaque début janvier, 16 joueurs se retrouvent pour une journée de palet : 3 parties de poule, les 8 meilleurs en quarts de finale, puis une finale en 15 points.</p>
        <div class="tdc-kpis">
          <div><b>{played.length}</b><span>édition{played.length > 1 ? 's' : ''}</span></div>
          <div><b>{allIds.size}</b><span>joueurs</span></div>
          <div><b>{champions.size}</b><span>champion{champions.size > 1 ? 's' : ''}</span></div>
        </div>
        {assetExists(ORGANIZER.logo) && (
          <a class="tdc-org" href={ORGANIZER.url} target="_blank" rel="noopener">
            <span class="tdc-org-logo"><img src={ORGANIZER.logo} alt={ORGANIZER.name} /></span>
            <span><small>Organisé par</small><b>{ORGANIZER.name}</b></span>
          </a>
        )}
      </div>
      <a class="tdc-champ" href={`#edition-${latest.year}`} data-tdc-go={latest.year}>
        <span class="tdc-champ-img">
          {photo(latest.final.win) ? <img src={photo(latest.final.win)} alt={playerName(latest.final.win)} loading="eager" /> : <span class="tdc-ini">{initials(latest.final.win)}</span>}
        </span>
        <span class="tdc-champ-body">
          <span class="tdc-champ-k">🏆 Champion {latest.year}</span>
          <span class="tdc-champ-n">{playerName(latest.final.win)}</span>
          <span class="tdc-champ-s">{club(latest.final.win)} · bat {playerName(latest.final.lose)} {latest.final.sw}-{latest.final.sl} en finale</span>
        </span>
      </a>
    </div>
  </section>

  <section class="section tdc-body" style={`--dc:${d.colorVar}`}>
    <div class="wrap">
      <div class="sec-head"><div><div class="eyebrow">Toutes les éditions</div><h2>Palmarès</h2></div></div>
      <div class="tdc-palm">
        {editions.map((e) => (
          e.upcoming || !e.final ? (
            <a class="tdc-palm-card is-soon" href={`#edition-${e.year}`} data-tdc-go={e.year} style={`--dc:${e.color}`}>
              <span class="tdc-palm-y">{e.year}</span>
              <span class="tdc-palm-soon"><span class="tdc-palm-soon-k">Prochaine édition</span><b>{fmtDate(e.date)}</b></span>
              <span class="tdc-palm-f">Affiche dévoilée · résultats à venir</span>
            </a>
          ) : (
            <a class="tdc-palm-card" href={`#edition-${e.year}`} data-tdc-go={e.year} style={`--dc:${e.color}`}>
              <span class="tdc-palm-y">{e.year}</span>
              <span class="tdc-palm-who">
                <span class="tdc-av">{photo(e.final.win) ? <img src={photo(e.final.win)} alt="" loading="lazy" /> : initials(e.final.win)}</span>
                <span><b>{playerName(e.final.win)}</b><small>{club(e.final.win)}</small></span>
              </span>
              <span class="tdc-palm-f">Finale {e.final.sw}-{e.final.sl} contre {playerName(e.final.lose)}</span>
            </a>
          )
        ))}
      </div>

      <div class="tdc-tabs" role="tablist" aria-label="Choisir une édition">
        {editions.map((e, i) => (
          <a role="tab" href={`#edition-${e.year}`} data-tdc-go={e.year} aria-selected={i === 0 ? 'true' : 'false'} style={`--dc:${e.color}`}>Édition {e.year}</a>
        ))}
      </div>

      {editions.map((e, i) => (
        <article class="tdc-ed" id={`edition-${e.year}`} data-tdc-ed={e.year} hidden={i !== 0} style={`--dc:${e.color}`}>
          <header class="tdc-ed-head">
            <div>
              <div class="eyebrow">Édition {e.year}</div>
              <h2 class="tdc-ed-t">{fmtDate(e.date)}</h2>
            </div>
            {e.video && (
              <a class="tdc-replay" href={`/replay/${e.video}/`}>
                <img src={`https://i.ytimg.com/vi/${e.video}/mqdefault.jpg`} alt="" loading="lazy" />
                <span><b>Revoir le direct</b><small>Le tournoi en vidéo sur LSEI</small></span>
              </a>
            )}
          </header>

          {e.upcoming || !e.final ? (
          <div class="tdc-soon">
            <figure class="tdc-soon-aff">
              {e.affiche
                ? <img src={e.affiche} alt={`Affiche du Tournoi des Champions ${e.year}`} loading="lazy" />
                : <div class="tdc-soon-aff-ph">Affiche à venir</div>}
            </figure>
            <div class="tdc-soon-body">
              <span class="tdc-soon-tag">Prochain rendez-vous</span>
              <div class="tdc-soon-count" data-tdc-count={e.date}><b data-tdc-days>J-—</b><span>avant le coup d'envoi</span></div>
              <p class="tdc-soon-p">16 champions, 3 parties de poule, les {QUALIFIED} meilleurs en quarts de finale, puis la finale en 15 points. Le tableau final, le classement de poule et les 16 joueurs s'afficheront ici une fois le tournoi disputé.</p>
              {assetExists(ORGANIZER.logo) && (
                <a class="tdc-soon-org" href={ORGANIZER.url} target="_blank" rel="noopener">
                  <span class="tdc-soon-org-logo"><img src={ORGANIZER.logo} alt={ORGANIZER.name} /></span>
                  <span><small>Organisé par</small><b>{ORGANIZER.name}</b></span>
                </a>
              )}
            </div>
          </div>
          ) : (<>
          <h3 class="tdc-h3">Tableau final</h3>
          <div class="tdc-bracket">
            {rounds(e).map((r) => (
              <div class="tdc-round">
                <div class="tdc-round-n">{r.name}</div>
                <div class="tdc-round-g">
                  {r.games.map((m) => (
                    <div class={`tdc-m${r.name === 'Finale' ? ' is-final' : ''}`}>
                      <div class="tdc-m-row win"><span>{playerName(m.win)}</span><b>{m.sw}</b></div>
                      <div class="tdc-m-row"><span>{playerName(m.lose)}</span><b>{m.sl}</b></div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <div class={`tdc-grid2${e.photo && assetExists(e.photo.src) ? '' : ' is-solo'}`}>
            <div>
              <h3 class="tdc-h3">Phase de poule <small>3 parties · les {QUALIFIED} premiers qualifiés</small></h3>
              <div class="tdc-table-wrap">
                <table class="tdc-table">
                  <thead><tr><th>#</th><th>Joueur</th><th>V.</th><th>Goal av.</th></tr></thead>
                  <tbody>
                    {e.pool.map((r, k) => (
                      <tr class={k < QUALIFIED ? 'q' : ''}>
                        <td>{k + 1}</td>
                        <td><b>{playerName(r.id)}</b><small>{club(r.id)}</small></td>
                        <td>{r.w}</td>
                        <td>{signed(r.ga)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
            {e.photo && assetExists(e.photo.src) && (
              <figure class="tdc-group">
                <img src={e.photo.src} alt={e.photo.caption} loading="lazy" />
                <figcaption>{e.photo.caption}</figcaption>
              </figure>
            )}
          </div>

          <h3 class="tdc-h3">Les 16 joueurs</h3>
          <div class="tdc-players">
            {roster(e).map(({ id, stage }) => {
              const c = careerOf(id);
              const img = photo(id);
              return (
                <div class={`tdc-pl s-${stage.cls}`}>
                  <div class="tdc-pl-img">{img ? <img src={img} alt={playerName(id)} loading="lazy" /> : <span class="tdc-ini">{initials(id)}</span>}</div>
                  <div class="tdc-pl-body">
                    <span class="tdc-badge">{stage.label}</span>
                    <b>{players[id]?.first} <span>{players[id]?.last}</span></b>
                    <small>{club(id)}</small>
                    {c.played > 1 && <small class="tdc-pl-c">{c.played} participations{c.titles > 0 ? ` · ${c.titles} titre${c.titles > 1 ? 's' : ''}` : ''}</small>}
                  </div>
                </div>
              );
            })}
          </div>
          </>)}
        </article>
      ))}
    </div>
  </section>
</Base>

<script>
  // Onglets d'édition : une seule édition visible, synchronisée avec le #hash.
  const eds = [...document.querySelectorAll<HTMLElement>('[data-tdc-ed]')];
  const tabs = [...document.querySelectorAll<HTMLElement>('.tdc-tabs [data-tdc-go]')];
  function show(year: string | undefined, scroll: boolean) {
    const target = eds.find((el) => el.dataset.tdcEd === year) ?? eds[0];
    if (!target) return;
    eds.forEach((el) => (el.hidden = el !== target));
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tdcGo === target.dataset.tdcEd)));
    if (scroll) document.querySelector('.tdc-tabs')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  document.querySelectorAll<HTMLElement>('[data-tdc-go]').forEach((a) =>
    a.addEventListener('click', (ev) => {
      ev.preventDefault();
      history.replaceState(null, '', `#edition-${a.dataset.tdcGo}`);
      show(a.dataset.tdcGo, true);
    }),
  );
  const fromHash = () => location.hash.match(/^#edition-(\d{4})$/)?.[1];
  if (fromHash()) show(fromHash(), true);
  addEventListener('hashchange', () => fromHash() && show(fromHash(), true));

  // Compte à rebours de la/les édition(s) à venir (toujours juste, calculé au chargement).
  document.querySelectorAll<HTMLElement>('[data-tdc-count]').forEach((el) => {
    const iso = el.dataset.tdcCount;
    const b = el.querySelector('[data-tdc-days]');
    if (!iso || !b) return;
    const target = new Date(iso + 'T00:00:00').getTime();
    const now = new Date(); now.setHours(0, 0, 0, 0);
    const days = Math.round((target - now.getTime()) / 86400000);
    b.textContent = days > 1 ? `J-${days}` : days === 1 ? 'Demain' : days === 0 ? "Aujourd'hui" : 'Bientôt les résultats';
    const unit = el.querySelector('span');
    if (unit && days <= 0) unit.textContent = days === 0 ? 'le tournoi a lieu' : 'tournoi disputé';
  });
</script>

<style is:global>
  .tdc-hero { position: relative; overflow: hidden; color: #fff;
    background: radial-gradient(70% 140% at 85% 0%, color-mix(in srgb, var(--dc) 42%, #0A0E1A) 0%, #0A0E1A 64%), #0A0E1A; }
  .tdc-hero::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--dc); }
  .tdc-hero-in { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 44px; align-items: center; padding-top: 50px; padding-bottom: 50px; }
  .tdc-crumb { display: flex; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55); }
  .tdc-crumb a { color: var(--dc); text-decoration: none; }
  .tdc-h { font-family: var(--display); font-weight: 800; text-transform: uppercase; letter-spacing: -.01em; font-size: clamp(44px, 7vw, 92px); line-height: .9; margin: 18px 0 0; color: #fff; }
  .tdc-h small { font-size: .28em; letter-spacing: .08em; color: var(--dc); margin-left: .3em; vertical-align: top; }
  .tdc-h span { display: block; color: var(--dc); }
  .tdc-p { color: rgba(255,255,255,.8); font-size: 16px; line-height: 1.55; margin: 18px 0 0; max-width: 54ch; }
  .tdc-kpis { display: flex; flex-wrap: wrap; gap: 12px 34px; margin-top: 24px; }
  .tdc-kpis div { display: flex; flex-direction: column; }
  .tdc-kpis b { font-family: var(--display); font-weight: 800; font-size: 34px; line-height: 1; }
  .tdc-kpis span { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55); margin-top: 4px; }

  .tdc-org { display: inline-flex; align-items: center; gap: 14px; margin-top: 26px; text-decoration: none; color: #fff; }
  .tdc-org-logo { width: 96px; height: 70px; border-radius: 10px; background: #fff; display: grid; place-items: center; padding: 7px; flex: none; transition: transform .2s; }
  .tdc-org:hover .tdc-org-logo { transform: translateY(-2px); }
  .tdc-org-logo img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
  .tdc-org small { display: block; font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55); }
  .tdc-org b { font-size: 17px; }
  .tdc-champ { display: grid; grid-template-columns: 150px 1fr; border-radius: 16px; overflow: hidden; text-decoration: none; color: #fff;
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); box-shadow: 0 26px 56px -24px rgba(0,0,0,.85); transition: transform .3s, border-color .2s; }
  .tdc-champ:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--dc) 70%, transparent); }
  .tdc-champ-img { min-height: 188px; background: color-mix(in srgb, var(--dc) 30%, #0A0E1A); display: grid; place-items: center; }
  .tdc-champ-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tdc-champ-body { display: flex; flex-direction: column; justify-content: center; gap: 8px; padding: 18px 20px; border-left: 3px solid var(--dc); }
  .tdc-champ-k { align-self: flex-start; font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; background: var(--dc); color: #1b1404; padding: 3px 9px; border-radius: 4px; }
  .tdc-champ-n { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 28px; line-height: 1; }
  .tdc-champ-s { font-size: 14px; color: rgba(255,255,255,.75); line-height: 1.4; }
  .tdc-ini { font-family: var(--display); font-weight: 800; font-size: 40px; color: #fff; opacity: .85; }

  .tdc-body { background-image: radial-gradient(rgba(20, 30, 50, .055) 1px, transparent 1.4px); background-size: 22px 22px; }
  .tdc-palm { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .tdc-palm-card { display: flex; flex-direction: column; gap: 12px; padding: 16px 18px; background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--dc);
    border-radius: 10px; color: var(--ink); text-decoration: none; box-shadow: var(--shadow); transition: transform .2s; }
  .tdc-palm-card { background: color-mix(in srgb, var(--dc) 7%, var(--surface)); border-color: color-mix(in srgb, var(--dc) 28%, var(--line)); border-top-color: var(--dc); }
  .tdc-palm-card:hover { transform: translateY(-3px); border-color: var(--dc); }
  .tdc-palm-y { font-family: var(--display); font-weight: 800; font-size: 30px; line-height: 1; color: var(--dc); }
  .tdc-palm-who { display: flex; align-items: center; gap: 12px; }
  .tdc-palm-who b { display: block; font-size: 16px; }
  .tdc-palm-who small { color: var(--ink-soft); font-size: 13px; }
  .tdc-av { width: 46px; height: 46px; border-radius: 50%; overflow: hidden; flex: none; display: grid; place-items: center; background: var(--dc); color: #fff; font-weight: 800; }
  .tdc-av img { width: 100%; height: 100%; object-fit: cover; }
  .tdc-palm-f { font-size: 13px; color: var(--ink-soft); }

  .tdc-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 40px 0 0; padding-top: 8px; border-bottom: 2px solid var(--line); scroll-margin-top: 90px; }
  .tdc-tabs a { padding: 10px 18px; font-weight: 800; font-size: 14px; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-soft); text-decoration: none;
    border-bottom: 3px solid transparent; margin-bottom: -2px; }
  .tdc-tabs a[aria-selected="true"] { color: var(--dc); border-bottom-color: var(--dc); }
  .tdc-ed { padding-top: 26px; }
  .tdc-ed-head { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .tdc-ed .eyebrow { color: var(--dc); }
  .tdc-ed-t { margin: 4px 0 0; font-size: 24px; font-weight: 800; }
  .tdc-ed-t::first-letter { text-transform: uppercase; }
  .tdc-replay { display: flex; align-items: center; gap: 12px; padding: 6px 16px 6px 6px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; color: var(--ink); text-decoration: none; }
  .tdc-replay:hover { border-color: var(--dc); }
  .tdc-replay img { width: 112px; aspect-ratio: 16/9; object-fit: cover; border-radius: 6px; display: block; }
  .tdc-replay b { display: block; font-size: 14px; }
  .tdc-replay small { color: var(--ink-soft); font-size: 12px; }
  .tdc-h3 { font-size: 13px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; margin: 34px 0 14px; color: var(--ink); }
  .tdc-h3 small { font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--ink-faint); margin-left: 8px; font-size: 13px; }

  .tdc-bracket { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .tdc-round-n { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 10px; }
  .tdc-round-g { display: flex; flex-direction: column; justify-content: space-around; gap: 12px; height: calc(100% - 26px); }
  .tdc-m { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .tdc-m.is-final { border: 2px solid var(--dc); }
  .tdc-m-row { display: flex; justify-content: space-between; gap: 10px; padding: 9px 12px; font-size: 14px; color: var(--ink-soft); }
  .tdc-m-row + .tdc-m-row { border-top: 1px solid var(--line); }
  .tdc-m-row b { font-family: var(--display); font-size: 16px; }
  .tdc-m-row.win { color: var(--ink); font-weight: 700; background: color-mix(in srgb, var(--dc) 12%, transparent); }
  .tdc-m-row.win b { color: color-mix(in srgb, var(--dc) 75%, var(--ink)); }

  .tdc-grid2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .tdc-grid2.is-solo { grid-template-columns: minmax(0, 720px); }
  .tdc-table-wrap { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .tdc-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .tdc-table th { text-align: left; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); padding: 10px 12px; border-bottom: 1px solid var(--line); }
  .tdc-table td { padding: 8px 12px; border-bottom: 1px solid var(--line); color: var(--ink); }
  .tdc-table th:nth-child(n+3), .tdc-table td:nth-child(n+3) { text-align: right; font-variant-numeric: tabular-nums; }
