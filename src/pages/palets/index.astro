---
// /palets/ → redirige vers la page de la discipline Palets. Donne une vraie page à
// l'URL /palets/ (le dossier contient /palets/tournoi-des-champions/ mais pas d'accueil
// → sinon Apache afficherait « Index of /palets »).
const target = '/disciplines/palets';
---
<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <script is:inline set:html={`location.replace(${JSON.stringify(target)})`}></script>
    <style>html,body{margin:0;min-height:100vh;background:#0C0E13}</style>
    <title>LSEI — Le Sport en Image</title>
  </head>
  <body></body>
</html>
