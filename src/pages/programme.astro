---
import Base from '../layouts/Base.astro';
import Thumb from '../components/Thumb.astro';
import { disciplines, getDiscipline } from '../data/site';
import { getBroadcasts } from '../lib/youtube';
import { parseProgTitle } from '../lib/programmeTitle';
import { getCollection } from 'astro:content';

const now = Date.now();
const TZ = 'Europe/Paris';

// 1) Programme saisi manuellement via /admin.
const manual = (await getCollection('programme', ({ data }) => !data.draft)).map((p) => ({
  sport: p.data.sport,
  category: p.data.category || '',
  title: p.data.title || '',
  date: p.data.date,
  thumb: p.data.image,
  link: p.data.link,
  live: false,
}));

// 2) Directs YouTube détectés automatiquement (en cours + programmés).
const auto = (await getBroadcasts()).map((b) => ({
  sport: b.discipline,
  category: '',
  title: b.title,
  date: new Date(b.date),
  thumb: `https://i.ytimg.com/vi/${b.id}/hqdefault.jpg`,
  link: `https://www.youtube.com/watch?v=${b.id}`,
  live: b.live,
}));

// Fusion : on garde ce qui est en cours ou à venir (une diffusion reste listée jusqu'à ~3 h après le début).
let items = [...manual, ...auto].filter((it) => it.live || it.date.valueOf() + 3 * 3600 * 1000 >= now);
items.sort((a, b) => a.date.valueOf() - b.date.valueOf());

// Groupement par jour (heure de Paris).
const fmtDay = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: TZ });
const fmtTime = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: TZ });
const dayKeyFmt = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: TZ });
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const heure = (d: Date) => fmtTime.format(d).replace(':', 'h');

const dayOrder: string[] = [];
const byDay = new Map<string, typeof items>();
for (const it of items) {
  const k = dayKeyFmt.format(it.date);
  if (!byDay.has(k)) { byDay.set(k, []); dayOrder.push(k); }
  byDay.get(k)!.push(it);
}
---
<Base title="Programme" description="Le programme des directs et diffusions LSEI : matchs à venir, en direct et rediffusions, tous sports." active="programme">
  <section class="disc-hero" style="--dc:var(--accent)">
    <div class="wrap">
      <div class="kick" style="color:var(--accent)">Au programme</div>
      <h1>Le programme des diffusions</h1>
      <p>Les matchs à venir et en direct sur LSEI — filtrez par sport pour trouver vos rendez-vous.</p>
      <div class="bar" style="background:var(--accent)"></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prog-filter" id="prog-filter">
        <button type="button" class="prog-fbtn active" data-sport="all">Tous</button>
        {disciplines.map((d) => (
          <button type="button" class="prog-fbtn" data-sport={d.slug} style={`--dc:${d.colorVar}`}>{d.label}</button>
        ))}
      </div>

      {dayOrder.length === 0 ? (
        <p class="dek" style="margin-top:24px">Aucune diffusion programmée pour le moment. Revenez bientôt — le programme se met à jour automatiquement dès qu'un direct est annoncé.</p>
      ) : (
        dayOrder.map((k) => (
          <div class="prog-day">
            <h2 class="prog-day-h">{cap(fmtDay.format(byDay.get(k)![0].date))}</h2>
            <div class="prog-rows">
              {byDay.get(k)!.map((it) => {
                const d = getDiscipline(it.sport);
                const st = it.live ? 'direct' : (it.date.valueOf() > now ? 'avenir' : 'encours');
                const Tag = it.link ? 'a' : 'div';
                // Entrées /admin : catégorie + titre déjà structurés. Directs YouTube :
                // titre brut « guide TV » découpé selon la nomenclature « | ».
                const pt = it.category ? null : parseProgTitle(it.title);
                return (
                  <Tag
                    class="prog-row"
                    data-sport={it.sport}
                    {...(it.link ? { href: it.link, target: it.link.startsWith('http') ? '_blank' : undefined, rel: 'noopener' } : {})}
                  >
                    <span class="prog-thumb">
                      {it.thumb
                        ? <img src={it.thumb} alt="" loading="lazy" />
                        : <span class="prog-thumb-duo" style={`background:linear-gradient(135deg,${d.from},${d.to})`}></span>}
                    </span>
                    <span class="prog-time mono">{it.live ? 'LIVE' : heure(it.date)}</span>
                    <span class="prog-tag" style={`background:${d.tagBg};color:${d.colorVar}`}>{d.label}</span>
                    <span class="prog-what">
                      {pt ? (
                        <>
                          {pt.kicker && <span class="prog-kick" style={`color:${d.colorVar}`}>{pt.kicker}</span>}
                          <b>{pt.main || d.name}</b>
                          {pt.badges.length > 0 && (
                            <span class="prog-badges">{pt.badges.map((b) => <span class="prog-badge">{b}</span>)}</span>
                          )}
                        </>
                      ) : (
                        <>
                          <b>{it.category || it.title || d.name}</b>
                          {it.category && it.title && <span class="prog-sub">{it.title}</span>}
                        </>
                      )}
                    </span>
                    <span class={`prog-status ${st}`}>{st === 'direct' ? '● En direct' : st === 'avenir' ? 'À venir' : 'En cours'}</span>
                  </Tag>
                );
              })}
            </div>
          </div>
        ))
      )}
    </div>
  </section>

  <style>
    .prog-kick { display:block; font-size:.66rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase; margin-bottom:3px; }
    .prog-badges { display:flex; flex-wrap:wrap; gap:5px; margin-top:5px; }
    .prog-badge { font-size:.7rem; font-weight:600; line-height:1.4; padding:1px 8px; border-radius:999px; background:color-mix(in srgb, currentColor 12%, transparent); border:1px solid color-mix(in srgb, currentColor 22%, transparent); white-space:nowrap; opacity:.85; }
  </style>

  <script is:inline>
    (function () {
      var bar = document.getElementById('prog-filter');
      if (!bar) return;
      var btns = [].slice.call(bar.querySelectorAll('.prog-fbtn'));
      var rows = [].slice.call(document.querySelectorAll('.prog-row'));
      var days = [].slice.call(document.querySelectorAll('.prog-day'));
      bar.addEventListener('click', function (e) {
        var b = e.target.closest('.prog-fbtn');
        if (!b) return;
        var s = b.getAttribute('data-sport');
        btns.forEach(function (x) { x.classList.toggle('active', x === b); });
        rows.forEach(function (r) { r.style.display = (s === 'all' || r.getAttribute('data-sport') === s) ? '' : 'none'; });
        days.forEach(function (d) {
          var any = [].slice.call(d.querySelectorAll('.prog-row')).some(function (r) { return r.style.display !== 'none'; });
          d.style.display = any ? '' : 'none';
        });
      });
    })();
  </script>
</Base>
