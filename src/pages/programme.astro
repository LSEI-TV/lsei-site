---
import Base from '../layouts/Base.astro';
import Thumb from '../components/Thumb.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { disciplines, getDiscipline } from '../data/site';
import { getBroadcasts } from '../lib/youtube';
import { parseProgTitle } from '../lib/programmeTitle';
import { getCollection } from 'astro:content';

const now = Date.now();
const TZ = 'Europe/Paris';
const programmeUrl = new URL('/programme', Astro.site).href;

// 1) Programme saisi manuellement via /admin.
const manual = (await getCollection('programme', ({ data }) => !data.draft)).map((p) => ({
  sport: p.data.sport,
  category: p.data.category || '',
  title: p.data.title || '',
  date: p.data.date,
  thumb: p.data.image,
  link: p.data.link,
  live: false,
}));

// 2) Directs YouTube détectés automatiquement (en cours + programmés).
const auto = (await getBroadcasts()).map((b) => ({
  sport: b.discipline,
  category: '',
  title: b.title,
  date: new Date(b.date),
  thumb: `https://i.ytimg.com/vi/${b.id}/maxresdefault.jpg`,
  link: `https://www.youtube.com/watch?v=${b.id}`,
  live: b.live,
}));

// Fusion : on garde ce qui est en cours ou à venir (une diffusion reste listée jusqu'à ~3 h après le début).
let items = [...manual, ...auto].filter((it) => it.live || it.date.valueOf() + 3 * 3600 * 1000 >= now);
items.sort((a, b) => a.date.valueOf() - b.date.valueOf());

// Sports réellement présents au programme → on n'affiche que ces boutons de filtre
// (pas de filtre « fantôme » pour un sport sans aucune diffusion).
const sportsPresent = new Set(items.map((it) => it.sport));

// Groupement par jour (heure de Paris).
const fmtDay = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: TZ });
const fmtTime = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: TZ });
const dayKeyFmt = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: TZ });
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const heure = (d: Date) => fmtTime.format(d).replace(':', 'h');

const dayOrder: string[] = [];
const byDay = new Map<string, typeof items>();
for (const it of items) {
  const k = dayKeyFmt.format(it.date);
  if (!byDay.has(k)) { byDay.set(k, []); dayOrder.push(k); }
  byDay.get(k)!.push(it);
}
---
<Base title="Programme" description="Le programme des directs et diffusions LSEI : matchs à venir, en direct et rediffusions, tous sports." active="programme">
  <section class="disc-hero" style="--dc:var(--accent)">
    <div class="wrap">
      <div class="kick" style="color:var(--accent)">Au programme</div>
      <h1>Le programme des diffusions</h1>
      <p>Les matchs à venir et en direct sur LSEI — filtrez par sport pour trouver vos rendez-vous.</p>
      <div class="bar" style="background:var(--accent)"></div>
      <div class="prog-share"><ShareLinks url={programmeUrl} title="Le programme des diffusions LSEI — tous les prochains directs" /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prog-filter" id="prog-filter">
        <button type="button" class="prog-fbtn active" data-sport="all">Tous</button>
        {disciplines.filter((d) => sportsPresent.has(d.slug)).map((d) => (
          <button type="button" class="prog-fbtn" data-sport={d.slug} style={`--dc:${d.colorVar}`}>{d.label}</button>
        ))}
      </div>

      {dayOrder.length === 0 ? (
        <p class="dek" style="margin-top:24px">Aucune diffusion programmée pour le moment. Revenez bientôt — le programme se met à jour automatiquement dès qu'un direct est annoncé.</p>
      ) : (
        dayOrder.map((k) => (
          <div class="prog-day">
            <h2 class="prog-day-h">{cap(fmtDay.format(byDay.get(k)![0].date))}</h2>
            <div class="prog-grid">
              {byDay.get(k)!.map((it) => {
                const d = getDiscipline(it.sport);
                const Tag = it.link ? 'a' : 'div';
                // Entrées /admin : catégorie + titre déjà structurés. Directs YouTube :
                // titre brut « guide TV » découpé selon la nomenclature « | ».
                const pt = it.category ? null : parseProgTitle(it.title);
                const main = pt ? (pt.main || d.name) : (it.category || it.title || d.name);
                const sub = pt ? [pt.kicker, ...pt.badges].filter(Boolean).join(' · ') : (it.category ? it.title : '');
                // Partage de CETTE diffusion : le lien YouTube du direct si dispo, sinon la page programme.
                const shareUrl = it.link && it.link.startsWith('http') ? it.link : programmeUrl;
                const shareTitle = `${main}${sub ? ' — ' + sub : ''} · LSEI`;
                return (
                  <div class="prog-card" data-sport={it.sport} style={`--dc:${d.colorVar}`}>
                    <Tag
                      class="pc-link"
                      {...(it.link ? { href: it.link, target: it.link.startsWith('http') ? '_blank' : undefined, rel: 'noopener' } : {})}
                    >
                      <span class="pc-thumb">
                        {it.thumb
                          ? <img src={it.thumb} alt="" loading="lazy" onerror={it.thumb.includes('maxresdefault') ? `this.onerror=null;this.src='${it.thumb.replace('maxresdefault', 'hqdefault')}'` : undefined} />
                          : <span class="pc-thumb-duo" style={`background:linear-gradient(135deg,${d.from},${d.to})`}></span>}
                        {it.live && <span class="pc-live">● LIVE</span>}
                      </span>
                      <span class="pc-body">
                        <span class={`pc-time mono${it.live ? ' on' : ''}`}>{it.live ? 'En direct' : heure(it.date)}</span>
                        <span class="pc-t">{main}</span>
                        {sub && <span class="pc-m">{sub}</span>}
                        <span class="pc-tag" style={`background:${d.tagBg};color:${d.colorVar}`}>{d.label}</span>
                      </span>
                    </Tag>
                    <div class="pc-share"><ShareLinks url={shareUrl} title={shareTitle} compact /></div>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      )}
    </div>
  </section>

  <style>
    /* Grille « guide TV » : les diffusions d'une journée s'affichent en vignettes
       côte à côte (ordre des horaires) et passent à la ligne quand c'est plein. */
    .prog-share { margin-top: 18px; }
    .prog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
    .prog-card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--surface); transition: border-color .15s, transform .15s; }
    .prog-card:hover { border-color: var(--dc, var(--c-billard)); transform: translateY(-2px); }
    .pc-link { display: flex; flex-direction: column; flex: 1; color: inherit; text-decoration: none; }
    .pc-share { display: flex; align-items: center; gap: 6px; padding: 8px 12px 10px; border-top: 1px solid var(--line); }
    .pc-thumb { position: relative; aspect-ratio: 16 / 9; background: var(--surface-2); }
    .pc-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pc-thumb-duo { display: block; width: 100%; height: 100%; }
    .pc-live { position: absolute; top: 8px; left: 8px; font-family: var(--mono); font-size: 10.5px; font-weight: 800; letter-spacing: .04em; color: #fff; background: #e5231b; padding: 3px 7px; border-radius: 5px; }
    .pc-body { display: flex; flex-direction: column; gap: 3px; padding: 10px 12px 13px; }
    .pc-time { font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--ink-soft); }
    .pc-time.on { color: #e5231b; }
    .pc-t { font-family: var(--display); font-weight: 700; font-size: 15.5px; line-height: 1.2; color: var(--ink); }
    .pc-m { font-size: 11px; color: var(--ink-faint); text-transform: uppercase; letter-spacing: .03em; line-height: 1.35; }
    .pc-tag { align-self: flex-start; margin-top: 5px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: 3px 8px; border-radius: 999px; }
    /* Sur téléphone : chaque journée devient un CARROUSEL horizontal qu'on fait
       défiler au doigt (accroche par vignette). Une journée à un seul live reste
       en carte pleine largeur. */
    @media (max-width: 620px) {
      .prog-grid {
        display: flex; gap: 12px; overflow-x: auto;
        scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
        scrollbar-width: none; padding-bottom: 2px;
      }
      .prog-grid::-webkit-scrollbar { display: none; }
      .prog-card { flex: 0 0 74%; max-width: 300px; scroll-snap-align: start; }
      .prog-card:only-child { flex-basis: 100%; max-width: none; }
      .pc-t { font-size: 13.5px; }
      .pc-body { padding: 9px 10px 11px; }
    }
  </style>

  <script is:inline>
    (function () {
      var bar = document.getElementById('prog-filter');
      if (!bar) return;
      var btns = [].slice.call(bar.querySelectorAll('.prog-fbtn'));
      var rows = [].slice.call(document.querySelectorAll('.prog-card'));
      var days = [].slice.call(document.querySelectorAll('.prog-day'));
      bar.addEventListener('click', function (e) {
        var b = e.target.closest('.prog-fbtn');
        if (!b) return;
        var s = b.getAttribute('data-sport');
        btns.forEach(function (x) { x.classList.toggle('active', x === b); });
        rows.forEach(function (r) { r.style.display = (s === 'all' || r.getAttribute('data-sport') === s) ? '' : 'none'; });
        days.forEach(function (d) {
          var any = [].slice.call(d.querySelectorAll('.prog-card')).some(function (r) { return r.style.display !== 'none'; });
          d.style.display = any ? '' : 'none';
        });
      });
    })();
  </script>
</Base>
