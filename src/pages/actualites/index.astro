---
// ============================================================
//  ACTUALITÉS (maquette) — format MAGAZINE :
//  « À la une » (grand sujet + 2 sujets secondaires), filtres par sport,
//  puis le fil des actus classé par mois. Le sport de chaque publication est
//  déduit de sa vidéo (vidéothèque) ou, à défaut, de sa légende.
// ============================================================
import Base from '../../layouts/Base.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { getCollection } from 'astro:content';
import { disciplines } from '../../data/site';
import { articleCover } from '../../lib/articles';
import SportIcon from '../../components/SportIcon.astro';
import { PLATFORMS } from '../../lib/social';
import { imgOk } from '../../lib/publicAssets';
import { getReplays } from '../../lib/youtube';

const articles = (await getCollection('articles', ({ data }) => !data.draft && data.date.valueOf() <= Date.now())).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const discOf = (slug?: string) => disciplines.find((d) => d.slug === slug);
const fmtDate = (d: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
const fmtMonth = (d: Date) => new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' }).format(d);

// Publications réseaux (posts choisis à la main) — contenu PRINCIPAL des actualités.
// Tri : « mis en avant » d'abord, puis par date, puis par id (départage STABLE).
const socialPosts = (await getCollection('social', ({ data }) => !data.draft)).sort(
  (a, b) => (Number(b.data.featured) - Number(a.data.featured))
    || (b.data.date.valueOf() - a.data.date.valueOf())
    || a.id.toLowerCase().localeCompare(b.id.toLowerCase()),
);

// Sport d'une publication : celui de sa vidéo dans la vidéothèque, sinon mots-clés de la légende.
const replays = await getReplays();
const discById = new Map(replays.map((v) => [v.id, v.discipline]));
const ytId = (s?: string): string | null => {
  if (!s) return null;
  const m = s.match(/(?:v=|youtu\.be\/|embed\/|shorts\/|live\/)([\w-]{11})/) || s.match(/^([\w-]{11})$/);
  return m ? m[1] : null;
};
const KEYWORDS: [RegExp, string][] = [
  [/billard|blackball|snooker|masters/i, 'billard'], [/basket/i, 'basket'], [/subbuteo/i, 'subbuteo'],
  [/palet/i, 'palets'], [/football|\bfoot\b/i, 'football'], [/beach|volley/i, 'beach'], [/bowling/i, 'bowling'],
];
const guessDisc = (vid: string | null, caption: string) =>
  (vid && discById.get(vid)) || KEYWORDS.find(([re]) => re.test(caption))?.[1] || '';

type Post = { id: string; href: string; title: string; ex: string; date: Date; img: string | null; big: string | null;
  vid: string | null; disc: string; pf: { label: string; color: string; icon: string }; featured: boolean };
const posts: Post[] = socialPosts.map((p) => {
  const lines = (p.data.caption || '').split('\n').map((s) => s.trim()).filter(Boolean);
  const vid = ytId(p.data.video);
  const img = imgOk(p.data.image) ? p.data.image! : (vid ? `https://i.ytimg.com/vi/${vid}/hqdefault.jpg` : null);
  const pf = PLATFORMS[p.data.platform] ?? PLATFORMS.facebook;
  return {
    id: p.id, href: `/actualites/reseaux/${p.id}`,
    // titre sans les émojis de tête (🏀, 🇫🇷…) : plus propre en gros caractères
    title: (lines[0] || '').replace(/^[\p{Extended_Pictographic}\p{Regional_Indicator}️‍\s—–-]+/u, '') || `${pf.label} · ${fmtDate(p.data.date)}`,
    ex: lines.slice(1).filter((l) => !/^[📍🎤🎥#]/u.test(l)).join(' ').slice(0, 260),
    date: p.data.date, img, vid,
    // grande image : version haute définition de la miniature YouTube quand c'en est une
    big: img && /i\.ytimg\.com/.test(img) && vid ? `https://i.ytimg.com/vi/${vid}/maxresdefault.jpg` : img,
    disc: guessDisc(vid, p.data.caption || ''), pf, featured: p.data.featured,
  };
});

// À LA UNE : le 1er sujet en grand + les 2 suivants à côté. Le reste = le fil, par mois.
const lead = posts[0];
const side = posts.slice(1, 3);
const rest = posts.slice(3).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const months: { label: string; items: Post[] }[] = [];
for (const p of rest) {
  const label = fmtMonth(p.date);
  const g = months.find((m) => m.label === label);
  if (g) g.items.push(p); else months.push({ label, items: [p] });
}
// Filtres : seulement les sports qui ont au moins une actu.
const counts = new Map<string, number>();
for (const p of posts) if (p.disc) counts.set(p.disc, (counts.get(p.disc) ?? 0) + 1);
const filters = disciplines.filter((d) => counts.has(d.slug));
const dcol = (slug: string) => discOf(slug)?.colorVar ?? 'var(--accent)';

// Articles éditoriaux affichés. Les anciens .md non souhaités restent en draft: true.
const SHOW_ARTICLES = true;
---
<Base title="Actualités" description="Comptes-rendus, portraits et coulisses des disciplines LSEI." active="actualites">
  <!-- EN-TÊTE -->
  <section class="nw-hero">
    <div class="wrap nw-hero-in">
      <div>
        <div class="nw-kick">Le mag LSEI</div>
        <h1 class="nw-h">Actua<em>lités</em></h1>
        <p class="nw-p">Comptes-rendus, portraits, interviews et coulisses : l'actualité de nos disciplines, racontée par celles et ceux qui la vivent.</p>
      </div>
      <div class="nw-follow"><span>Suivez-nous</span><SocialLinks compact /></div>
    </div>
  </section>

  <!-- À LA UNE — articles éditoriaux, TOUJOURS en haut, le plus récent d'abord. -->
  {SHOW_ARTICLES && articles.length > 0 && (
    <section class="section nw-articles">
      <div class="wrap">
        <div class="sec-head"><div><div class="eyebrow">À la une</div><h2>Les <em>articles</em></h2></div></div>
        <div class="cards">
          {articles.map((a) => {
            const d = discOf(a.data.discipline);
            const cover = articleCover(a);
            return (
              <a href={`/actualites/${a.id}`} class="card" style={d ? `--dc:${d.colorVar}` : ''}>
                <div class="frame">
                  {cover
                    ? <img class="photo" src={cover.src} alt={a.data.title} loading="lazy" onerror={cover.fallback ? `this.onerror=null;this.src='${cover.fallback}'` : undefined} />
                    : <div class="duo" style={d ? `background:linear-gradient(135deg,${d.from},${d.to})` : 'background:linear-gradient(135deg,#1E40E5,#0a1a6b)'}></div>}
                  <div class="grad"></div>
                  {d && <div class="cap"><div class="disc"><SportIcon slug={d.slug} class="disc-tag-ic" />{d.label}</div></div>}
                </div>
                <div class="kicker">{fmtDate(a.data.date)}</div>
                <h3>{a.data.title}</h3>
                <p class="ex">{a.data.excerpt}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- BANDEAU « NE RATEZ RIEN » — au-dessus des publications réseaux de septembre. -->
  <section class="nw-cta">
    <div class="wrap nw-cta-in">
      <div>
        <div class="nw-cta-k">Ne ratez rien</div>
        <p class="nw-cta-t">Les directs, les replays et les coulisses arrivent d'abord sur nos réseaux.</p>
      </div>
      <SocialLinks compact />
    </div>
  </section>

  {posts.length === 0 ? (
    <section class="section"><div class="wrap"><p class="dek">Les actualités arrivent bientôt.</p></div></section>
  ) : (
    <>
      <!-- À LA UNE -->
      <section class="nw-une">
        <div class="wrap">
          <div class="nw-une-grid">
            <a class="nw-lead" href={lead.href} style={`--dc:${dcol(lead.disc)}`}>
              <span class="nw-lead-img">
                {lead.big
                  ? <img src={lead.big} alt="" loading="eager" onerror={lead.img && lead.img !== lead.big ? `if(!this.dataset.f){this.dataset.f=1;this.src='${lead.img}'}` : undefined} />
                  : <span class="nw-ph" set:html={lead.pf.icon}></span>}
                <span class="nw-shade" aria-hidden="true"></span>
                {lead.vid && <span class="nw-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5v14l11-7z" fill="#fff"/></svg></span>}
                <span class="nw-lead-cap">
                  <span class="nw-tags">
                    <span class="nw-une-tag">À la une</span>
                    {lead.disc && <span class="nw-tag">{discOf(lead.disc)?.label}</span>}
                  </span>
                  <span class="nw-lead-t">{lead.title}</span>
                  {lead.ex && <span class="nw-lead-ex">{lead.ex}</span>}
                  <span class="nw-lead-meta"><span class="nw-pf" set:html={lead.pf.icon}></span>{fmtDate(lead.date)}</span>
                </span>
              </span>
            </a>
            <div class="nw-side">
              {side.map((p) => (
                <a class="nw-sc" href={p.href} style={`--dc:${dcol(p.disc)}`}>
                  <span class="nw-sc-img">
                    {p.img ? <img src={p.img} alt="" loading="eager" /> : <span class="nw-ph" set:html={p.pf.icon}></span>}
                    {p.vid && <span class="nw-play nw-play--s" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5v14l11-7z" fill="#fff"/></svg></span>}
                  </span>
                  <span class="nw-sc-body">
                    {p.disc && <span class="nw-tag">{discOf(p.disc)?.label}</span>}
                    <span class="nw-sc-t">{p.title}</span>
                    <span class="nw-date">{fmtDate(p.date)}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- LE FIL : filtres par sport + actus par mois -->
      {rest.length > 0 && (
        <section class="nw-feed">
          <div class="wrap">
            <div class="sec-head"><div><div class="eyebrow">Le fil</div><h2>Toutes les <em>actus</em></h2></div></div>
            {filters.length > 1 && (
              <div class="nw-filters" role="group" aria-label="Filtrer par sport">
                <button type="button" class="is-on" data-f="">Tout <b>{rest.length}</b></button>
                {filters.map((d) => {
                  const n = rest.filter((p) => p.disc === d.slug).length;
                  return n > 0 && <button type="button" data-f={d.slug} style={`--dc:${d.colorVar}`}><span class="nw-f-ico"><SportIcon slug={d.slug} /></span>{d.label} <b>{n}</b></button>;
                })}
              </div>
            )}
            {months.map((m) => (
              <div class="nw-month" data-month>
                <h3 class="nw-month-h"><span>{m.label}</span></h3>
                <div class="nw-grid">
                  {m.items.map((p) => (
                    <a class="nw-card" href={p.href} data-d={p.disc} style={`--dc:${dcol(p.disc)}`}>
                      <span class="nw-card-img">
                        {p.img ? <img src={p.img} alt="" loading="lazy" /> : <span class="nw-ph" set:html={p.pf.icon}></span>}
                        {p.vid && <span class="nw-play nw-play--s" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5v14l11-7z" fill="#fff"/></svg></span>}
                        {p.disc && <span class="nw-tag nw-tag--on">{discOf(p.disc)?.label}</span>}
                      </span>
                      <span class="nw-card-body">
                        <span class="nw-date">{fmtDate(p.date)}</span>
                        <span class="nw-card-t">{p.title}</span>
                        {p.ex && <span class="nw-card-ex">{p.ex}</span>}
                        <span class="nw-more">Lire et regarder →</span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
            <p class="nw-empty" hidden>Aucune actu pour ce sport pour le moment.</p>
          </div>
        </section>
      )}
    </>
  )}

  <script>
    // Filtres par sport (masque les cartes et les mois vides).
    const bar = document.querySelector('.nw-filters');
    bar?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      const f = b.dataset.f || '';
      bar.querySelectorAll('button').forEach((x) => x.classList.toggle('is-on', x === b));
      let shown = 0;
      document.querySelectorAll<HTMLElement>('[data-month]').forEach((m) => {
        let n = 0;
        m.querySelectorAll<HTMLElement>('.nw-card').forEach((c) => { const ok = !f || c.dataset.d === f; c.hidden = !ok; if (ok) n++; });
        m.hidden = n === 0; shown += n;
      });
      const empty = document.querySelector<HTMLElement>('.nw-empty');
      if (empty) empty.hidden = shown > 0;
    });
  </script>

  <style is:global>
    /* ---------- En-tête ---------- */
    .nw-hero { position: relative; color: #fff; overflow: hidden;
      background: radial-gradient(80% 160% at 90% 0%, color-mix(in srgb, #E6007E 26%, #0A0E1A) 0%, #0A0E1A 60%), #0A0E1A; }
    .nw-hero::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--brand-bars, var(--accent)); }
    .nw-hero-in { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; padding-top: 50px; padding-bottom: 38px; }
    .nw-kick { font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: #ff7ac2; }
    .nw-h { font-family: var(--display); font-weight: 800; text-transform: uppercase; letter-spacing: -.02em; font-size: clamp(42px, 6.4vw, 84px); line-height: .92; margin: 8px 0 0; color: #fff; }
    .nw-h em { font-style: normal; background: linear-gradient(90deg, var(--b-blue, #009FE3), var(--b-pink, #E6007E)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .nw-p { color: rgba(255,255,255,.8); font-size: 16.5px; line-height: 1.5; margin: 14px 0 0; max-width: 40em; text-align: start; }
    .nw-follow { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; flex: none; }
    .nw-follow > span { font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.6); }
    .nw-follow a, .nw-cta a { color: #fff; }

    /* ---------- Éléments communs ---------- */
    .nw-tag { align-self: flex-start; display: inline-block; font-size: 10.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--dc); }
    .nw-tag--on, .nw-lead .nw-tag { color: #fff; background: var(--dc); padding: 3px 9px; border-radius: 4px; }
    .nw-date { font-size: 12px; font-weight: 700; color: var(--ink-faint); text-transform: uppercase; letter-spacing: .04em; }
    .nw-ph { position: absolute; inset: 0; display: grid; place-items: center; background: linear-gradient(135deg, var(--dc), color-mix(in srgb, var(--dc) 30%, #0A0E1A)); }
    .nw-ph :global(svg), .nw-ph svg { width: 30%; height: auto; fill: #fff; opacity: .85; }
    .nw-play { position: absolute; top: 16px; right: 16px; width: 54px; height: 54px; border-radius: 50%; background: rgba(10,14,26,.55); border: 2px solid rgba(255,255,255,.9);
      display: grid; place-items: center; padding-left: 3px; transition: background .2s, transform .2s; z-index: 2; }
    .nw-play--s { width: 38px; height: 38px; top: auto; bottom: 10px; right: 10px; }
    a:hover > * > .nw-play, a:hover .nw-play { background: var(--dc); border-color: transparent; transform: scale(1.06); }

    /* ---------- À la une ---------- */
    .nw-une { padding: 36px 0 10px; background-image: radial-gradient(rgba(20, 30, 50, .055) 1px, transparent 1.4px); background-size: 22px 22px; }
    .nw-une-grid { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); gap: 22px; }
    .nw-lead { display: block; text-decoration: none; color: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 26px 56px -26px rgba(12,14,19,.7); }
    .nw-lead-img { position: relative; display: block; aspect-ratio: 16 / 10; background: #0A0E1A; height: 100%; min-height: 380px; }
    .nw-lead-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
    .nw-lead:hover img { transform: scale(1.035); }
    .nw-lead-img::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 5px; background: var(--brand-bars, var(--dc)); z-index: 2; }
    .nw-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(8,12,22,.95) 0%, rgba(8,12,22,.6) 36%, transparent 66%); }
    .nw-lead-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 26px 28px; display: flex; flex-direction: column; gap: 10px; }
    .nw-tags { display: flex; gap: 8px; flex-wrap: wrap; }
    .nw-une-tag { font-size: 10.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; background: #fff; color: #0A0E1A; padding: 3px 9px; border-radius: 4px; }
    .nw-lead-t { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(26px, 3.2vw, 42px); line-height: 1; letter-spacing: -.01em; }
    .nw-lead-ex { color: rgba(255,255,255,.82); font-size: 15px; line-height: 1.5; max-width: 46em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .nw-lead-meta { display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; color: rgba(255,255,255,.7); text-transform: uppercase; letter-spacing: .04em; }
    .nw-pf { display: inline-flex; width: 16px; height: 16px; }
    .nw-pf svg { width: 100%; height: 100%; fill: currentColor; }
    .nw-side { display: grid; grid-template-rows: 1fr 1fr; gap: 22px; }
    .nw-sc { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
      box-shadow: 0 1px 2px rgba(16,24,40,.05), 0 10px 26px -14px rgba(16,24,40,.16); transition: transform .25s cubic-bezier(.2,.7,.2,1), box-shadow .25s; }
    .nw-sc:hover { transform: translateY(-4px); box-shadow: 0 22px 40px -18px rgba(16,24,40,.32); }
    .nw-sc-img { position: relative; display: block; flex: 1; min-height: 120px; background: #111; border-bottom: 3px solid var(--dc); }
    .nw-sc-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .nw-sc-body { display: flex; flex-direction: column; gap: 5px; padding: 12px 16px 14px; }
    .nw-sc-t { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 19px; line-height: 1.05; }
    .nw-sc:hover .nw-sc-t { color: var(--dc); }

    /* ---------- Le fil ---------- */
    .nw-feed { padding: 46px 0 50px; }
    .nw-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: -6px 0 26px; }
    .nw-filters button { display: inline-flex; align-items: center; gap: 7px; font: inherit; font-size: 13.5px; font-weight: 700; padding: 7px 13px; border-radius: 999px; cursor: pointer;
      background: var(--surface); color: var(--ink); border: 1px solid var(--line-strong); transition: background .15s, color .15s, border-color .15s; }
    .nw-filters button b { font-size: 11px; background: var(--bg-soft, rgba(0,0,0,.06)); padding: 1px 7px; border-radius: 999px; }
    .nw-filters button:hover { border-color: var(--dc, var(--ink)); }
    .nw-filters button.is-on { background: var(--dc, #0A0E1A); border-color: var(--dc, #0A0E1A); color: #fff; }
    .nw-filters button.is-on b { background: rgba(255,255,255,.22); }
    .nw-f-ico { display: inline-flex; width: 16px; height: 16px; color: var(--dc); }
    .nw-f-ico svg { width: 100%; height: 100%; }
    .nw-filters button.is-on .nw-f-ico { color: #fff; }
    .nw-month + .nw-month { margin-top: 34px; }
    .nw-month[hidden], .nw-card[hidden] { display: none; }
    .nw-month-h { display: flex; align-items: center; gap: 14px; margin: 0 0 16px; font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 15px; letter-spacing: .08em; color: var(--ink-soft); }
    .nw-month-h::after { content: ""; flex: 1; height: 1px; background: var(--line); }
    .nw-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
    .nw-card { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
      box-shadow: 0 1px 2px rgba(16,24,40,.05), 0 10px 26px -14px rgba(16,24,40,.16); transition: transform .25s cubic-bezier(.2,.7,.2,1), box-shadow .25s; }
    .nw-card:hover { transform: translateY(-4px); box-shadow: 0 22px 40px -18px rgba(16,24,40,.32); }
    .nw-card-img { position: relative; display: block; aspect-ratio: 16 / 9; background: #111; overflow: hidden; border-bottom: 3px solid var(--dc); }
    .nw-card-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
    .nw-card:hover .nw-card-img img { transform: scale(1.05); }
    .nw-card-img .nw-tag { position: absolute; left: 10px; top: 10px; }
    .nw-card-body { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px 16px; flex: 1; }
    .nw-card-t { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 20px; line-height: 1.05; }
    .nw-card:hover .nw-card-t { color: var(--dc); }
    .nw-card-ex { color: var(--ink-soft); font-size: 14px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .nw-more { margin-top: auto; padding-top: 6px; font-size: 13px; font-weight: 800; color: var(--dc); }
    .nw-empty { color: var(--ink-soft); }

    /* ---------- Bandeau réseaux ---------- */
    .nw-cta { position: relative; background: #0A0E1A; color: #fff; }
    .nw-cta::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--brand-bars, var(--accent)); }
    .nw-cta-in { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-top: 30px; padding-bottom: 30px; }
    .nw-cta-k { font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #7fb2ff; }
    .nw-cta-t { margin: 6px 0 0; font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(18px, 2vw, 24px); line-height: 1.1; text-align: start; }

    @media (max-width: 960px) {
