---
import Base from '../../layouts/Base.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import { getCollection } from 'astro:content';
import { disciplines } from '../../data/site';
import { articleCover, renderArticleBody } from '../../lib/articles';
import { playersInText } from '../../lib/billardStats';
import SportIcon from '../../components/SportIcon.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft && data.date.valueOf() <= Date.now());
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const bodyHtml = renderArticleBody(article.body ?? '');
const d = disciplines.find((x) => x.slug === article.data.discipline);
const cover = articleCover(article);
const shareUrl = new URL(`/actualites/${article.id}`, Astro.site).href;
const fmtDate = (dt: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(dt);
// Joueurs du Blackball Master cités dans l'article → lien vers leur fiche carrière.
const citedPlayers = article.data.discipline === 'billard'
  ? playersInText(`${article.data.title} ${article.data.excerpt} ${article.body ?? ''}`)
  : [];

// Données structurées article (SEO) : éligibilité aux résultats enrichis « Article ».
const ogImageAbs = cover ? new URL(cover.fallback ?? cover.src, Astro.site).href : new URL('/og-image.jpg', Astro.site).href;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.data.seoTitle ?? article.data.title,
  description: article.data.seoDescription ?? article.data.excerpt,
  image: [ogImageAbs],
  datePublished: article.data.date.toISOString(),
  dateModified: (article.data.updated ?? article.data.date).toISOString(),
  inLanguage: 'fr-FR',
  mainEntityOfPage: { '@type': 'WebPage', '@id': shareUrl },
  // « La rédaction LSEI » = l'organisation, pas une personne
  ...(article.data.author && !/rédaction|LSEI/i.test(article.data.author)
    ? { author: { '@type': 'Person', name: article.data.author } }
    : { author: { '@type': 'Organization', name: 'LSEI — Le Sport en Image', url: new URL('/', Astro.site).href } }),
  publisher: {
    '@type': 'Organization',
    name: 'LSEI — Le Sport en Image',
    logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', Astro.site).href },
  },
};

// Articles du Championnat du monde de blackball 2026 : rattachés à la page de l'événement
// (lien en tête d'article + fil d'Ariane structuré).
const CDM_PREFIX = 'championnat-du-monde-blackball-2026';
const CDM_HREF = '/billard/championnat-du-monde-blackball-2026';
const isCdm = article.id.startsWith(CDM_PREFIX);
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Actualités', item: new URL('/actualites', Astro.site).href },
    ...(isCdm ? [{ '@type': 'ListItem', position: 2, name: 'Championnat du monde de billard blackball 2026', item: new URL(CDM_HREF, Astro.site).href }] : []),
    { '@type': 'ListItem', position: isCdm ? 3 : 2, name: article.data.seoTitle ?? article.data.title, item: shareUrl },
  ],
};
---
<Base title={article.data.seoTitle ?? article.data.title} description={article.data.seoDescription ?? article.data.excerpt} active="actualites" ogType="article" image={cover ? (cover.fallback ?? cover.src) : undefined}>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
  <article class="section">
    <div class="wrap article-wrap">
      <a href="/actualites" class="link" style="display:inline-block;margin-bottom:18px">← Toutes les actualités</a>
      {isCdm && (
        <a href={CDM_HREF} class="cdm-dossier">🎱 Dossier · <b>Championnat du monde de billard blackball 2026</b> · tous les articles</a>
      )}
      <h1 class="article-title">{article.data.title}</h1>
      <div class="article-meta">{article.data.author && <Fragment>{article.data.author} · </Fragment>}{fmtDate(article.data.date)}</div>
      {cover && <img class="article-cover" src={cover.src} alt={article.data.title} onerror={cover.fallback ? `this.onerror=null;this.src='${cover.fallback}'` : undefined} />}
      <div class="prose article-body" set:html={bodyHtml}></div>
      {citedPlayers.length > 0 && (
        <div class="artplayers">
          <span class="artplayers-lab">Joueurs cités</span>
          {citedPlayers.map((p) => (
            <a href={`/billard/joueur/${p.slug}`} class="artplayer">🎱 {p.name}</a>
          ))}
        </div>
      )}
      <div class="article-share"><ShareLinks url={shareUrl} title={article.data.title} /></div>
      {d && (
        <footer class="article-footer">
          <span class="af-label">Catégorie</span>
          <a href={`/disciplines/${d.slug}`} class="article-tag" style={`--dc:${d.colorVar}`}>
            <SportIcon slug={d.slug} class="disc-page-ic" />{d.label}
          </a>
        </footer>
      )}
    </div>
  </article>
</Base>

<style>
  .cdm-dossier { display: block; margin: 0 0 18px; padding: 10px 14px; border-radius: 10px; border-left: 4px solid #2f6bff;
    background: color-mix(in srgb, #2f6bff 9%, transparent); color: inherit; text-decoration: none; font-size: 15px; }
  .cdm-dossier:hover { background: color-mix(in srgb, #2f6bff 16%, transparent); }
</style>
