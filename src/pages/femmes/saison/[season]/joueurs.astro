---
import Base from '../../../../layouts/Base.astro';
import HubNav from '../../../../components/HubNav.astro';
import SeasonPicker from '../../../../components/SeasonPicker.astro';
import PlayerSearch from '../../../../components/PlayerSearch.astro';
import { photoOf, playerSlugs } from '../../../../lib/billardStats';
import { getFemmesSeasons } from '../../../../data/billard/seasonsFemmes';
const { slugOf } = playerSlugs(getFemmesSeasons());
import type { Season } from '../../../../data/billard/seasons';

export function getStaticPaths() {
  return getFemmesSeasons().filter((s) => s.results).map((s) => ({ params: { season: s.slug }, props: { season: s } }));
}
const { season } = Astro.props as { season: Season };
const R = season.results!;
const byRank = [...(R.players as any[])].sort((a, b) => a.rank - b.rank);
const byWins = [...(R.players as any[])].sort((a, b) => b.wins - a.wins || b.winPct - a.winPct);
const maxWins = byWins[0]?.wins || 1;
---
<Base title={`Joueuses ${season.label} — Blackball Femmes`} description={`Les joueuses du Blackball Femmes, saison ${season.label}.`} active="disciplines">
  <HubNav season={season.slug} active="joueurs" root="/femmes" brand="Billard Femmes" sub="· Blackball Femmes" joueursLabel="Joueuses" videosHref="/disciplines/billard/categorie/femmes" />
  <section class="disc-hero" style="--dc:var(--c-billard)">
    <div class="wrap">
      <div class="kick" style="color:var(--c-billard)">Blackball Femmes · Joueuses</div>
      <h1>Les joueuses de la saison</h1>
      <p>Les {byWins.length} joueuses classées de la saison {season.label}.</p>
      <div class="bar" style="background:var(--c-billard)"></div>
      <div class="bstat-nav"><SeasonPicker current={season.slug} sub="/joueurs" onlyPlayed={true} root="/femmes" seasons={getFemmesSeasons()} /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div style="max-width:460px;margin-bottom:26px"><PlayerSearch placeholder="Rechercher une joueuse…" seasons={getFemmesSeasons()} hrefBase="/femmes/joueur/" /></div>

      <div class="sec-head"><div><div class="eyebrow" style="color:var(--c-billard)">Les joueuses</div><h2>Toutes les têtes de la saison</h2></div></div>
      <p class="fj-help" style="margin-top:0">Cliquez sur une joueuse pour ouvrir sa <b>fiche carrière</b> complète.</p>
      <div class="pvigs">
        {byRank.map((p) => {
          const src = photoOf(p, season.slug);
          return (
            <a href={`/femmes/joueur/${slugOf(p.id)}`} class="pvig">
              <span class="pvig-rank">{p.rank}<sup>e</sup></span>
              <span class="bphoto pvig-ph"><span class="bavatar">{p.name.slice(0, 1)}</span>{src && <img src={src} alt="" loading="lazy" onerror="this.remove()" />}</span>
              <span class="pvig-name">{p.name}</span>
              <span class="pvig-stat">{p.points} pts · {p.wins}V-{p.losses}D</span>
            </a>
          );
        })}
      </div>

      <div class="sec-head" style="margin-top:40px"><div><div class="eyebrow" style="color:var(--c-billard)">Classement par victoires</div><h2>Le plus de victoires</h2></div></div>
      <div class="viclist" style="max-width:820px">
        {byWins.map((p, i) => {
          const src = photoOf(p, season.slug);
          return (
            <a href={`/femmes/joueur/${slugOf(p.id)}`} class="vicrow">
              <span class="vic-rank">{i + 1}</span>
              <span class="bphoto vic-ph"><span class="bavatar">{p.name.slice(0, 1)}</span>{src && <img src={src} alt="" loading="lazy" onerror="this.remove()" />}</span>
              <span class="vic-name">{p.name}</span>
              <span class="vic-bar"><span style={`width:${Math.round((p.wins / maxWins) * 100)}%`}></span></span>
              <span class="vic-num">{p.wins}<small>V</small></span>
              <span class="vic-sub mono">{p.losses}D · {p.winPct}%</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>
