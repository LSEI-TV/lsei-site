---
import Base from '../../../layouts/Base.astro';
import HubNav from '../../../components/HubNav.astro';
import { getCollection } from 'astro:content';
import { photoOf, fromPov, fmtDate, frRound, playersInText, playerSlugs } from '../../../lib/billardStats';
import { getReplays } from '../../../lib/youtube';
import { parseProgTitle } from '../../../lib/programmeTitle';
import { titleMatchesPlayer } from '../../../lib/videoMatch';
import { playerVideos as playerVideosFor } from '../../../lib/playerVideos';
import { getFemmesSeasons, getFemmesPalmares } from '../../../data/billard/seasonsFemmes';
import clubLogos from '../../../data/billard/club-logos.json';
import playerCutouts from '../../../data/billard/player-cutouts.json';
import playerColors from '../../../data/billard/player-colors.json';

export function getStaticPaths() {
  const { entries } = playerSlugs(getFemmesSeasons());
  const paths: any[] = [];
  for (const { id, slug } of entries) {
    paths.push({ params: { id: slug }, props: { pid: id, slug } });
    paths.push({ params: { id: String(id) }, props: { pid: id, slug } });
  }
  return paths;
}

const { pid, slug } = Astro.props as { pid: number; slug: string };
const { slugOf } = playerSlugs(getFemmesSeasons());
const seasons = getFemmesSeasons().filter((s) => s.results);

const bySeason = seasons
  .map((s) => {
    const R = s.results!;
    const p = (R.players as any[]).find((x) => x.id === pid);
    return p ? { slug: s.slug, label: s.label, status: s.status, p, R } : null;
  })
  .filter(Boolean) as { slug: string; label: string; status: string; p: any; R: any }[];

// Détail complet par saison — pour l'accordéon « saison par saison » (toutes les infos,
// données déjà en mémoire, aucune requête supplémentaire ni page séparée).
const seasonInfo = bySeason.map((x) => {
  const res = (x.R.matches as any[]).filter((m) => m.aId === pid || m.bId === pid).map((m) => fromPov(m, pid));
  const chrono = [...res].sort((a, b) => (a.date < b.date ? -1 : 1));
  const recent = [...res].sort((a, b) => (a.date < b.date ? 1 : -1));
  let best = 0, cur = 0;
  for (const r of chrono) { if (r.win) { cur++; best = Math.max(best, cur); } else cur = 0; }
  const wins = res.filter((r) => r.win);
  const biggest = wins.length ? wins.reduce((b, r) => ((r.my - r.opp) > (b.my - b.opp) ? r : b)) : null;
  const n = res.length || 1;
  const avgFor = res.reduce((s, r) => s + r.my, 0) / n;
  const avgAg = res.reduce((s, r) => s + r.opp, 0) / n;
  const byTour = (x.R.tournaments as any[])
    .map((t) => {
      const tms = res.filter((r) => r.tid === t.id).sort((a, b) => (a.date < b.date ? -1 : 1));
      return tms.length ? { level: t.level, city: t.city, w: tms.filter((r) => r.win).length, l: tms.filter((r) => !r.win).length, ms: tms } : null;
    })
    .filter(Boolean) as { level: string; city: string; w: number; l: number; ms: any[] }[];
  return { byTour, best, biggest, avgFor, avgAg, form: recent.slice(0, 5) };
});

const latest = bySeason[0];
const name = latest.p.name;
const photo = photoOf(latest.p, latest.slug);

const career = bySeason.reduce(
  (a, x) => {
    a.played += x.p.played; a.wins += x.p.wins; a.losses += x.p.losses; a.tourns += x.p.tourns;
    return a;
  },
  { played: 0, wins: 0, losses: 0, tourns: 0 },
);
const winPct = career.played ? Math.round((career.wins / career.played) * 100) : 0;
const bestRank = Math.min(...bySeason.map((x) => x.p.rank));

const palm = getFemmesPalmares();
const titles: { label: string; slug: string; kind: 'saison' | 'france' }[] = [];
for (const pl of palm) {
  if (pl.champ.id === pid) titles.push({ label: pl.label, slug: pl.slug, kind: 'saison' });
  if (pl.cdf && pl.cdf.id === pid) titles.push({ label: pl.label, slug: pl.slug, kind: 'france' });
}

interface Enc { seasonLabel: string; slug: string; level: string; city: string; my: number; opp: number; win: boolean; date: string }
const oppMap = new Map<number, { name: string; w: number; l: number; n: number; enc: Enc[] }>();
for (const x of bySeason) {
  const tById = new Map((x.R.tournaments as any[]).map((t) => [t.id, t]));
  for (const m of (x.R.matches as any[]).filter((m) => m.aId === pid || m.bId === pid)) {
    const r = fromPov(m, pid);
    let e = oppMap.get(r.oppId);
    if (!e) { e = { name: r.oppName, w: 0, l: 0, n: 0, enc: [] }; oppMap.set(r.oppId, e); }
    e.n++; r.win ? e.w++ : e.l++;
    const t: any = tById.get(r.tid) || {};
    e.enc.push({ seasonLabel: x.label, slug: x.slug, level: t.level || '', city: t.city || '', my: r.my, opp: r.opp, win: r.win, date: r.date });
  }
}
const allOpp = [...oppMap.entries()]
  .map(([id, e]) => ({ id, ...e, photo: photoOf({ name: e.name } as any), enc: [...e.enc].sort((a, b) => (a.date < b.date ? 1 : -1)) }))
  .sort((a, b) => b.n - a.n || b.w - a.w || a.name.localeCompare(b.name, 'fr'));
const rivals = allOpp.slice(0, 8);

const allResults: any[] = [];
for (const x of bySeason) {
  for (const m of (x.R.matches as any[]).filter((m) => m.aId === pid || m.bId === pid)) {
    allResults.push({ ...fromPov(m, pid), slug: x.slug, label: x.label, R: x.R });
  }
}
allResults.sort((a, b) => (a.date < b.date ? 1 : -1));
const recent = allResults.slice(0, 6);

// Hero « magazine » : statut, meilleure série carrière, plus large victoire, dernier match.
const leftAfter = latest.slug !== seasons[0].slug ? latest.label : null;
const careerChrono = [...allResults].sort((a, b) => (a.date < b.date ? -1 : 1));
let careerStreak = 0, _run = 0;
for (const r of careerChrono) { if (r.win) { _run++; careerStreak = Math.max(careerStreak, _run); } else _run = 0; }
const careerWins = allResults.filter((r) => r.win);
const biggestCareer = careerWins.length ? careerWins.reduce((b, r) => ((r.my - r.opp) > (b.my - b.opp) ? r : b)) : null;
const lastMatch = allResults[0] || null;
const lastTour = lastMatch ? (lastMatch.R.tournaments as any[]).find((t: any) => t.id === lastMatch.tid) : null;
const lastOppPhoto = lastMatch ? photoOf({ name: lastMatch.oppName } as any) : null;

// ---------- Bandeau « Profil » : évolution du classement + bête noire / client favori ----------
// Rang par saison, du plus ancien au plus récent (pour la courbe). Les invités (rang null) sont ignorés.
const rankSeries = bySeason.filter((x) => x.p.rank != null).map((x) => ({ season: x.label, rank: x.p.rank as number, slug: x.slug })).reverse();
const shortSeason = (s: string) => { const d = (s || '').replace(/\D/g, ''); return d.length >= 8 ? `${d.slice(2, 4)}-${d.slice(6, 8)}` : s; };
// Adversaires contre qui il a le plus de VICTOIRES / de DÉFAITES (par nombre de matchs).
const _byWin = [...allOpp].filter((o) => o.w > 0).sort((a, b) => b.w - a.w || a.l - b.l || b.n - a.n);
const _byLoss = [...allOpp].filter((o) => o.l > 0).sort((a, b) => b.l - a.l || a.w - b.w || b.n - a.n);
const clientOk = _byWin[0] || null;                                                      // le plus de victoires
const beteOk = (_byLoss.find((o) => !clientOk || o.id !== clientOk.id)) || null;         // le plus de défaites (adversaire différent)
// Finales atteintes + tournois gagnés (toutes saisons).
let finalesCount = 0, tournamentWins = 0;
for (const x of bySeason) {
  const mine = (x.R.matches as any[]).filter((m) => (m.aId === pid || m.bId === pid) && m.roundNo != null);
  for (const tid of [...new Set(mine.map((m) => m.tid))]) {
    const allT = (x.R.matches as any[]).filter((m) => m.tid === tid && m.roundNo != null);
    if (!allT.length) continue;
    const maxR = Math.max(...allT.map((m) => m.roundNo));
    const fin = mine.find((m) => m.tid === tid && m.roundNo === maxR);
    if (fin) { finalesCount++; const won = fin.aId === pid ? fin.sA > fin.sB : fin.sB > fin.sA; if (won) tournamentWins++; }
  }
}
// Courbe du classement en SVG, rendue côté serveur (bon pour le SEO, aucun JS client).
const _rkMax = rankSeries.length ? Math.max(...rankSeries.map((r) => r.rank), 2) : 2;
const _rkW = 600, _rkH = 132, _rkPX = 16, _rkPT = 24, _rkPB = 26;
const _rkX = (i: number) => (rankSeries.length > 1 ? _rkPX + i * ((_rkW - 2 * _rkPX) / (rankSeries.length - 1)) : _rkW / 2);
const _rkY = (r: number) => _rkPT + ((r - 1) / (_rkMax - 1)) * (_rkH - _rkPT - _rkPB);
const rkLine = rankSeries.map((p, i) => (i ? 'L' : 'M') + _rkX(i).toFixed(1) + ' ' + _rkY(p.rank).toFixed(1)).join(' ');
const rkArea = rankSeries.length ? `M${_rkX(0).toFixed(1)} ${_rkH - _rkPB} ` + rankSeries.map((p, i) => `L${_rkX(i).toFixed(1)} ${_rkY(p.rank).toFixed(1)}`).join(' ') + ` L${_rkX(rankSeries.length - 1).toFixed(1)} ${_rkH - _rkPB} Z` : '';
const showProfil = rankSeries.length >= 2 || !!beteOk || !!clientOk;

// En-tête « héros » : épithète (statut) + habillage (photo détourée, logo club, couleur du polo).
const cdfCount = titles.filter((t) => t.kind === 'france').length;
const seasonChampCount = titles.filter((t) => t.kind === 'saison').length;
const _ep: string[] = [];
if (cdfCount) _ep.push(cdfCount > 1 ? `Championne de France ×${cdfCount}` : 'Championne de France');
else if (seasonChampCount) _ep.push(seasonChampCount > 1 ? `Championne de saison ×${seasonChampCount}` : 'Championne de saison');
if (bestRank === 1) _ep.push(latest.p.rank === 1 ? 'N°1 actuelle' : 'Ex N°1');
else if (!_ep.length && bestRank && bestRank <= 3) _ep.push('Habituée du podium');
else if (!_ep.length && tournamentWins) _ep.push('Vainqueure de tournoi');
if (!_ep.length) _ep.push('Blackball Femmes');
const epithet = _ep.slice(0, 2).join(' · ');
const _statusTxt = leftAfter ? `partie après ${leftAfter}` : (latest.p.rank ? `actuellement N°${latest.p.rank}` : 'en activité');
const _nm = name.trim().split(/\s+/);
const heroFirst = _nm.length > 1 ? _nm[0] : '';
const heroLast = _nm.length > 1 ? _nm.slice(1).join(' ') : name;
// Plus long mot du prénom / du nom : le nom se réduit pour ne jamais déborder de sa colonne (cf. .jh-name).
const _longest = (t: string) => Math.max(1, ...String(t || '').split(/[\s-]+/).map((w) => w.length));
const heroFit = `--fw:${_longest(heroFirst)};--lw:${_longest(heroLast)}`;
const _clubKey = (clubLogos as Record<string, string>)[String(pid)];
const clubLogo = _clubKey ? `/billard/clubs/${_clubKey}.png` : null;
const _cutoutKey = (playerCutouts as Record<string, string>)[String(pid)];
const cutout = _cutoutKey ? `/billard/cutouts/${_cutoutKey}.png` : null;   // photo détourée (fond transparent) → flotte sans cadre
const _pc = (playerColors as Record<string, { band: string; band2: string }>)[String(pid)];
const heroBand = _pc ? { c1: _pc.band, c2: _pc.band2, eband: _pc.band2 } : { c1: '#1d5176', c2: '#103349', eband: '#0d2c49' };

// Étapes gagnées sur la saison la plus récente — déterminées par le dernier tour
// remporté (fiable même si le champ « winner » du tournoi n'est pas renseigné).
let stageWinsLatest = 0;
if (bySeason.length) {
  const _xr = bySeason[0].R;
  const _mr = (_xr.matches as any[]).filter((m) => (m.aId === pid || m.bId === pid) && m.roundNo != null);
  for (const _tid of [...new Set(_mr.map((m) => m.tid))]) {
    const _all = (_xr.matches as any[]).filter((m) => m.tid === _tid && m.roundNo != null);
    if (!_all.length) continue;
    const _max = Math.max(..._all.map((m) => m.roundNo));
    const _fin = _mr.find((m) => m.tid === _tid && m.roundNo === _max);
    if (_fin && (_fin.aId === pid ? _fin.sA > _fin.sB : _fin.sB > _fin.sA)) stageWinsLatest++;
  }
}

const arts = (await getCollection('articles', ({ data }) => !data.draft && data.date.valueOf() <= Date.now() && data.discipline === 'billard'))
  .filter((a) => playersInText(`${a.data.title} ${a.data.excerpt} ${a.body}`, getFemmesSeasons()).some((x) => x.id === pid))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const fmtArtDate = (dt: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(dt);

// « Ses matchs en vidéo » : vidéos YouTube billard FEMMES où la joueuse apparaît (reliage
// auto par le nom de famille ; filtre « Femmes » pour éviter un homonyme masculin).
const playerVideos = playerVideosFor(name, await getReplays({ discipline: 'billard' }), 'femmes');
---
<Base title={`${name} — Fiche carrière · Blackball Femmes`} description={`Fiche carrière de ${name} au Blackball Femmes : palmarès, statistiques et confrontations sur ${bySeason.length} saison${bySeason.length > 1 ? 's' : ''}.`} canonical={`/femmes/joueur/${slug}`} active="disciplines">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name, url: new URL(Astro.url.pathname, Astro.site).href, ...(photo ? { image: new URL(photo, Astro.site).href } : {}), description: `${name}, joueuse de billard blackball au Blackball Femmes, suivie par LSEI — Le Sport en Image.`, memberOf: { '@type': 'SportsOrganization', name: 'Blackball Femmes' } })} />
  <HubNav season={latest.slug} active="joueurs" root="/femmes" brand="Billard Femmes" sub="· Blackball Femmes" joueursLabel="Joueuses" videosHref="/disciplines/billard/categorie/femmes" />
  <section class="section jfiche">
    <div class="jhead" style={`--jh-c1:${heroBand.c1};--jh-c2:${heroBand.c2};--jh-eband:${heroBand.eband}`}>
      <section class="jh">
        <div class="jh-geo" aria-hidden="true">
          <svg viewBox="0 0 1400 400" preserveAspectRatio="xMidYMid slice">
            <polygon points="0,0 500,0 180,400 0,400" fill="#ffffff" opacity="0.04"></polygon>
            <polygon points="500,0 780,0 420,400 180,400" fill="#ffffff" opacity="0.025"></polygon>
            <polygon points="1400,0 1400,400 1040,400 1260,0" fill="#000000" opacity="0.14"></polygon>
            <polygon points="1260,0 1040,0 780,400 1040,400" fill="#ffffff" opacity="0.03"></polygon>
            <polygon points="860,0 1060,0 840,260 700,210" fill="var(--jh-gold)" opacity="0.07"></polygon>
            <polygon points="1400,200 1400,400 1150,400" fill="var(--jh-gold)" opacity="0.06"></polygon>
          </svg>
        </div>
        {clubLogo && <img class="jh-club-wm" src={clubLogo} alt="" aria-hidden="true" />}
        <div class="jh-in">
          <div class={`jh-ph ${cutout ? 'cut' : 'framed'}`}>
            {cutout
              ? <img class="jh-cut" src={cutout} alt={name} />
              : (photo ? <img src={photo} alt={name} onerror="this.closest('.jh-ph').classList.add('noimg')" /> : null)}
            <span class="jh-av">{name.slice(0, 1)}</span>
          </div>
          <div class="jh-txt">
            {clubLogo && <img class="jh-crest" src={clubLogo} alt="Club de la joueuse" />}
            <div class="jh-eye">Blackball Femmes · {bySeason.length} saison{bySeason.length > 1 ? 's' : ''} · {_statusTxt}{cdfCount || bestRank === 1 || seasonChampCount ? <> · <span class="g">🏆 {epithet.split(' · ')[0]}</span></> : null}</div>
            <h1 class="jh-name" style={heroFit}>{heroFirst}<b>{heroLast}</b></h1>
            <span class="jh-key">{epithet}</span>
          </div>
        </div>
      </section>
      <section class="eband"><div class="eband-in">
        <div class="eband-head">
          <div class="eh"><div class="v g"><b>{winPct}</b>%</div><div class="k">Victoires carrière</div></div>
          <div class="eh"><div class="v"><b>{career.wins}</b>–{career.losses}</div><div class="k">Bilan</div></div>
          <div class="eh"><div class="v g">N°<b>{bestRank}</b></div><div class="k">Meilleur rang</div></div>
        </div>
        <div class="egrid">
          <div class="eg"><div class="k">Saisons</div><div class="v">{bySeason.length}</div></div>
          <div class="eg"><div class="k">Titres</div><div class="v">{titles.length}</div></div>
          <div class="eg"><div class="k">Série record</div><div class="v">{careerStreak}</div></div>
          <div class="eg"><div class="k">Matchs</div><div class="v">{career.played}</div></div>
          <div class="eg"><div class="k">Tournois</div><div class="v">{career.tourns}</div></div>
          <div class="eg"><div class="k">Finales</div><div class="v">{finalesCount}</div></div>
          {cdfCount > 0 && <div class="eg"><div class="k">Titres de France</div><div class="v g">{cdfCount}</div></div>}
          <div class="eg"><div class="k">Actuel</div><div class="v">{latest.p.rank ? <>N°{latest.p.rank}</> : '—'}</div></div>
          {cdfCount === 0 && <div class="eg"><div class="k">Étapes gagnées {shortSeason(latest.label)}</div><div class="v">{stageWinsLatest}</div></div>}
        </div>
      </div></section>
      <nav class="jtabs"><div class="jtabs-in">
        <a href="#profil" class="jtab">Profil</a>
        <a href="#saisons" class="jtab">Saison par saison</a>
        {rivals.length > 0 && <a href="#confrontations" class="jtab">Confrontations</a>}
        {playerVideos.length > 0 && <a href="#videos" class="jtab">Vidéos</a>}
        {lastMatch && <a href={`/femmes/joueur/${slugOf(lastMatch.oppId)}`} class="jtab jtab-last">Dernier : {lastMatch.win ? 'V' : 'D'} {lastMatch.my}–{lastMatch.opp} vs {lastMatch.oppName}</a>}
      </div></nav>
    </div>
    <div class="wrap" style="max-width:1100px">
      <a href={`/femmes/saison/${latest.slug}/classement`} class="link" style="color:var(--c-billard);display:inline-block;margin-bottom:18px">← Classement {latest.label}</a>

      <div class="car-scope"><span class="car-scope-tag">Carrière</span> {bySeason.length} saison{bySeason.length > 1 ? 's' : ''}{bySeason.length > 1 ? ` · de ${bySeason[bySeason.length - 1].label} à ${bySeason[0].label}` : ` · ${bySeason[0].label}`} <span class="car-scope-sub">· tous chiffres ci-dessous = ensemble de la carrière</span></div>
      <div class="btiles">
        <div class="btile" title="Nombre de saisons du Blackball Femmes où la joueuse a participé."><div class="bt-num" style="color:var(--c-billard)">{bySeason.length}</div><div class="bt-lab">Saison{bySeason.length > 1 ? 's' : ''} carrière</div></div>
        <div class="btile" title="Le meilleur classement final atteint sur l'ensemble de sa carrière."><div class="bt-num">{bestRank}<sup>e</sup></div><div class="bt-lab">Meilleur classement carrière</div></div>
        <div class="btile" title="Total des matchs gagnés (V) et perdus (D) sur toute la carrière."><div class="bt-num">{career.wins}<span>-</span>{career.losses}</div><div class="bt-vdbar"><span class="bt-vd-w" style={`width:${winPct}%`}></span><span class="bt-vd-l" style={`width:${100 - winPct}%`}></span></div><div class="bt-lab">Bilan carrière</div></div>
        <div class="btile" title="Part de matchs gagnés sur l'ensemble de la carrière."><div class="bt-ring"><svg viewBox="0 0 36 36" aria-hidden="true"><circle class="bt-ring-bg" cx="18" cy="18" r="15.915"></circle><circle class="bt-ring-fg" cx="18" cy="18" r="15.915" style={`stroke-dasharray:${winPct} ${100 - winPct}`}></circle></svg><span class="bt-ring-val">{winPct}<small>%</small></span></div><div class="bt-lab">Taux de victoires carrière</div></div>
        <div class="btile" title="Total des matchs disputés, toutes saisons confondues."><div class="bt-num">{career.played}</div><div class="bt-lab">Matchs joués carrière</div></div>
        <div class="btile" title="Total des tournois (étapes) disputés sur la carrière."><div class="bt-num">{career.tourns}</div><div class="bt-lab">Tournois carrière</div></div>
      </div>

      {showProfil && (
        <>
          <div id="profil" class="sec-head jt-anchor" style="margin-top:30px"><div><div class="eyebrow" style="color:var(--c-billard)">Profil</div><h2>Le joueur en un coup d'œil</h2></div></div>
          <div class="prof-grid">
            {rankSeries.length >= 2 && (
              <div class="prof-card prof-rank">
                <div class="prof-card-h">Évolution au classement <span class="prof-best">★ Meilleur : N°{bestRank}</span></div>
                <div class="prof-chart">
                  <svg class="prof-spark" viewBox={`0 0 ${_rkW} ${_rkH}`} preserveAspectRatio="none" role="img" aria-label={`Évolution du classement de ${name} : ${rankSeries.map((p) => `${shortSeason(p.season)} N°${p.rank}`).join(', ')}`}>
                    <defs><linearGradient id="rkg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--c-billard)" stop-opacity="0.26"></stop><stop offset="1" stop-color="var(--c-billard)" stop-opacity="0"></stop></linearGradient></defs>
                    <path d={rkArea} fill="url(#rkg)"></path>
                    <path d={rkLine} fill="none" stroke="var(--c-billard)" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"></path>
                    {rankSeries.map((p, i) => (<circle cx={_rkX(i).toFixed(1)} cy={_rkY(p.rank).toFixed(1)} r={p.rank === 1 ? 4.6 : 3} fill={p.rank === 1 ? '#f0b429' : 'var(--c-billard)'}></circle>))}
                    {rankSeries.map((p, i) => (<text class={`prof-rank-val${p.rank === 1 ? ' n1' : ''}`} x={_rkX(i).toFixed(1)} y={(_rkY(p.rank) - 8).toFixed(1)} text-anchor="middle">{p.rank}</text>))}
                    {rankSeries.map((p, i) => ((rankSeries.length <= 8 || i % 2 === 0 || i === rankSeries.length - 1) && <text class="prof-spark-lbl" x={_rkX(i).toFixed(1)} y={_rkH - 8} text-anchor="middle">{shortSeason(p.season)}</text>))}
                  </svg>
                </div>
                <div class="prof-legend"><span><i class="d1"></i> Saison terminée N°1</span><span><i class="d"></i> Autre classement</span><span class="prof-legend-hint">Chiffre au-dessus = classement de la saison</span></div>
                <div class="prof-badges">
                  {finalesCount > 0 && <span class="prof-badge">🥈 Finaliste ×{finalesCount}</span>}
                  {careerStreak >= 4 && <span class="prof-badge">🔥 Série de {careerStreak} victoires</span>}
                  <span class="prof-badge">🎱 {career.played} matchs</span>
                </div>
              </div>
            )}
            {(beteOk || clientOk) && (
              <div class="prof-duo">
                {beteOk && (
                  <div class="prof-card prof-vs">
                    <a href={`/femmes/joueur/${slugOf(beteOk.id)}`} class="prof-vs-av bad" aria-hidden="true">{beteOk.name.slice(0, 1)}</a>
                    <div class="prof-vs-body"><span class="prof-tag bad">Le plus de défaites</span><a href={`/femmes/joueur/${slugOf(beteOk.id)}`} class="prof-vs-nm">{beteOk.name}</a><div class="prof-vs-rec"><b>{beteOk.w} V – {beteOk.l} D</b> sur {beteOk.n} duels</div></div>
                  </div>
                )}
                {clientOk && (
                  <div class="prof-card prof-vs">
                    <a href={`/femmes/joueur/${slugOf(clientOk.id)}`} class="prof-vs-av good" aria-hidden="true">{clientOk.name.slice(0, 1)}</a>
                    <div class="prof-vs-body"><span class="prof-tag good">Le plus de victoires</span><a href={`/femmes/joueur/${slugOf(clientOk.id)}`} class="prof-vs-nm">{clientOk.name}</a><div class="prof-vs-rec"><b>{clientOk.w} V – {clientOk.l} D</b> sur {clientOk.n} duels</div></div>
                  </div>
                )}
              </div>
            )}
          </div>
        </>
      )}

      <p class="fj-help"><b>Pour aller vite :</b> cette fiche résume la carrière de la joueuse. Pour le détail d'une saison — parcours étape par étape, tous les résultats — cliquez sur la saison voulue ci-dessous.</p>

      {titles.length > 0 && (
        <div class="car-palm">
          <div class="car-palm-h">Palmarès · {titles.length} titre{titles.length > 1 ? 's' : ''}</div>
          <div class="car-palm-list">
            {titles.map((t) => (
              <span class={`car-palm-item ${t.kind}`}>
                <span class="car-palm-ic">{t.kind === 'france' ? '🏆' : '⭐'}</span>
                <span class="car-palm-body"><b>{t.kind === 'france' ? 'Championne de France' : 'Championne de saison'}</b><span>{t.label}</span></span>
              </span>
            ))}
          </div>
        </div>
      )}

      <div id="saisons" class="sec-head jt-anchor" style="margin-top:34px"><div><div class="eyebrow" style="color:var(--c-billard)">Parcours</div><h2>Saison par saison</h2></div></div>
      <p class="fj-help" style="margin-top:0">Cliquez sur une saison pour dérouler son parcours étape par étape.</p>
      <div class="car-seasons">
        {bySeason.map((x, i) => (
          <div class="car-sitem">
            <button type="button" class="car-srow" data-accordion aria-expanded="false">
              <span class="car-sn">{x.label}</span>
              <span class="car-srank"><b style="color:var(--c-billard)">{x.p.rank}<sup>e</sup></b></span>
              <span class="car-spts">{x.p.points} pts</span>
              <span class="car-srec"><b class="bwin">{x.p.wins}</b>-{x.p.losses}</span>
              <span class="car-sgo car-schev" aria-hidden="true">▾</span>
            </button>
            <div class="car-sdetail" hidden>
              <div class="btiles car-sd-tiles">
                <div class="btile" title="Points au classement officiel FFB, gagnés selon les résultats à chaque tournoi."><div class="bt-num" style="color:var(--c-billard)">{x.p.points}</div><div class="bt-lab">Points FFB</div></div>
                <div class="btile" title="Matchs gagnés (V) et perdus (D) sur la saison."><div class="bt-num">{x.p.wins}<span>-</span>{x.p.losses}</div><div class="bt-lab">Bilan V-D</div></div>
                <div class="btile" title="Part de matchs gagnés."><div class="bt-num">{x.p.winPct}%</div><div class="bt-lab">Taux de victoires</div></div>
                <div class="btile" title="Matchs disputés dans la saison."><div class="bt-num">{x.p.played}</div><div class="bt-lab">Matchs joués</div></div>
                <div class="btile" title="Manches gagnées moins manches perdues sur la saison."><div class="bt-num">{x.p.diff >= 0 ? '+' : ''}{x.p.diff}</div><div class="bt-lab">Différentiel</div></div>
                <div class="btile" title="Étapes (tournois) disputées dans la saison."><div class="bt-num">{x.p.tourns}</div><div class="bt-lab">Tournois</div></div>
              </div>
              <div class="fj-extra">
                <div class="fj-form">
                  <span class="fj-lab">Forme</span>
                  {seasonInfo[i].form.map((r) => <span class={`spot-chip ${r.win ? 'w' : 'l'}`}>{r.win ? 'V' : 'D'}</span>)}
                  {seasonInfo[i].form.length === 0 && <span class="dek" style="margin:0">—</span>}
                </div>
                <div class="fj-more">
                  <span title="La plus longue série de victoires consécutives sur la saison."><b>{seasonInfo[i].best}</b> victoires d'affilée <span class="fj-hint">(meilleure série)</span></span>
                  <span title="En moyenne par match : manches gagnées – manches perdues."><b>{seasonInfo[i].avgFor.toFixed(1).replace('.', ',')}</b> – <b>{seasonInfo[i].avgAg.toFixed(1).replace('.', ',')}</b> manches par match <span class="fj-hint">(en moyenne)</span></span>
                  {seasonInfo[i].biggest && <span title="La victoire avec le plus grand écart de manches.">Plus large victoire : <b>{seasonInfo[i].biggest.my}-{seasonInfo[i].biggest.opp}</b> contre {seasonInfo[i].biggest.oppName}</span>}
                </div>
              </div>
              <div class="car-sd-h">Parcours étape par étape</div>
              <div class="car-sd-tours">
                {seasonInfo[i].byTour.map((t) => (
                  <div class="fj-tour-lite">
                    <div class="fj-tour-h"><span class="fj-tour-name">{t.level}{t.city ? ` · ${t.city}` : ''}</span><span class="fj-tour-rec mono">{t.w}-{t.l}</span></div>
                    <div class="fjm-list">
                      {t.ms.map((r) => (
                        <a href={`/femmes/joueur/${slugOf(r.oppId)}`} class={`fjm-row ${r.win ? 'w' : 'l'}`} title={`${r.win ? 'Victoire' : 'Défaite'} ${r.my}-${r.opp} contre ${r.oppName}${frRound(r.round) ? ' · ' + frRound(r.round) : ''}`}>
                          <span class="fjm-res">{r.win ? 'V' : 'D'}</span>
                          <span class="fjm-score mono">{r.my}<i>–</i>{r.opp}</span>
                          <span class="fjm-opp">{r.oppName}</span>
                          {frRound(r.round) && <span class="fjm-round">{frRound(r.round)}</span>}
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      {playerVideos.length > 0 && (
        <>
          <div id="videos" class="sec-head jt-anchor" style="margin-top:34px"><div><div class="eyebrow" style="color:var(--c-billard)">Vidéos</div><h2>Ses matchs en vidéo</h2></div></div>
          <div class="pv-grid">
            {playerVideos.slice(0, 12).map((v) => (
              <a href={`/replay/${v.id}`} class="pv-card">
                <span class="pv-thumb">
                  <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt="" loading="lazy" onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${v.id}/hqdefault.jpg'`} />
                  <span class="pv-play">▶</span>
                </span>
                <span class="pv-txt"><span class="pv-main">{v.main}</span>{v.sub && <span class="pv-sub">{v.sub}</span>}</span>
              </a>
            ))}
          </div>
          {playerVideos.length > 12 && (
            <details class="pv-more">
              <summary>Voir les {playerVideos.length - 12} autres vidéos</summary>
              <div class="pv-grid" style="margin-top:14px">
                {playerVideos.slice(12).map((v) => (
              <a href={`/replay/${v.id}`} class="pv-card">
                <span class="pv-thumb">
                  <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt="" loading="lazy" onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${v.id}/hqdefault.jpg'`} />
                  <span class="pv-play">▶</span>
                </span>
                <span class="pv-txt"><span class="pv-main">{v.main}</span>{v.sub && <span class="pv-sub">{v.sub}</span>}</span>
              </a>
                ))}
              </div>
            </details>
          )}
        </>
      )}

      {arts.length > 0 && (
        <>
          <div class="sec-head" style="margin-top:34px"><div><div class="eyebrow" style="color:var(--c-billard)">Le mag</div><h2>Dans l'actualité</h2></div></div>
          <div class="car-arts">
            {arts.map((a) => (
              <a href={`/actualites/${a.id}`} class="car-art">
                <span class="car-art-t">{a.data.title}</span>
                <span class="car-art-d">{fmtArtDate(a.data.date)}</span>
              </a>
            ))}
          </div>
        </>
      )}

      <div id="confrontations" class="secgroup-lab jt-anchor">Confrontations &amp; résultats</div>
      <div class="secbars">
      {rivals.length > 0 && (
        <>
          <div class="car-sitem">
            <button type="button" class="secbar" data-accordion aria-expanded="false">
              <span class="secbar-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="12" r="4.6" fill="currentColor"></circle><circle cx="16" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="1.8"></circle></svg></span>
              <span class="secbar-txt"><span class="secbar-title">Adversaires les plus fréquentes</span><span class="secbar-sub">Les {rivals.length} joueuses les plus souvent affrontées</span></span>
              <span class="secbar-chev car-schev" aria-hidden="true">▾</span>
            </button>
            <div class="ff-panel" hidden>
          <p class="fj-help" style="margin-top:0"><b>En clair :</b> les joueuses que {name} a le plus souvent affrontées. Le bilan est le sien : <b>V</b> = ses victoires, <b>D</b> = ses défaites face à cette adversaire.</p>
          <div class="car-rivals">
            {rivals.map((r) => (
              <a href={`/femmes/joueur/${slugOf(r.id)}`} class="car-rival">
                <span class="bphoto car-rph"><span class="bavatar">{r.name.slice(0, 1)}</span>{r.photo && <img src={r.photo} alt="" loading="lazy" onerror="this.remove()" />}</span>
                <span class="car-rn">{r.name}</span>
                <span class="car-rrec"><span class="rec-w">{r.w}<em>V</em></span> <i>–</i> <span class="rec-l">{r.l}<em>D</em></span></span>
                <span class="car-rn2">{r.n} match{r.n > 1 ? 's' : ''}</span>
              </a>
            ))}
          </div>
            </div>
          </div>
        </>
      )}

      {allOpp.length > 0 && (
        <>
          <div class="car-sitem">
            <button type="button" class="secbar" data-accordion aria-expanded="false">
              <span class="secbar-ic"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><circle cx="12" cy="6" r="1.9"></circle><circle cx="8.7" cy="11" r="1.9"></circle><circle cx="15.3" cy="11" r="1.9"></circle><circle cx="5.4" cy="16" r="1.9"></circle><circle cx="12" cy="16" r="1.9"></circle><circle cx="18.6" cy="16" r="1.9"></circle></svg></span>
              <span class="secbar-txt"><span class="secbar-title">Toutes les adversaires affrontées</span><span class="secbar-sub">{allOpp.length} joueuses rencontrées sur toutes les saisons</span></span>
              <span class="secbar-chev car-schev" aria-hidden="true">▾</span>
            </button>
            <div class="ff-panel" hidden>
          <p class="fj-help" style="margin-top:0"><b>{allOpp.length}</b> joueuse{allOpp.length > 1 ? 's' : ''} rencontrée{allOpp.length > 1 ? 's' : ''} par {name} sur l'ensemble des saisons. Le bilan est le sien — <b>V</b> = ses victoires, <b>D</b> = ses défaites — cliquez sur une adversaire pour dérouler le détail de chaque match (score · étape · saison).</p>
          <div class="opp-list">
            {allOpp.map((o) => (
              <div class="opp-item">
                <button type="button" class="opp-item-h" data-accordion aria-expanded="false">
                  <span class="opp-who">
                    <span class="bphoto opp-ph"><span class="bavatar">{o.name.slice(0, 1)}</span>{o.photo && <img src={o.photo} alt="" loading="lazy" onerror="this.remove()" />}</span>
                    <span class="opp-name">{o.name}</span>
                  </span>
                  <span class="opp-rec"><span class="rec-w">{o.w}<em>V</em></span> <i>–</i> <span class="rec-l">{o.l}<em>D</em></span></span>
                  <span class="opp-chev car-schev" aria-hidden="true">▾</span>
                </button>
                <div class="opp-enc" hidden>
                  {o.enc.map((e) => (
                    <span class={`opp-e ${e.win ? 'w' : 'l'}`} title={`${e.win ? 'Victoire' : 'Défaite'} ${e.my}-${e.opp}`}>
                      <b>{e.my}-{e.opp}</b> · {e.level}{e.city ? ` ${e.city}` : ''} · {e.seasonLabel}
                    </span>
                  ))}
                  <a href={`/femmes/joueur/${slugOf(o.id)}`} class="opp-fiche">Voir la fiche de {o.name} →</a>
                </div>
              </div>
            ))}
          </div>
            </div>
          </div>
        </>
      )}

      <div class="car-sitem">
        <button type="button" id="histo" class="secbar" data-accordion aria-expanded="false" style="scroll-margin-top:20px">
          <span class="secbar-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7.5" cy="16.5" r="4" fill="currentColor"></circle><line x1="11" y1="13" x2="21" y2="3" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></line></svg></span>
          <span class="secbar-txt"><span class="secbar-title">Derniers résultats</span><span class="secbar-sub">Les {recent.length} matchs les plus récents</span></span>
          <span class="secbar-chev car-schev" aria-hidden="true">▾</span>
        </button>
        <div class="ff-panel" hidden>
          <div class="bmatches">
            {recent.map((r) => {
              const t = (r.R.tournaments as any[]).find((x) => x.id === r.tid);
              return (
                <div class={`bmatch ${r.win ? 'w' : 'l'}`} data-card-href={`/femmes/joueur/${slugOf(r.oppId)}`}>
                  <span class="bm-tag">{r.win ? 'V' : 'D'}</span>
                  <span class="bm-score mono">{r.my} — {r.opp}</span>
                  <a href={`/femmes/joueur/${slugOf(r.oppId)}`} class="bm-opp">{r.oppName}</a>
                  <span class="bm-meta">{frRound(r.round)} · {t?.level} {t?.city} · {r.label}</span>
                </div>
              );
            })}
          </div>
        </div>
      </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* « Ses matchs en vidéo » — grille de vignettes YouTube */
  .pv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; margin-top: 4px; }
  .pv-card { display: flex; flex-direction: column; text-decoration: none; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--surface); transition: border-color .15s, transform .15s, box-shadow .15s; }
  .pv-card:hover { border-color: var(--c-billard); transform: translateY(-3px); box-shadow: 0 8px 20px color-mix(in srgb, var(--c-billard) 16%, transparent); }
  .pv-thumb { position: relative; aspect-ratio: 16 / 9; background: #0A0E1A; overflow: hidden; }
  .pv-thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pv-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 42px; height: 42px; border-radius: 50%; background: rgba(228,0,43,.92); color: #fff; font-size: 15px; display: grid; place-items: center; padding-left: 3px; box-shadow: 0 4px 14px rgba(0,0,0,.4); transition: transform .15s; }
  .pv-card:hover .pv-play { transform: translate(-50%, -50%) scale(1.08); }
  .pv-txt { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 3px; }
  .pv-main { font-family: var(--display); font-weight: 800; font-size: 14px; line-height: 1.12; color: var(--ink); text-transform: uppercase; }
  .pv-sub { font-size: 11px; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; color: var(--ink-faint); }
  @supports not (aspect-ratio: 16 / 9) { .pv-thumb { min-height: 112px; } }
  .pv-more { margin-top: 14px; }
  .pv-more > summary { display: inline-flex; align-items: center; gap: 7px; cursor: pointer; list-style: none; font-weight: 700; font-size: 13px; color: var(--c-billard); background: #eef5fd; background: color-mix(in srgb, var(--c-billard) 8%, #fff); border: 1px solid #cfe0f3; border: 1px solid color-mix(in srgb, var(--c-billard) 22%, var(--line)); border-radius: 999px; padding: 8px 16px; width: fit-content; }
  .pv-more > summary::-webkit-details-marker { display: none; }
  .pv-more > summary::before { content: "▾"; font-size: 11px; transition: transform .15s; }
  .pv-more[open] > summary::before { transform: rotate(180deg); }
  .pv-more > summary:hover { background: #e3eefb; background: color-mix(in srgb, var(--c-billard) 14%, #fff); }

  /* --- Bandeau « Profil » : évolution du classement + bête noire / client favori --- */
  .prof-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 14px; align-items: start; }
  @media (max-width: 760px) { .prof-grid { grid-template-columns: 1fr; } }
  .prof-card { background: color-mix(in srgb, var(--c-billard) 5%, #fff); border: 1px solid color-mix(in srgb, var(--c-billard) 18%, #e6e8ec); border-radius: 14px; padding: 14px 16px; }
  .prof-card-h { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-faint); margin-bottom: 8px; }
  .prof-best { color: #b8860b; font-weight: 800; white-space: nowrap; }
  .prof-spark { width: 100%; height: 132px; display: block; }
  .prof-spark-lbl { fill: var(--ink-faint); font-size: 9px; font-weight: 700; }
  .prof-badges { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 10px; }
  .prof-badge { background: #fff; border: 1px solid #e6e8ec; border-radius: 999px; padding: 5px 10px; font-size: 12.5px; font-weight: 700; color: var(--ink); }
  .prof-duo { display: grid; gap: 14px; }
  .prof-vs { display: flex; align-items: center; gap: 12px; }
  .prof-vs-av { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 16px; text-decoration: none; flex: none; background: #f1f3f6; color: var(--ink); }
  .prof-vs-av.bad { color: #d64545; background: #fbeced; } .prof-vs-av.good { color: #1b9c63; background: #e9f7f0; }
  .prof-vs-body { min-width: 0; }
  .prof-tag { display: inline-block; font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: 2px 8px; border-radius: 6px; }
  .prof-tag.bad { background: #fbeced; color: #d64545; } .prof-tag.good { background: #e9f7f0; color: #1b9c63; }
  .prof-vs-nm { display: block; font-weight: 800; color: var(--ink); text-decoration: none; margin-top: 3px; }
  .prof-vs-nm:hover { color: var(--c-billard); }
  .prof-vs-rec { font-size: 12.5px; color: var(--ink-faint); } .prof-vs-rec b { color: var(--ink); }
  .prof-chart { position: relative; }
  .prof-rank-val { fill: var(--ink); font-size: 11px; font-weight: 800; }
  .prof-rank-val.n1 { fill: #b8860b; }
  .prof-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; margin-top: 6px; font-size: 12px; color: var(--ink-faint); }
  .prof-legend i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; vertical-align: middle; margin-right: 4px; }
  .prof-legend i.d1 { background: #f0b429; } .prof-legend i.d { background: var(--c-billard); }
  .prof-legend-hint { margin-left: auto; font-style: italic; opacity: .75; }
  .car-scope { margin: 4px 0 10px; font-size: 13px; color: var(--ink-faint); }
  .car-scope-tag { display: inline-block; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; color: var(--c-billard); background: color-mix(in srgb, var(--c-billard) 12%, #fff); border-radius: 6px; padding: 2px 8px; margin-right: 6px; }
  .car-scope-sub { opacity: .8; }
  @media (max-width: 560px) { .car-scope-sub { display: none; } }

  /* ===== Héros « bleu feutre » PLEINE LARGEUR (B · NBA × Portrait) ===== */
  .jfiche { padding-top: 0; }
  .jh { --jh-gold: #e9c45a; position: relative; overflow: hidden; color: #fff; border-top: 3px solid var(--jh-gold);
    background: linear-gradient(180deg, var(--jh-c1, #1d5176) 0%, var(--jh-c2, #103349) 100%); }
  .jh::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,.055) 1px, transparent 0); background-size: 24px 24px; }
  .jh-geo { position: absolute; inset: 0; pointer-events: none; }
  .jh-geo svg { width: 100%; height: 100%; display: block; }
  .jh-club-wm { position: absolute; left: 36%; top: 50%; transform: translate(-50%, -50%); height: 460px; width: auto; max-width: 60%; object-fit: contain; opacity: .05; pointer-events: none; z-index: 0; }
