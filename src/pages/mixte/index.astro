---
// On atterrit sur la dernière saison AVEC des résultats (bascule auto vers la nouvelle
// dès son premier tournoi joué) — évite d'arriver sur une saison « à venir » encore vide.
import { mixteShowcaseSeason } from '../../data/billard/seasonsMixte';
const target = '/mixte/saison/' + mixteShowcaseSeason().slug;
---
<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <script is:inline set:html={`location.replace(${JSON.stringify(target)})`}></script>
    <style>html,body{margin:0;min-height:100vh;background:#0C0E13}</style>
    <title>LSEI — Le Sport en Image</title>
  </head>
  <body></body>
</html>
