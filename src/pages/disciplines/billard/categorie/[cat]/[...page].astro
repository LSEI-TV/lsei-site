---
import Base from '../../../../../layouts/Base.astro';
import { assetExists } from '../../../../../lib/publicAssets';
import VideoGrid from '../../../../../components/VideoGrid.astro';
import FilterMenu from '../../../../../components/FilterMenu.astro';
import DisciplineNav from '../../../../../components/DisciplineNav.astro';
import { disciplines } from '../../../../../data/site';
import { getReplays, getBillardCategories, categorySlug, seasonSlug, CATEGORY_INTRO, type Video } from '../../../../../lib/youtube';
import type { GetStaticPaths, Page } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const all = await getReplays({ discipline: 'billard' });
  const cats = await getBillardCategories();
  const routes = [];
  for (const c of cats) {
    const vids = all.filter((v) => v.category === c.category);
    routes.push(...paginate(vids, { params: { cat: categorySlug(c.category) }, props: { category: c.category }, pageSize: 24 }));
  }
  return routes;
}) satisfies GetStaticPaths;

const { page, category } = Astro.props as { page: Page<Video>; category: string };
const disc = disciplines.find((d) => d.slug === 'billard')!;
// Texte propre à la catégorie (SEO) ; repli sur le chapô billard si non défini.
const catText = CATEGORY_INTRO[category] || disc.blurb;

const cats = await getBillardCategories();
const categoryOptions = [
  { label: 'Toutes les catégories', value: '/disciplines/billard' },
  ...cats.map((c) => ({ label: `${c.category} · ${c.count}`, value: `/disciplines/billard/categorie/${categorySlug(c.category)}`, selected: c.category === category })),
];

// Saisons présentes dans cette catégorie → filtre « Saison ».
const catSlug = categorySlug(category);
// Bandeau hero par catégorie (repli sombre si le fichier n'est pas déposé).
const CATEGORY_HERO: Record<string, string> = {
  snooker: '/billard/snooker-hero.webp',
  'billard-americain': '/billard/americain-hero.webp',
};
const catHero = CATEGORY_HERO[catSlug];
const catVids = (await getReplays({ discipline: 'billard' })).filter((v) => v.category === category);
const seasons = [...new Set(catVids.map((v) => v.season).filter(Boolean))].sort().reverse() as string[];
const seasonOptions = [
  { label: 'Toutes les saisons', value: `/disciplines/billard/categorie/${catSlug}`, selected: true },
  ...seasons.map((s) => ({ label: `${s} · ${catVids.filter((v) => v.season === s).length}`, value: `/disciplines/billard/categorie/${catSlug}/saison/${seasonSlug(s)}` })),
];
---
<Base title={`Billard — ${category}`} description={catText} preloadImage={assetExists(catHero) ? catHero : undefined} active="disciplines" image={catVids[0]?.thumb}>
  <section class={`disc-hero${catHero ? ' disc-hero--banner' : ''}`}>
    <div class="wrap" style={`--dc:${disc.colorVar}${catHero ? `;--hero-img:url('${catHero}')` : ''}`}>
      <div class="kick">{disc.label} · {category}</div>
      <h1>{disc.name} — {category}</h1>
      <p>{catText}</p>
      <div class="bar"></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style={`--dc:${disc.colorVar}`}>
      <div class="filter-bar">
        <FilterMenu label="Catégorie" options={categoryOptions} colorVar={disc.colorVar} />
        {seasons.length > 0 && <FilterMenu label="Saison" options={seasonOptions} colorVar={disc.colorVar} />}
      </div>
      <div class="sec-head">
        <div class="eyebrow">{page.total} vidéos · {category}</div>
        <DisciplineNav active="billard" />
      </div>

      <VideoGrid page={page} />
    </div>
  </section>
</Base>
