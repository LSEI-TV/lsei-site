---
import Base from '../../../../../layouts/Base.astro';
import VideoGrid from '../../../../../components/VideoGrid.astro';
import FilterMenu from '../../../../../components/FilterMenu.astro';
import DisciplineNav from '../../../../../components/DisciplineNav.astro';
import { disciplines } from '../../../../../data/site';
import { getReplays, getSeasonCounts, seasonSlug, seasonShort, type Video } from '../../../../../lib/youtube';
import type { GetStaticPaths, Page } from 'astro';
import { assetExists } from '../../../../../lib/publicAssets';
import ClubShowcase from '../../../../../components/ClubShowcase.astro';
import { clubForDiscipline } from '../../../../../data/clubs';

export const getStaticPaths = (async ({ paginate }) => {
  const routes = [];
  for (const d of disciplines) {
    const all = await getReplays({ discipline: d.slug });
    const seasons = await getSeasonCounts(d.slug);
    for (const s of seasons) {
      const vids = all.filter((v) => v.season === s.season);
      routes.push(...paginate(vids, { params: { slug: d.slug, season: seasonSlug(s.season) }, props: { disc: d, season: s.season }, pageSize: 24 }));
    }
  }
  return routes;
}) satisfies GetStaticPaths;

const { page, disc, season } = Astro.props as { page: Page<Video>; disc: (typeof disciplines)[number]; season: string };
const club = clubForDiscipline(disc.slug);

const seasonCounts = await getSeasonCounts(disc.slug);
const seasonOptions = [
  { label: 'Toutes les saisons', value: `/disciplines/${disc.slug}` },
  ...seasonCounts.map((s) => ({ label: `${s.season} · ${s.count}`, value: `/disciplines/${disc.slug}/saison/${seasonSlug(s.season)}`, selected: s.season === season })),
];
---
<Base title={`${club ? club.name : disc.name} — Saison ${season}`} description={`Les matchs de la saison ${season}.`} preloadImage={club?.hero ?? (assetExists(disc.hero) ? disc.hero : undefined)} active="disciplines">
  {club ? (
    <ClubShowcase club={club} matchs={page.total} saisons={seasonCounts.length} showIntro={false} />
  ) : (
    <section class={`disc-hero${disc.hero ? ' disc-hero--banner' : ''}`}>
      <div class="wrap" style={`--dc:${disc.colorVar}${disc.hero ? `;--hero-img:url('${disc.hero}')` : ''}`}>
        <div class="kick">{disc.label} · Saison {season}</div>
        <h1>{disc.name}</h1>
        <p>{disc.blurb}</p>
        <div class="bar"></div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap" style={`--dc:${disc.colorVar}`}>
      <div class="filter-bar"><FilterMenu label="Saison" options={seasonOptions} colorVar={disc.colorVar} /></div>
      <div class="sec-head">
        <div class="eyebrow">{page.total} vidéos · saison {season}</div>
        <DisciplineNav active={disc.slug} />
      </div>

      <VideoGrid page={page} />
    </div>
  </section>
</Base>
