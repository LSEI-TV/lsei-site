---
import Base from '../../layouts/Base.astro';
import HubNav from '../../components/HubNav.astro';
import PlayerSearch from '../../components/PlayerSearch.astro';
import { photoOf, playerSlugs, photoOnlySeasons, playersByPhotoKey } from '../../lib/billardStats';
import { getSeasons, LANDING_SEASON, DEFAULT_SEASON } from '../../data/billard/seasons';

const seasons = getSeasons().filter((s) => s.results); // saisons avec données (récent → ancien)
const { slugOf } = playerSlugs(getSeasons());
const byPhotoKey = playersByPhotoKey(getSeasons()); // relier une photo d'archive à une fiche connue

// Une galerie par saison AVEC données : effectif de la saison (photo de l'année + nom + lien fiche).
// Les PERMANENTS composent la galerie principale ; les INVITÉS (wildcards, qui
// changent à chaque Tournoi National) sont regroupés par étape, en dessous.
const card = (p: any, slug: string) => ({ name: p.name, url: photoOf(p, slug), link: `/billard/joueur/${slugOf(p.id)}` });
const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name, 'fr');
const dataGal = seasons.map((s) => {
  const all = s.results!.players as any[];
  const permanents = all.filter((p) => !p.invite);
  const invites = all.filter((p) => p.invite);
  const matches = (s.results!.matches as any[]) ?? [];
  // Invités regroupés par tournoi, dans l'ordre des étapes (un invité = rattaché
  // aux tournois où il a au moins un match).
  const guestGroups = ((s.results!.tournaments as any[]) ?? [])
    .map((t) => {
      const ids = new Set(matches.filter((m) => m.tid === t.id).flatMap((m) => [m.aId, m.bId]));
      return { tournament: t, players: invites.filter((p) => ids.has(p.id)).map((p) => card(p, s.slug)).sort(byName) };
    })
    .filter((g) => g.players.length > 0);
  return {
    slug: s.slug,
    label: s.label,
    players: permanents.map((p) => card(p, s.slug)).sort(byName),
    guestGroups,
  };
});

// Une galerie par saison SANS données : photos seules (nom de fichier), reliées à une fiche si le joueur est connu.
const rawPhoto = photoOnlySeasons(new Set(seasons.map((s) => s.slug)));
const photoGal = rawPhoto.map((g) => ({
  slug: g.slug,
  label: g.label,
  players: g.players.map((pl) => {
    const k = byPhotoKey.get(pl.key);
    return { name: k?.name || pl.name, url: pl.url, link: k ? `/billard/joueur/${slugOf(k.id)}` : null };
  }),
  guestGroups: [] as { tournament: any; players: { name: string; url: string | null; link: string | null }[] }[],
}));

const galleries = [...dataGal, ...photoGal].sort((a, b) => (a.slug < b.slug ? 1 : -1)); // récent → ancien

// Total global : uniquement les PERMANENTS (les invités, wildcards de passage qui
// changent à chaque étape, sont comptés à part dans leurs sous-sections). Évite que
// le total gonfle artificiellement au fil de la saison.
const uniq = new Set<number>();
for (const s of seasons) for (const p of s.results!.players as any[]) if (!p.invite) uniq.add(p.id);
---
<Base title="Archives des joueurs — Blackball Master" description="Tous les joueurs qui ont composé le Blackball Master, saison après saison, en images." active="disciplines">
  <HubNav season={LANDING_SEASON} dataSeason={DEFAULT_SEASON} active="archives" archivesHref="/billard/archives" />
  <section class="disc-hero" style="--dc:var(--c-billard)">
    <div class="wrap">
      <div class="kick" style="color:var(--c-billard)">Blackball Master · Archives</div>
      <h1>Archives des joueurs</h1>
      <p><b>{uniq.size} joueurs</b> ont composé le Blackball Master, saison après saison. Cliquez sur un joueur pour ouvrir sa fiche carrière.</p>
      <div class="bar" style="background:var(--c-billard)"></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:900px">
      <div style="max-width:460px;margin-bottom:24px"><PlayerSearch placeholder="Rechercher un joueur…" /></div>

      {galleries.map((g) => {
        const hasGuests = g.guestGroups && g.guestGroups.length > 0;
        const galItem = (pl: { name: string; url: string | null; link: string | null }) => {
          const inner = (
            <>
              <span class="bphoto gal-ph"><span class="bavatar">{pl.name.slice(0, 1)}</span>{pl.url && <img src={pl.url} alt="" loading="lazy" onerror="this.remove()" />}</span>
              <span class="gal-name">{pl.name}</span>
            </>
          );
          return pl.link ? <a href={pl.link} class="gal-item">{inner}</a> : <span class="gal-item gal-item-off">{inner}</span>;
        };
        return (
          <div class="gal-season">
            <div class="gal-season-h">Saison {g.label} · {g.players.length} {hasGuests ? 'permanents' : 'joueurs'}</div>
            <div class="gal-grid">{g.players.map(galItem)}</div>
            {hasGuests && g.guestGroups.map((grp) => (
              <div class="gal-guests">
                <div class="gal-guests-h">Invités · {[grp.tournament.level, grp.tournament.city].filter(Boolean).join(' · ')}</div>
                <div class="gal-grid">{grp.players.map(galItem)}</div>
              </div>
            ))}
          </div>
        );
      })}
    </div>
  </section>

  <style>
    /* Sous-section « Invités » (wildcards par étape), sous la galerie des permanents. */
    .gal-guests { margin-top: 20px; }
    .gal-guests-h { font-size: 11.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #b08400; margin-bottom: 12px; padding-left: 10px; border-left: 3px solid #F6C454; }
  </style>
</Base>
