---
// /billard/ → redirige vers le hub Billard (choix Blackball / Snooker / Américain).
// Donne une vraie page à l'URL /billard/ (sinon Apache affichait « Index of /billard »,
// le dossier d'assets public/billard/ n'ayant pas de page d'accueil).
const target = '/billard/hub';
---
<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <script is:inline set:html={`location.replace(${JSON.stringify(target)})`}></script>
    <style>html,body{margin:0;min-height:100vh;background:#0C0E13}</style>
    <title>LSEI — Le Sport en Image</title>
  </head>
  <body></body>
</html>
