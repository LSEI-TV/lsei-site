---
import Base from '../../../layouts/Base.astro';
import HubNav from '../../../components/HubNav.astro';
import { getCollection } from 'astro:content';
import { photoOf, fromPov, fmtDate, frRound, playersInText, playerSlugs, seasonSuperlatives } from '../../../lib/billardStats';
import { getReplays } from '../../../lib/youtube';
import { parseProgTitle } from '../../../lib/programmeTitle';
import { titleMatchesPlayer } from '../../../lib/videoMatch';
import { playerVideos as playerVideosFor } from '../../../lib/playerVideos';
import { getSeasons, getPalmares } from '../../../data/billard/seasons';
import clubLogos from '../../../data/billard/club-logos.json';
import playerCutouts from '../../../data/billard/player-cutouts.json';
import playerColors from '../../../data/billard/player-colors.json';
import rmixte2526 from '../../../data/billard/results-mixte-2025-2026.json';
import rmixte2425 from '../../../data/billard/results-mixte-2024-2025.json';
import rmixte2324 from '../../../data/billard/results-mixte-2023-2024.json';

export function getStaticPaths() {
  // URL par slug lisible (christophe-lambert) + ancien lien numérique conservé.
  const { entries } = playerSlugs(getSeasons());
  const paths: any[] = [];
  const used = new Set<string>();
  for (const { id, slug } of entries) {
    used.add(slug);
    paths.push({ params: { id: slug }, props: { pid: id, slug } });
    // Ancienne adresse numérique (/joueur/6524989) : redirection vers l'adresse au nom (liens Google / anciens partages).
    if (slug !== String(id)) paths.push({ params: { id: String(id) }, props: { pid: id, slug, redirect: true } });
  }

  // --- PROMUS d'une saison À VENIR (top 8 du Mixte National), pas encore au Masters. ---
  // On leur crée une fiche « nouveau promu » montrant leur bilan Mixte de l'an passé.
  // Dès que les vrais résultats Masters arriveront (même id Cuescore), la fiche
  // deviendra automatiquement une fiche carrière complète — même URL.
  const MIXTE: Record<string, any> = { '2025-2026': rmixte2526, '2024-2025': rmixte2425, '2023-2024': rmixte2324 };
  const norm = (s: string) => (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '');
  const knownIds = new Set<number>();
  const knownNames = new Set<string>(); // certains joueurs ont un id Cuescore différent Mixte↔Masters
  for (const s of getSeasons()) if (s.results) for (const p of s.results.players as any[]) { knownIds.add(p.id); knownNames.add(norm(p.name)); }
  const slugify = (s: string) => (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  for (const s of getSeasons()) {
    if (s.results) continue; // uniquement les saisons SANS données (à venir)
    const [ya, yb] = s.slug.split('-').map(Number);
    const feeder = MIXTE[`${ya - 1}-${yb - 1}`];
    if (!feeder) continue;
    const promoted = (feeder.players as any[]).slice().sort((a, b) => a.rank - b.rank).slice(0, 8).filter((p) => !knownIds.has(p.id) && !knownNames.has(norm(p.name)));
    for (const p of promoted) {
      // Meilleure série de victoires du joueur dans le Mixte (pour la vitrine).
      const ms = (feeder.matches as any[]).filter((m) => m.aId === p.id || m.bId === p.id).sort((a, b) => (a.date < b.date ? -1 : 1));
      let cur = 0, streak = 0;
      for (const m of ms) { const my = m.aId === p.id ? m.sA : m.sB, opp = m.aId === p.id ? m.sB : m.sA; if (my > opp) { cur++; streak = Math.max(streak, cur); } else cur = 0; }
      const nc = { id: p.id, name: p.name, rank: p.rank, points: p.points, wins: p.wins, losses: p.losses, tourns: p.tourns, played: p.played, streak, feederLabel: `${ya - 1} / ${yb - 1}`, mastersLabel: s.label, mastersSlug: s.slug };
      let base = slugify(p.name) || String(p.id), slug = base, k = 2;
      while (used.has(slug)) slug = `${base}-${k++}`;
      used.add(slug);
      paths.push({ params: { id: slug }, props: { pid: p.id, nc, slug } });
      if (slug !== String(p.id)) paths.push({ params: { id: String(p.id) }, props: { pid: p.id, nc, slug, redirect: true } });
    }
  }
  return paths;
}

const { pid, nc, slug, redirect } = Astro.props as { pid: number; nc?: any; slug: string; redirect?: boolean };
// Site statique : Astro génère une page de redirection immédiate (meta refresh 0 + noindex + canonical).
if (redirect) return Astro.redirect(`/billard/joueur/${slug}/`, 301);
const { slugOf } = playerSlugs(getSeasons());
const seasons = getSeasons().filter((s) => s.results); // récent d'abord

// Saisons où ce joueur apparaît.
const bySeason = seasons
  .map((s) => {
    const R = s.results!;
    const p = (R.players as any[]).find((x) => x.id === pid);
    return p ? { slug: s.slug, label: s.label, status: s.status, p, R } : null;
  })
  .filter(Boolean) as { slug: string; label: string; status: string; p: any; R: any }[];

// Détail complet par saison — pour l'accordéon « saison par saison » (toutes les infos,
// données déjà en mémoire, aucune requête supplémentaire ni page séparée).
const seasonInfo = bySeason.map((x) => {
  const res = (x.R.matches as any[]).filter((m) => m.aId === pid || m.bId === pid).map((m) => fromPov(m, pid));
  const chrono = [...res].sort((a, b) => (a.date < b.date ? -1 : 1));
  const recent = [...res].sort((a, b) => (a.date < b.date ? 1 : -1));
  let best = 0, cur = 0;
  for (const r of chrono) { if (r.win) { cur++; best = Math.max(best, cur); } else cur = 0; }
  const wins = res.filter((r) => r.win);
  const biggest = wins.length ? wins.reduce((b, r) => ((r.my - r.opp) > (b.my - b.opp) ? r : b)) : null;
  const n = res.length || 1;
  const avgFor = res.reduce((s, r) => s + r.my, 0) / n;
  const avgAg = res.reduce((s, r) => s + r.opp, 0) / n;
  // Parcours UNIFIÉ, étape par étape (ordre du calendrier) : détail match par match
  // quand on l'a, sinon résultat en points (place déduite + 🏆 si vainqueur de l'étape).
  const ptsByLevel = new Map<string, number[]>();
  for (const pl of x.R.players as any[]) for (const e of (pl.events || [])) {
    (ptsByLevel.get(e.level) || ptsByLevel.set(e.level, []).get(e.level)!).push(e.points);
  }
  const selfEv = new Map(((x.p.events || []) as any[]).map((e) => [e.level, e]));
  // Étapes remportées (fiable) : tournois où le joueur a gagné le dernier tour —
  // indépendant du champ « winner » du tournoi, souvent non renseigné en cours de saison.
  const _wonTids = new Set<number>();
  { const _mr = (x.R.matches as any[]).filter((m) => (m.aId === pid || m.bId === pid) && m.roundNo != null);
    for (const _tid of [...new Set(_mr.map((m) => m.tid))]) {
      const _all = (x.R.matches as any[]).filter((m) => m.tid === _tid && m.roundNo != null);
      if (!_all.length) continue;
      const _max = Math.max(..._all.map((m) => m.roundNo));
      const _fin = _mr.find((m) => m.tid === _tid && m.roundNo === _max);
      if (_fin && (_fin.aId === pid ? _fin.sA > _fin.sB : _fin.sB > _fin.sA)) _wonTids.add(_tid);
    } }
  const parcours = (x.R.tournaments as any[])
    .map((t) => {
      const tms = res.filter((r) => r.tid === t.id).sort((a, b) => (a.date < b.date ? -1 : 1));
      const pev: any = selfEv.get(t.level);
      if (!tms.length && !pev) return null;
      const place = pev ? 1 + (ptsByLevel.get(t.level) || []).filter((v) => v > pev.points).length : null;
      return {
        level: t.level, city: t.city, points: pev ? pev.points : null, place,
        won: _wonTids.has(t.id) || !!(t.winner && t.winner.id === pid),
        w: tms.filter((r) => r.win).length, l: tms.filter((r) => !r.win).length, ms: tms,
      };
    })
    .filter(Boolean) as { level: string; city: string; points: number | null; place: number | null; won: boolean; w: number; l: number; ms: any[] }[];
  const evWins = parcours.filter((p) => p.won).length;
  return { parcours, best, biggest, avgFor, avgAg, form: recent.slice(0, 5), evWins };
});

const latest = bySeason[0];
const name = nc ? nc.name : latest.p.name;
const photo = nc ? null : photoOf(latest.p, latest.slug);
const ncPhoto = nc ? photoOf({ name: nc.name } as any, nc.mastersSlug) : null;
// A quitté le Masters ? Oui si sa dernière saison n'est pas la saison jouée la plus récente.
const leftAfter = !nc && latest.slug !== seasons[0].slug ? latest.label : null;

// Invité (wildcard) : sa « provenance » est le Mixte National de l'an passé (feeder),
// d'où il est invité. On affiche son bilan Mixte 2025/2026 sur sa fiche.
const _gn = (s: string) => (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '');
const GUEST_FEEDER: Record<string, any> = { '2026-2027': rmixte2526, '2025-2026': rmixte2425, '2024-2025': rmixte2324 };
let guestOrigin: any = null;
if (!nc && latest?.p?.invite) {
  const [gya, gyb] = latest.slug.split('-').map(Number);
  const feeder = GUEST_FEEDER[latest.slug];
  const mp = feeder && (feeder.players as any[]).find((x) => x.id === pid || _gn(x.name) === _gn(name));
  if (mp) guestOrigin = { label: `${gya - 1} / ${gyb - 1}`, mastersLabel: latest.label, rank: mp.rank, points: mp.points, wins: mp.wins, losses: mp.losses, played: mp.played, tourns: mp.tourns };
}

// Cumuls carrière (toutes saisons).
const career = bySeason.reduce(
  (a, x) => {
    a.played += x.p.played; a.wins += x.p.wins; a.losses += x.p.losses; a.tourns += x.p.tourns;
    return a;
  },
  { played: 0, wins: 0, losses: 0, tourns: 0 },
);
const winPct = career.played ? Math.round((career.wins / career.played) * 100) : 0;
const _ranks = bySeason.map((x) => x.p.rank).filter((r) => r != null);
const bestRank = _ranks.length ? Math.min(..._ranks) : 0;
// Invité au Masters : pas de rang au classement Masters → on affiche son rang au Mixte National.
const guestMixteRank = (latest?.p?.invite && latest?.p?.mixteRank) || null;

// Palmarès personnel : titres (champion de saison / champion de France).
const palm = getPalmares();
const titles: { label: string; slug: string; kind: 'saison' | 'france' }[] = [];
for (const pl of palm) {
  if (pl.champ.id === pid) titles.push({ label: pl.label, slug: pl.slug, kind: 'saison' });
  if (pl.cdf && pl.cdf.id === pid) titles.push({ label: pl.label, slug: pl.slug, kind: 'france' });
}

// Distinctions : pour chaque saison jouée, les « faits marquants » que CE joueur détient.
const allSeasonsList = getSeasons();
const distinctions: { label: string; value: string; sub?: string; seasonLabel: string }[] = [];
for (const x of bySeason) {
  const i = allSeasonsList.findIndex((s) => s.slug === x.slug);
  const prev = allSeasonsList.slice(i + 1).find((s) => s.results);
  for (const sup of seasonSuperlatives(x.R, prev?.results)) {
    if (sup.playerId === pid) distinctions.push({ label: sup.label, value: sup.value, sub: sup.sub, seasonLabel: x.label });
  }
}

// Confrontations carrière : bilan cumulé + détail (quand / où) face à chaque adversaire.
interface Enc { seasonLabel: string; slug: string; level: string; city: string; my: number; opp: number; win: boolean; date: string }
const oppMap = new Map<number, { name: string; w: number; l: number; n: number; enc: Enc[] }>();
for (const x of bySeason) {
  const tById = new Map((x.R.tournaments as any[]).map((t) => [t.id, t]));
  for (const m of (x.R.matches as any[]).filter((m) => m.aId === pid || m.bId === pid)) {
    const r = fromPov(m, pid);
    let e = oppMap.get(r.oppId);
    if (!e) { e = { name: r.oppName, w: 0, l: 0, n: 0, enc: [] }; oppMap.set(r.oppId, e); }
    e.n++; r.win ? e.w++ : e.l++;
    const t: any = tById.get(r.tid) || {};
    e.enc.push({ seasonLabel: x.label, slug: x.slug, level: t.level || '', city: t.city || '', my: r.my, opp: r.opp, win: r.win, date: r.date });
  }
}
const allOpp = [...oppMap.entries()]
  .map(([id, e]) => ({ id, ...e, photo: photoOf({ name: e.name } as any), enc: [...e.enc].sort((a, b) => (a.date < b.date ? 1 : -1)) }))
  .sort((a, b) => b.n - a.n || b.w - a.w || a.name.localeCompare(b.name, 'fr'));
const rivals = allOpp.slice(0, 8);

// Derniers résultats, toutes saisons confondues (plus récents d'abord).
const allResults: any[] = [];
for (const x of bySeason) {
  for (const m of (x.R.matches as any[]).filter((m) => m.aId === pid || m.bId === pid)) {
    allResults.push({ ...fromPov(m, pid), slug: x.slug, label: x.label, R: x.R });
  }
}
allResults.sort((a, b) => (a.date < b.date ? 1 : -1));
const recent = allResults.slice(0, 6);

// Hero « magazine » : meilleure série carrière, plus large victoire, dernier match.
const careerChrono = [...allResults].sort((a, b) => (a.date < b.date ? -1 : 1));
let careerStreak = 0, _run = 0;
for (const r of careerChrono) { if (r.win) { _run++; careerStreak = Math.max(careerStreak, _run); } else _run = 0; }
const careerWins = allResults.filter((r) => r.win);
const biggestCareer = careerWins.length ? careerWins.reduce((b, r) => ((r.my - r.opp) > (b.my - b.opp) ? r : b)) : null;
const lastMatch = allResults[0] || null;
const lastTour = lastMatch ? (lastMatch.R.tournaments as any[]).find((t: any) => t.id === lastMatch.tid) : null;
const lastOppPhoto = lastMatch ? photoOf({ name: lastMatch.oppName } as any) : null;

// ---------- Bandeau « Profil » : évolution du classement + bête noire / client favori ----------
// Rang par saison, du plus ancien au plus récent (pour la courbe). Les invités (rang null) sont ignorés.
const rankSeries = bySeason.filter((x) => x.p.rank != null).map((x) => ({ season: x.label, rank: x.p.rank as number, slug: x.slug })).reverse();
const shortSeason = (s: string) => { const d = (s || '').replace(/\D/g, ''); return d.length >= 8 ? `${d.slice(2, 4)}-${d.slice(6, 8)}` : s; };
// Adversaires contre qui il a le plus de VICTOIRES / de DÉFAITES (par nombre de matchs).
const _byWin = [...allOpp].filter((o) => o.w > 0).sort((a, b) => b.w - a.w || a.l - b.l || b.n - a.n);
const _byLoss = [...allOpp].filter((o) => o.l > 0).sort((a, b) => b.l - a.l || a.w - b.w || b.n - a.n);
const clientOk = _byWin[0] || null;                                                      // le plus de victoires
const beteOk = (_byLoss.find((o) => !clientOk || o.id !== clientOk.id)) || null;         // le plus de défaites (adversaire différent)
// Finales atteintes + tournois gagnés (toutes saisons).
let finalesCount = 0, tournamentWins = 0;
for (const x of bySeason) {
  const mine = (x.R.matches as any[]).filter((m) => (m.aId === pid || m.bId === pid) && m.roundNo != null);
  for (const tid of [...new Set(mine.map((m) => m.tid))]) {
    const allT = (x.R.matches as any[]).filter((m) => m.tid === tid && m.roundNo != null);
    if (!allT.length) continue;
    const maxR = Math.max(...allT.map((m) => m.roundNo));
    const fin = mine.find((m) => m.tid === tid && m.roundNo === maxR);
    if (fin) { finalesCount++; const won = fin.aId === pid ? fin.sA > fin.sB : fin.sB > fin.sA; if (won) tournamentWins++; }
  }
}

// En-tête « héros » : épithète (statut) pour le bandeau.
const cdfCount = titles.filter((t) => t.kind === 'france').length;
const seasonChampCount = titles.filter((t) => t.kind === 'saison').length;
const _ep: string[] = [];
if (cdfCount) _ep.push(cdfCount > 1 ? `Champion de France ×${cdfCount}` : 'Champion de France');
else if (seasonChampCount) _ep.push(seasonChampCount > 1 ? `Champion de saison ×${seasonChampCount}` : 'Champion de saison');
if (bestRank === 1) _ep.push(latest.p.rank === 1 ? 'N°1 actuel' : 'Ex N°1');
else if (!_ep.length && bestRank && bestRank <= 3) _ep.push('Habitué du podium');
else if (!_ep.length && tournamentWins) _ep.push('Vainqueur de tournoi');
if (!_ep.length) _ep.push('Blackball Master');
const epithet = _ep.slice(0, 2).join(' · ');
const _statusTxt = leftAfter ? `parti après ${leftAfter}` : (latest.p.rank ? `actuellement N°${latest.p.rank}` : 'en activité');
const _nm = name.trim().split(/\s+/);
const heroFirst = _nm.length > 1 ? _nm[0] : '';
const heroLast = _nm.length > 1 ? _nm.slice(1).join(' ') : name;
// Plus long mot du prénom / du nom : le nom se réduit pour ne jamais déborder de sa colonne (cf. .jh-name).
const _longest = (t: string) => Math.max(1, ...String(t || '').split(/[\s-]+/).map((w) => w.length));
const heroFit = `--fw:${_longest(heroFirst)};--lw:${_longest(heroLast)}`;
const _clubKey = (clubLogos as Record<string, string>)[String(pid)];
const clubLogo = _clubKey ? `/billard/clubs/${_clubKey}.png` : null;
const _cutoutKey = (playerCutouts as Record<string, string>)[String(pid)];
const cutout = _cutoutKey ? `/billard/cutouts/${_cutoutKey}.png` : null;   // photo détourée (fond transparent) → flotte sans cadre
// Couleur du bandeau = couleur du polo du joueur (extraite de sa photo), sinon bleu par défaut.
const _pc = (playerColors as Record<string, { band: string; band2: string }>)[String(pid)];
const heroBand = _pc ? { c1: _pc.band, c2: _pc.band2, eband: _pc.band2 } : { c1: '#1d5176', c2: '#103349', eband: '#0d2c49' };

// Étapes gagnées sur la saison la plus récente — déterminées par le dernier tour
// remporté (fiable même si le champ « winner » du tournoi n'est pas renseigné).
let stageWinsLatest = 0;
if (bySeason.length) {
  const _xr = bySeason[0].R;
  const _mr = (_xr.matches as any[]).filter((m) => (m.aId === pid || m.bId === pid) && m.roundNo != null);
  for (const _tid of [...new Set(_mr.map((m) => m.tid))]) {
    const _all = (_xr.matches as any[]).filter((m) => m.tid === _tid && m.roundNo != null);
    if (!_all.length) continue;
    const _max = Math.max(..._all.map((m) => m.roundNo));
    const _fin = _mr.find((m) => m.tid === _tid && m.roundNo === _max);
    if (_fin && (_fin.aId === pid ? _fin.sA > _fin.sB : _fin.sB > _fin.sA)) stageWinsLatest++;
  }
}
// Courbe du classement en SVG, rendue côté serveur (bon pour le SEO, aucun JS client).
const _rkMax = rankSeries.length ? Math.max(...rankSeries.map((r) => r.rank), 2) : 2;
const _rkW = 600, _rkH = 132, _rkPX = 16, _rkPT = 24, _rkPB = 26;
const _rkX = (i: number) => (rankSeries.length > 1 ? _rkPX + i * ((_rkW - 2 * _rkPX) / (rankSeries.length - 1)) : _rkW / 2);
const _rkY = (r: number) => _rkPT + ((r - 1) / (_rkMax - 1)) * (_rkH - _rkPT - _rkPB);
const rkLine = rankSeries.map((p, i) => (i ? 'L' : 'M') + _rkX(i).toFixed(1) + ' ' + _rkY(p.rank).toFixed(1)).join(' ');
const rkArea = rankSeries.length ? `M${_rkX(0).toFixed(1)} ${_rkH - _rkPB} ` + rankSeries.map((p, i) => `L${_rkX(i).toFixed(1)} ${_rkY(p.rank).toFixed(1)}`).join(' ') + ` L${_rkX(rankSeries.length - 1).toFixed(1)} ${_rkH - _rkPB} Z` : '';
const showProfil = !nc && (rankSeries.length >= 2 || !!beteOk || !!clientOk);

// Articles qui mentionnent ce joueur (reliage éditorial automatique par le nom).
const arts = (await getCollection('articles', ({ data }) => !data.draft && data.date.valueOf() <= Date.now() && data.discipline === 'billard'))
  .filter((a) => playersInText(`${a.data.title} ${a.data.excerpt} ${a.body}`).some((x) => x.id === pid))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const fmtArtDate = (dt: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(dt);

// « Ses vidéos » : vidéos YouTube billard où le joueur apparaît (match filmé « A vs B » ou
// interview) — reliage auto par le NOM (nom de famille distinctif présent dans le titre).
const playerVideos = playerVideosFor(name, await getReplays({ discipline: 'billard' }), 'masters');

// Données structurées joueur (SEO) : contenu unique (fiche carrière). Éligible au
// panneau de connaissance / résultats « Personne ».
const _playerPhoto = nc ? ncPhoto : photo;
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  url: new URL(Astro.url.pathname, Astro.site).href,
  ...(_playerPhoto ? { image: new URL(_playerPhoto, Astro.site).href } : {}),
  description: `${name}, joueur de billard blackball au Blackball Master, suivi par LSEI — Le Sport en Image.`,
  memberOf: { '@type': 'SportsOrganization', name: 'Blackball Master' },
};
---
<Base title={nc ? `${name} — Nouveau au Blackball Master ${nc.mastersLabel}` : `${name} — Fiche carrière · Blackball Master`} description={nc ? `${name} accède au Blackball Master ${nc.mastersLabel}, promu du Mixte National ${nc.feederLabel}.` : `Fiche carrière de ${name} au Blackball Master : palmarès, statistiques et confrontations sur ${bySeason.length} saison${bySeason.length > 1 ? 's' : ''}.`} image={`/og/joueur/${Astro.params.id}.jpg`} canonical={`/billard/joueur/${slug}/`} active="disciplines">
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  <HubNav season={nc ? nc.mastersSlug : latest.slug} active="joueurs" archivesHref="/billard/archives" />
  <section class="section jfiche">
    {!nc && (
      <div class="jhead" style={`--jh-c1:${heroBand.c1};--jh-c2:${heroBand.c2};--jh-eband:${heroBand.eband}`}>
      <section class="jh">
        <div class="jh-geo" aria-hidden="true">
          <svg viewBox="0 0 1400 400" preserveAspectRatio="xMidYMid slice">
            <polygon points="0,0 500,0 180,400 0,400" fill="#ffffff" opacity="0.04"></polygon>
