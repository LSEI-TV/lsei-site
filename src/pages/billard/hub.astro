---
// Hub BILLARD : point d'entrée de la discipline. On choisit l'univers de jeu.
// - Blackball : compétitions FFB structurées (Masters/Femmes/Para) -> sous-hub /billard/blackball
// - Snooker & Billard américain : uniquement des vidéos -> vidéothèque de la catégorie
import Base from '../../layouts/Base.astro';
import { getReplays } from '../../lib/youtube';

const bilVids = await getReplays({ discipline: 'billard' });
const nSnooker = bilVids.filter((v) => v.category === 'Snooker').length;
const nAmericain = bilVids.filter((v) => v.category === 'Billard américain').length;

const types = [
  {
    href: '/billard/blackball',
    accent: 'var(--c-billard)',
    eyebrow: 'Compétitions FFB · classements',
    title: 'Blackball',
    desc: 'Le circuit national de la FFB : Masters (hommes), Femmes et Para-billard. Classements officiels, joueurs, fiches carrière et 11 saisons d’archives.',
    chips: ['Masters', 'Femmes', 'Para-billard'],
    stat: '3 compétitions',
    cta: 'Entrer dans le hub Blackball',
    featured: true,
  },
  {
    href: '/disciplines/billard/categorie/snooker',
    accent: '#2FA36B',
    eyebrow: 'Vidéos',
    title: 'Snooker',
    desc: 'Le billard anglais à grande table : nos captations et rediffusions snooker.',
    chips: [],
    stat: `${nSnooker} vidéo${nSnooker > 1 ? 's' : ''}`,
    cta: 'Voir les vidéos',
    featured: false,
  },
  {
    href: '/disciplines/billard/categorie/billard-americain',
    accent: '#D9642E',
    eyebrow: 'Vidéos',
    title: 'Billard américain',
    desc: 'Pool 8 et 9 billes : nos captations et rediffusions de billard américain.',
    chips: [],
    stat: `${nAmericain} vidéo${nAmericain > 1 ? 's' : ''}`,
    cta: 'Voir les vidéos',
    featured: false,
  },
];
---
<Base title="Billard — Le hub" description="Le hub Billard de LSEI : Blackball (Masters, Femmes, Para), Snooker et Billard américain." active="disciplines">
  <section class="disc-hero" style="--dc:var(--c-billard)">
    <div class="wrap">
      <div class="kick" style="color:var(--c-billard)">LSEI · Billard</div>
      <h1>Le hub Billard</h1>
      <p>Trois univers sous un même toit. Le <b>Blackball</b> (nos compétitions nationales avec classements et fiches), le <b>Snooker</b> et le <b>Billard américain</b> (nos vidéos). Choisissez ce que vous voulez suivre.</p>
      <div class="bar" style="background:var(--c-billard)"></div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <a href="/disciplines/billard" class="bchoose-video">
        <span class="bchoose-video-ic">🎬</span>
        <span class="bchoose-video-txt">
          <span class="bchoose-video-t">Vidéothèque billard</span>
          <span class="bchoose-video-s">Toutes les vidéos billard, tous univers confondus · {bilVids.length} vidéos</span>
        </span>
        <span class="bchoose-video-cta">Voir toutes les vidéos →</span>
      </a>

      <div class="gchoose">
        {types.map((t) => (
          <a href={t.href} class={`gcard${t.featured ? ' is-featured' : ''}`} style={`--gc:${t.accent}`}>
            <div class="gcard-top">
              <div class="gcard-eyebrow">{t.eyebrow}</div>
              <h2 class="gcard-title">{t.title}</h2>
              <p class="gcard-desc">{t.desc}</p>
              {t.chips.length > 0 && (
                <div class="gcard-chips">{t.chips.map((ch) => <span>{ch}</span>)}</div>
              )}
            </div>
            <div class="gcard-foot">
              <span class="gcard-stat">{t.stat}</span>
              <span class="gcard-cta">{t.cta} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .gchoose { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 16px; align-items: stretch; }
  .gcard {
    display: flex; flex-direction: column; justify-content: space-between; gap: 20px;
    border: 1px solid var(--line-strong); border-top: 3px solid var(--gc);
    border-radius: 14px; background: var(--surface); padding: 22px 22px 18px;
    text-decoration: none; color: inherit; transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .gcard:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -22px rgba(0,0,0,.7); border-color: var(--gc); }
  .gcard.is-featured { background: color-mix(in srgb, var(--gc) 7%, var(--surface)); }
  .gcard-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--gc); margin-bottom: 8px; }
  .gcard-title { font-family: var(--display); font-size: clamp(24px, 3vw, 34px); line-height: 1.05; margin: 0 0 10px; color: var(--ink); }
  .gcard-desc { font-size: 14px; color: var(--ink-soft); line-height: 1.5; margin: 0; }
  .gcard-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .gcard-chips span { font-size: 12px; font-weight: 600; color: var(--ink); background: var(--surface-2); border: 1px solid var(--line); border-radius: 100px; padding: 4px 11px; }
  .gcard-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 14px; border-top: 1px solid var(--line); }
  .gcard-stat { font-family: var(--display); font-weight: 700; font-size: 15px; color: var(--ink); }
  .gcard-cta { font-size: 13px; font-weight: 700; color: var(--gc); white-space: nowrap; }
  @media (max-width: 860px) {
    .gchoose { grid-template-columns: 1fr; }
  }
</style>
