---
// Hub BILLARD : point d'entrée de la discipline. On choisit l'univers de jeu.
// - Blackball : compétitions FFB structurées (Masters/Femmes/Para) -> sous-hub /billard/blackball
// - Snooker & Billard américain : uniquement des vidéos -> vidéothèque de la catégorie
import Base from '../../layouts/Base.astro';
import { getReplays } from '../../lib/youtube';
import { getSeasons, cal2627 } from '../../data/billard/seasons';

const bilVids = await getReplays({ discipline: 'billard' });
const nSnooker = bilVids.filter((v) => v.category === 'Snooker').length;
const nAmericain = bilVids.filter((v) => v.category === 'Billard américain').length;
const nSaisons = getSeasons().length;

// Circuit de la saison : étapes passées / prochaine étape (repère « J-x »).
const todayIso = new Date().toISOString().slice(0, 10);
const circuit = cal2627.filter((e) => e.kind !== 'mondial');
const nextIdx = circuit.findIndex((e) => e.start >= todayIso);
const nextEv = nextIdx >= 0 ? circuit[nextIdx] : null;
const daysTo = (iso: string) => Math.round((Date.parse(iso + 'T12:00:00Z') - Date.parse(todayIso + 'T12:00:00Z')) / 86400000);
const lastVid = bilVids[0];
const nextJx = nextEv ? (daysTo(nextEv.start) > 0 ? `J-${daysTo(nextEv.start)}` : 'En cours') : '';

const types = [
  {
    href: '/billard/blackball', accent: 'var(--c-billard)', icon: 'trophy', photo: '/billard/card-blackball.webp',
    eyebrow: 'Compétitions FFB · classements', title: 'Blackball',
    desc: `Le circuit national de la FFB : Masters (hommes, femmes et Para-billard), classements officiels, joueurs, fiches carrière et ${nSaisons} saisons d’archives.`,
    chips: ['Masters', 'Femmes', 'Para fauteuil', 'Para malvoyants'],
    stat: '4 compétitions', cta: 'Entrer dans le hub Blackball', featured: true,
  },
  {
    href: '/disciplines/billard/categorie/snooker', accent: '#2FA36B', icon: 'play', photo: '/billard/card-snooker.webp',
    eyebrow: 'Vidéos', title: 'Snooker',
    desc: 'Le billard anglais à grande table : nos captations et rediffusions snooker.',
    chips: [], stat: `${nSnooker} vidéo${nSnooker > 1 ? 's' : ''}`, cta: 'Voir les vidéos', featured: false,
  },
  {
    href: '/disciplines/billard/categorie/billard-americain', accent: '#D9642E', icon: 'play', photo: '/billard/card-americain.webp',
    eyebrow: 'Vidéos', title: 'Billard américain',
    desc: 'Pool 8 et 9 billes : nos captations et rediffusions de billard américain.',
    chips: [], stat: `${nAmericain} vidéo${nAmericain > 1 ? 's' : ''}`, cta: 'Voir les vidéos', featured: false,
  },
];

const ICONS: Record<string, string> = {
  trophy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M6 4h12v5a6 6 0 0 1-12 0V4zM6 6H3v2a3 3 0 0 0 3 3M18 6h3v2a3 3 0 0 1-3 3"/></svg>',
  play: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M10 8.5l5 3.5-5 3.5z" fill="currentColor" stroke="none"/></svg>',
  balls: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="9" r="4"/><circle cx="16" cy="9" r="4"/><circle cx="12" cy="16" r="4"/></svg>',
  film: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M10 8.5l5 3.5-5 3.5z" fill="currentColor" stroke="none"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.2 20a6 6 0 0 1 11.6 0"/><path d="M16 5.4a3 3 0 0 1 0 5.5M21 20a6 6 0 0 0-4-5.7"/></svg>',
};
---
<Base title="Billard — Le hub" description="Le hub Billard de LSEI : Blackball (Masters, Femmes, Para), Snooker et Billard américain." preloadImage="/billard-hero.webp" active="disciplines">
  <!-- HERO pleine largeur (image dans public/billard-hero.webp, repli sombre sinon) -->
  <section class="bh-hero">
    <div class="bh-hero-media" aria-hidden="true"></div>
    <div class="wrap bh-hero-in">
      <div class="bh-hero-txt">
        <div class="bh-crumb"><a href="/disciplines/">Disciplines</a><span aria-hidden="true">›</span>Billard</div>
        <h1 class="bh-h">Billard<span>Le hub</span></h1>
        <p class="bh-p">Trois univers sous un même toit : le <b>Blackball</b> (nos compétitions nationales avec classements et fiches joueurs), le <b>Snooker</b> et le <b>Billard américain</b>.</p>
        <div class="bh-kpis">
          <div><b>{bilVids.length}</b><span>vidéos</span></div>
          <div><b>3</b><span>univers</span></div>
          <div><b>{nSaisons}</b><span>saisons d'archives</span></div>
        </div>
      </div>
      {nextEv && (
        <a class="bh-next" href="/billard/blackball">
          <span class="bh-next-k"><span>Prochaine étape · Circuit national</span><b>{nextJx}</b></span>
          <span class="bh-next-t">{nextEv.name}</span>
          <span class="bh-next-d">{nextEv.date}</span>
          <span class="bh-next-p">📍 {nextEv.place}</span>
          <span class="bh-next-cta">Classements &amp; joueurs →</span>
        </a>
      )}
    </div>
  </section>

  <section class="section bh-body">
    <div class="wrap">
      <!-- 3 cartes univers -->
      <div class="sec-head"><div><div class="eyebrow" style="color:var(--c-billard)">Trois univers</div><h2>Choisissez votre <em>jeu</em></h2></div></div>
      <div class="bh-grid">
        {types.map((t) => (
          <a href={t.href} class={`bh-card${t.featured ? ' is-featured' : ''}`} style={`--gc:${t.accent}`}>
            <span class="bh-card-media" aria-hidden="true" style={`background-image:url('${t.photo}')`}></span>
            <span class="bh-card-scrim" aria-hidden="true"></span>
            <span class="bh-card-badge">{t.eyebrow}</span>
            <h2 class="bh-card-title">{t.title}</h2>
            <p class="bh-card-desc">{t.desc}</p>
            {t.chips.length > 0 && <div class="bh-chips">{t.chips.map((ch) => <span>{ch}</span>)}</div>}
            <div class="bh-card-foot">
              <span class="bh-card-stat"><span class="bh-card-stat-ic" set:html={ICONS[t.icon]}></span>{t.stat}</span>
              <span class="bh-card-cta">{t.cta} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>

      <!-- FRISE DU CIRCUIT 26/27 -->
      <div class="sec-head bh-sec"><div><div class="eyebrow" style="color:var(--c-billard)">Blackball · Saison 2026 / 2027</div><h2>Le <em>circuit</em> national</h2></div><a class="bh-sec-more" href="/billard/blackball">Le hub Blackball →</a></div>
      <ol class="bh-circuit">
        {circuit.map((e, i) => (
          <li class={i < nextIdx || nextIdx < 0 ? 'is-past' : i === nextIdx ? 'is-next' : ''}>
            <span class="bh-c-dot" aria-hidden="true"></span>
            <span class="bh-c-s">{e.short}</span>
            <span class="bh-c-d">{e.date}</span>
            <span class="bh-c-p">{e.place}</span>
          </li>
        ))}
      </ol>

      <!-- VIDÉOTHÈQUE -->
      <a href="/disciplines/billard" class="bh-vlib">
        {lastVid && <span class="bh-vlib-img" aria-hidden="true"><img src={`https://i.ytimg.com/vi/${lastVid.id}/mqdefault.jpg`} alt="" loading="lazy" /></span>}
        <span class="bh-vlib-txt">
          <span class="bh-vlib-k">Vidéothèque billard</span>
          <span class="bh-vlib-t">{bilVids.length} vidéos à revoir</span>
          <span class="bh-vlib-s">Toutes les vidéos billard, tous univers confondus : matchs, finales, interviews et archives.</span>
        </span>
        <span class="bh-vlib-cta">Voir toutes les vidéos <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO pleine largeur ---------- */
  .bh-hero { position: relative; overflow: hidden; color: #fff; background: #070c16; }
  .bh-hero::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--brand-bars, var(--c-billard)); z-index: 2; }
  .bh-hero-media { position: absolute; inset: 0;
    background:
      linear-gradient(90deg, #070c16 0%, #070c16 30%, rgba(7,10,20,.8) 48%, rgba(7,10,20,.35) 72%, rgba(7,10,20,.5) 100%),
      linear-gradient(0deg, rgba(7,10,20,.7) 0%, transparent 45%),
      url('/billard-hero.webp');
    background-size: cover; background-position: right center; }
  .bh-hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .9fr); gap: 40px; align-items: end; padding-top: 58px; padding-bottom: 50px; }
  .bh-crumb { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55); }
  .bh-crumb a { color: var(--c-billard); text-decoration: none; }
  .bh-h { font-family: var(--display); font-weight: 800; letter-spacing: -.02em; font-size: clamp(48px, 7vw, 92px); line-height: .9; margin: 12px 0 0; color: #fff; text-transform: uppercase; }
  .bh-h span { display: block; font-size: .38em; letter-spacing: .04em; margin-top: 8px; color: var(--c-billard); }
  .bh-p { color: rgba(255,255,255,.82); font-size: 16px; line-height: 1.5; margin: 16px 0 0; max-width: 56ch; text-align: start; }
  .bh-p b { color: #fff; font-weight: 700; }
  .bh-kpis { display: flex; flex-wrap: wrap; gap: 12px 34px; margin-top: 24px; }
  .bh-kpis div { display: flex; flex-direction: column; }
  .bh-kpis b { font-family: var(--display); font-weight: 800; font-size: 34px; line-height: 1; color: #fff; }
  .bh-kpis span { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.55); margin-top: 4px; }
  .bh-next { display: flex; flex-direction: column; gap: 4px; padding: 20px 22px; border-radius: 16px; text-decoration: none; color: #fff;
    background: rgba(10,14,26,.6); border: 1px solid rgba(255,255,255,.16); border-top: 4px solid var(--c-billard); box-shadow: 0 24px 50px -24px rgba(0,0,0,.8);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); transition: transform .25s cubic-bezier(.2,.7,.2,1), border-color .2s; }
  .bh-next:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--c-billard) 60%, transparent); }
  .bh-next-k { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.65); margin-bottom: 8px; }
  .bh-next-k b { flex: none; white-space: nowrap; color: #fff; background: var(--c-billard); padding: 3px 10px; border-radius: 999px; letter-spacing: .04em; }
  .bh-next-t { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 28px; line-height: 1; }
  .bh-next-d { font-size: 15px; font-weight: 700; color: var(--c-billard); margin-top: 4px; }
  .bh-next-p { font-size: 13.5px; color: rgba(255,255,255,.75); }
  .bh-next-cta { margin-top: 12px; font-size: 13px; font-weight: 800; color: #fff; }

  /* ---------- Corps ---------- */
  .bh-body { background-image: radial-gradient(rgba(20, 30, 50, .055) 1px, transparent 1.4px); background-size: 22px 22px; }
  .bh-body .sec-head h2 em { font-style: normal; background: linear-gradient(90deg, var(--b-blue, #009FE3), var(--b-pink, #E6007E)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .bh-sec { margin-top: 50px; }
  .bh-sec-more { font-size: 13.5px; font-weight: 800; color: var(--c-billard); text-decoration: none; align-self: flex-end; }
  .bh-sec-more:hover { text-decoration: underline; }

  /* ---------- Frise du circuit ---------- */
  .bh-circuit { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); position: relative; }
  .bh-circuit::before { content: ""; position: absolute; left: 0; right: 0; top: 9px; height: 3px; border-radius: 2px; background: var(--line-strong); }
  .bh-circuit li { position: relative; display: flex; flex-direction: column; gap: 3px; padding: 0 6px 0 0; min-width: 0; }
  .bh-c-dot { width: 21px; height: 21px; border-radius: 50%; background: var(--surface); border: 3px solid var(--line-strong); position: relative; z-index: 1; margin-bottom: 10px; }
  .bh-c-s { font-family: var(--display); font-weight: 800; font-size: 17px; text-transform: uppercase; color: var(--ink); }
  .bh-c-d { font-size: 12px; font-weight: 700; color: var(--ink-soft); }
  .bh-c-p { font-size: 11.5px; color: var(--ink-faint); line-height: 1.25; }
  .bh-circuit li.is-past .bh-c-dot { background: var(--c-billard); border-color: var(--c-billard); }
  .bh-circuit li.is-past { opacity: .55; }
  .bh-circuit li.is-next .bh-c-dot { border-color: var(--c-billard); box-shadow: 0 0 0 5px color-mix(in srgb, var(--c-billard) 22%, transparent); }
  .bh-circuit li.is-next .bh-c-s, .bh-circuit li.is-next .bh-c-d { color: var(--c-billard); }

  /* ---------- Vidéothèque (bandeau sombre) ---------- */
  .bh-vlib { position: relative; overflow: hidden; display: flex; align-items: center; gap: 22px; margin-top: 46px; padding: 18px 26px 18px 18px; border-radius: 16px; background: #0A0E1A; color: #fff; text-decoration: none;
    box-shadow: 0 22px 44px -24px rgba(12,14,19,.7); transition: transform .25s cubic-bezier(.2,.7,.2,1); }
  .bh-vlib::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--brand-bars, var(--c-billard)); }
  .bh-vlib:hover { transform: translateY(-3px); }
  .bh-vlib-img { flex: none; width: 210px; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; background: #111; }
  .bh-vlib-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bh-vlib-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .bh-vlib-k { font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #7fb2ff; }
  .bh-vlib-t { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 26px; line-height: 1; }
  .bh-vlib-s { font-size: 14px; color: rgba(255,255,255,.75); line-height: 1.45; }
  .bh-vlib-cta { flex: none; font-size: 14px; font-weight: 800; color: #0A0E1A; background: #fff; padding: 11px 18px; border-radius: 999px; white-space: nowrap; transition: background .2s, color .2s; }
  .bh-vlib:hover .bh-vlib-cta { background: var(--c-billard); color: #fff; }

  /* ---------- 3 cartes univers ---------- */
  .bh-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 16px; align-items: stretch; margin-top: 16px; }
  /* --- Cartes IMMERSIVES : photo plein cadre + voile sombre + texte blanc --- */
  .bh-card { position: relative; overflow: hidden; display: flex; flex-direction: column; min-height: 330px; border: 1px solid var(--line-strong); border-top: 3px solid var(--gc); border-radius: 16px; background: #0b111c; padding: 22px 24px 18px; text-decoration: none; color: #fff; transition: transform .2s, box-shadow .2s, border-color .2s; }
  /* Photo qui remplit toute la carte. Repli : fond sombre si l'image manque. */
  .bh-card-media { position: absolute; inset: 0; z-index: 0; background-position: center; background-size: cover; background-repeat: no-repeat; transition: transform .5s ease; }
  /* Voile sombre pour la lisibilité du texte blanc (plus dense en bas). */
  .bh-card-scrim { position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(6,10,18,.60) 0%, rgba(6,10,18,.32) 40%, rgba(6,10,18,.88) 100%); }
  .bh-card-badge, .bh-card-title, .bh-card-desc, .bh-chips, .bh-card-foot { z-index: 1; }
  .bh-card:hover { transform: translateY(-3px); border-color: var(--gc); box-shadow: 0 22px 48px -24px rgba(0,0,0,.7); }
  .bh-card:hover .bh-card-media { transform: scale(1.05); }
  .bh-card.is-featured { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--gc) 40%, transparent); }
  .bh-card-badge { position: relative; align-self: flex-start; font-size: 10.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #fff; background: var(--gc); background: color-mix(in srgb, var(--gc) 88%, #000); border: 1px solid rgba(255,255,255,.18); border-radius: 6px; padding: 4px 9px; }
  .bh-card-title { position: relative; font-family: var(--display); font-weight: 800; font-size: clamp(24px, 2.7vw, 34px); line-height: 1.05; margin: 14px 0 0; color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,.4); }
  .bh-card-desc { position: relative; font-size: 14px; color: rgba(255,255,255,.86); line-height: 1.5; margin: 10px 0 0; max-width: 36ch; text-shadow: 0 1px 8px rgba(0,0,0,.5); }
  .bh-chips { position: relative; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .bh-chips span { font-size: 12px; font-weight: 600; color: #fff; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.28); border-radius: 100px; padding: 4px 11px; -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); }
  .bh-card-foot { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 16px; }
  .bh-card-stat { display: inline-flex; align-items: center; gap: 9px; font-family: var(--display); font-weight: 700; font-size: 15px; color: #fff; }
  .bh-card-stat-ic { display: inline-flex; color: color-mix(in srgb, var(--gc) 55%, #fff); }
  .bh-card-stat-ic svg { width: 22px; height: 22px; }
  .bh-card-cta { font-size: 13px; font-weight: 800; color: color-mix(in srgb, var(--gc) 45%, #fff); white-space: nowrap; }

  @media (max-width: 940px) {
    .bh-grid { grid-template-columns: 1fr; }
    .bh-hero-in { grid-template-columns: 1fr; gap: 26px; padding-top: 36px; padding-bottom: 32px; }
    .bh-circuit { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 128px; overflow-x: auto; padding-bottom: 8px; scrollbar-width: thin; }
  }
  @media (max-width: 620px) {
    .bh-hero-media { background-position: 70% center; }
    .bh-vlib { flex-wrap: wrap; padding: 16px; }
    .bh-vlib-img { width: 100%; }
    .bh-vlib-cta { flex-basis: 100%; text-align: center; }
  }
</style>
