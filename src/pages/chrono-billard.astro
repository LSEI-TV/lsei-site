---
// Page de présentation de NOVΛ, le chrono billard gratuit de LSEI (l'app elle-même est à /nova/).
// Images : captures détourées de l'app dans /public/chrono-billard/ (générées depuis
// D:\KIT COMM BILLARD\CHRONO BILLARD - RESEAUX\sources\promo.html, vues shotChrono / shotConfig / shotTv).
import Base from '../layouts/Base.astro';
import { assetUrl } from '../lib/publicAssets';

const APP = '/nova/';

const fonctions = [
  { ic: '⏱', titre: 'Shot clock', texte: '45 secondes par défaut, 40 s blackball ou la durée de votre choix. On touche le joueur qui joue : le chrono démarre.' },
  { ic: '➕', titre: 'Extension', texte: '1 extension par joueur et par partie, qui s’ajoute au temps restant. Elle se réarme à chaque point marqué.' },
  { ic: '🟥', titre: 'Faute automatique', texte: 'À 0 seconde, un F rouge s’affiche devant le nom du joueur en faute. Impossible de le rater.' },
  { ic: '🔊', titre: 'Bip ou voix', texte: '« Vingt secondes », « Dix secondes », « Cinq, quatre, trois… », « Faute ! » : des annonces vocales, ou des bips. Plus les vibrations.' },
  { ic: '📺', titre: 'Mode TV', texte: 'Le chrono et le score en grand pour le public, sur l’écran de la salle ou un 2ᵉ écran, avec le logo du club et le nom du tournoi.' },
  { ic: '📋', titre: 'Match d’équipes', texte: 'Feuille de match 5 contre 5, partage par QR code entre arbitres, et historique des parties.' },
];

const etapes = [
  { n: '1', titre: 'Ouvrez NOVΛ', texte: 'Sur lsei.tv/nova, depuis un téléphone, une tablette ou un ordinateur. Rien à télécharger, aucun compte.' },
  { n: '2', titre: 'Touchez le joueur qui joue', texte: 'Son cadre passe en rouge et le chrono démarre. Pause, reprise et extension en un geste.' },
  { n: '3', titre: 'Marquez le point', texte: '+1 au vainqueur : le chrono se remet à zéro et les extensions sont de nouveau disponibles.' },
];

const faq = [
  { q: 'NOVΛ est-il vraiment gratuit ?', r: 'Oui, entièrement. Pas d’abonnement, pas de publicité, pas de compte à créer. C’est un outil offert par LSEI, la web TV du sport.' },
  { q: 'Mes données sont-elles envoyées quelque part ?', r: 'Non. Scores, noms et réglages restent enregistrés sur votre appareil uniquement.' },
  { q: 'Faut-il une connexion internet ?', r: 'Seulement pour la première ouverture. Ensuite NOVΛ fonctionne même hors ligne, idéal dans une salle sans réseau.' },
  { q: 'Ça marche sur iPhone ?', r: 'Oui, sur iPhone comme sur Android, tablette et ordinateur. Seule différence : l’iPhone ne permet pas les vibrations aux applications web.' },
  { q: 'Peut-on l’utiliser sur plusieurs tables ?', r: 'Oui : chaque appareil a son propre chrono. Il suffit d’un téléphone ou d’une tablette par table.' },
  { q: 'Comment afficher notre club sur l’écran TV ?', r: 'Dans l’onglet Configuration, ajoutez le logo de votre club et le nom du tournoi : ils s’affichent en haut du mode TV.' },
];

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'NOVΛ',
  alternateName: 'NOVA — chrono billard',
  applicationCategory: 'SportsApplication',
  operatingSystem: 'Web, Android, iOS, Windows, macOS',
  url: new URL(APP, Astro.site).href,
  description: 'Chrono billard gratuit : shot clock, extensions, fautes, alertes bip ou voix, mode TV et feuille de match.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  publisher: { '@type': 'Organization', name: 'LSEI — Le Sport en Image' },
};
---
<Base
  title="NOVΛ, le chrono billard gratuit"
  description="NOVΛ, le chrono billard gratuit de LSEI : shot clock 45 s, extensions, fautes, alertes bip ou voix, mode TV pour le public. Sans compte, sans pub, fonctionne hors ligne."
>
  <script type="application/ld+json" set:html={JSON.stringify(appLd)} />

  <!-- ===== Hero ===== -->
  <section class="nv-hero">
    <div class="wrap">
      <div class="nv-hero-card">
        <div class="nv-hero-txt">
          <svg class="nv-logo" viewBox="12 12 566 156" role="img" aria-label="NOVΛ">
            <circle cx="90" cy="90" r="70" fill="none" stroke="#ff7800" stroke-width="12" />
            <polygon fill="#ffffff" points="55,42 125,42 90,90" />
            <polygon fill="#ff7800" points="90,90 55,138 125,138" />
            <path fill="#ffffff" transform="translate(200,40)" d="M0,100 V0 H22 L48,62 V0 H70 V100 H48 L22,38 V100 Z" />
            <circle cx="336" cy="90" r="39" fill="none" stroke="#ffffff" stroke-width="22" />
            <polygon fill="#ffffff" transform="translate(402,40)" points="0,0 24,0 40,62 56,0 80,0 52,100 28,100" />
            <polygon fill="#ff7800" transform="translate(494,40)" points="28,0 52,0 80,100 56,100 40,38 24,100 0,100" />
          </svg>
          <div class="nv-by">by LSEI TV</div>
          <h1>Le chrono billard <span>gratuit</span></h1>
          <p>Shot clock, extensions, fautes, annonces vocales et mode TV pour le public. L’outil de l’arbitre, dans votre poche.</p>
          <div class="nv-actions">
            <a class="nv-btn" href={APP}>Ouvrir NOVΛ →</a>
            <a class="nv-btn nv-btn--ghost" href="#fonctions">Voir les fonctions</a>
          </div>
          <div class="nv-free">Gratuit · Sans compte · Sans pub · Fonctionne hors ligne</div>
        </div>
        <div class="nv-hero-img">
          <img src={assetUrl('/chrono-billard/nova-chrono.webp')} alt="L'écran chrono de NOVΛ : 18 secondes, Djamel 3 – François 2" width="472" height="926" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Fonctions ===== -->
  <section class="section" id="fonctions">
    <div class="wrap">
      <div class="nv-head">
        <div class="eyebrow">Fonctions</div>
        <h2>Tout ce qu’il faut pour arbitrer une partie</h2>
      </div>
      <div class="nv-grid">
        {fonctions.map((f) => (
          <div class="nv-card">
            <div class="nv-ic" aria-hidden="true">{f.ic}</div>
            <h3>{f.titre}</h3>
            <p>{f.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Comment ça marche ===== -->
  <section class="section nv-steps-sec">
    <div class="wrap">
      <div class="nv-head">
        <div class="eyebrow">En 3 gestes</div>
        <h2>Comment ça marche</h2>
      </div>
      <ol class="nv-steps">
        {etapes.map((e) => (
          <li>
            <span class="nv-num">{e.n}</span>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===== Mode TV ===== -->
  <section class="section">
    <div class="wrap nv-split">
      <div class="nv-split-txt">
        <div class="eyebrow">Mode TV</div>
        <h2>Le chrono sur grand écran, pour le public</h2>
        <p>Branchez un ordinateur sur l’écran de la salle : le mode TV affiche les noms, le score, le chrono en grand et le F de faute. Il s’ouvre aussi dans une 2ᵉ fenêtre, synchronisée avec le téléphone de l’arbitre.</p>
        <p>Votre <strong>logo de club</strong> et le <strong>nom du tournoi</strong> s’affichent en haut, et les partenaires de LSEI défilent en bas.</p>
      </div>
      <div class="nv-split-img">
        <img src={assetUrl('/chrono-billard/nova-mode-tv.webp')} alt="Le mode TV de NOVΛ : Open LSEI TV 2026, Djamel 3 – François 2, 12 secondes" width="1038" height="618" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ===== Personnalisable ===== -->
  <section class="section">
    <div class="wrap nv-split nv-split--rev">
      <div class="nv-split-txt">
        <div class="eyebrow">Personnalisable</div>
        <h2>Réglé selon vos règles</h2>
        <ul class="nv-list">
          <li>Durée du chrono : 40 s blackball, 45 s ou la durée de votre choix</li>
          <li>Durée de l’extension</li>
          <li>Alertes en bips ou annoncées par la voix</li>
          <li>Noms des joueurs, logo du club, nom du tournoi</li>
        </ul>
        <p>Vos réglages sont mémorisés sur l’appareil : NOVΛ se rouvre exactement comme vous l’avez laissé.</p>
      </div>
      <div class="nv-split-img nv-split-img--phone">
        <img src={assetUrl('/chrono-billard/nova-configuration.webp')} alt="L'onglet Configuration de NOVΛ" width="472" height="926" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ===== Installer ===== -->
  <section class="section">
    <div class="wrap">
      <div class="nv-head">
        <div class="eyebrow">Comme une vraie application</div>
        <h2>Installez NOVΛ sur votre écran d’accueil</h2>
      </div>
      <div class="nv-install">
        <div class="nv-card">
          <h3>Sur Android</h3>
          <p>Ouvrez <strong>lsei.tv/nova</strong> dans Chrome ou Samsung Internet, puis menu <strong>⋮</strong> → <strong>« Ajouter à l’écran d’accueil »</strong> (ou « Installer l’application »).</p>
        </div>
        <div class="nv-card">
          <h3>Sur iPhone et iPad</h3>
          <p>Ouvrez <strong>lsei.tv/nova</strong> dans Safari, touchez le bouton <strong>Partager</strong>, puis <strong>« Sur l’écran d’accueil »</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section">
    <div class="wrap nv-faq-wrap">
      <div class="nv-head">
        <div class="eyebrow">Questions</div>
        <h2>Questions fréquentes</h2>
      </div>
      <div class="nv-faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Appel final ===== -->
  <section class="section">
    <div class="wrap">
      <div class="nv-final">
        <div class="nv-final-txt">
          <div class="nv-final-kick">Scanne &amp; joue</div>
          <h2>Essayez NOVΛ à votre prochaine partie</h2>
          <p>Gratuit, sans compte, sur tous les appareils.</p>
          <a class="nv-btn" href={APP}>Ouvrir NOVΛ →</a>
          <div class="nv-url">lsei.tv/<span>nova</span></div>
        </div>
        <div class="nv-qr">
          <img src={assetUrl('/chrono-billard/qr-nova.svg')} alt="QR code vers lsei.tv/nova" width="180" height="180" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Identité NOVΛ : noir + orange, dans la mise en page du site */
  .nv-hero { padding: 26px 0 8px; }
  .nv-hero-card {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1.15fr .85fr; gap: 28px; align-items: center;
    background: #0a0c10; color: #fff; border-radius: 18px; padding: 44px 48px 0;
  }
  .nv-hero-card::before {
    content: ""; position: absolute; left: -120px; top: -120px; width: 420px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,120,0,.28), transparent 62%); pointer-events: none;
  }
  .nv-hero-txt { position: relative; padding-bottom: 44px; }
  .nv-logo { width: min(330px, 80%); height: auto; display: block; }
  .nv-by { font-family: var(--display); font-weight: 600; letter-spacing: .32em; font-size: 13px; color: #9aa0aa; text-transform: uppercase; margin: 8px 0 0 4px; }
  .nv-hero h1 { font-family: var(--display); font-size: clamp(34px, 4.6vw, 58px); font-weight: 700; text-transform: uppercase; letter-spacing: .01em; line-height: 1; margin: 26px 0 0; color: #fff; }
  .nv-hero h1 span { color: #ff7800; }
  .nv-hero p { font-family: var(--serif); font-size: 17.5px; line-height: 1.5; color: #C6CBD8; margin: 14px 0 0; max-width: 46ch; }
  .nv-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .nv-btn {
    display: inline-flex; align-items: center; justify-content: center;
    background: #ff7800; color: #1a0d00; font-weight: 800; font-size: 15.5px;
    padding: 13px 24px; border-radius: 100px; text-decoration: none; transition: background .15s, transform .1s;
  }
  .nv-btn:hover { background: #ff8f2b; }
  .nv-btn:active { transform: scale(.98); }
  .nv-btn--ghost { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,.35); }
  .nv-btn--ghost:hover { background: rgba(255,255,255,.08); border-color: #fff; }
  .nv-free { margin-top: 18px; font-size: 13px; font-weight: 700; color: #9aa0aa; }
  .nv-hero-img { position: relative; align-self: end; display: flex; justify-content: center; }
  .nv-hero-img img { width: min(300px, 100%); height: auto; display: block; margin-bottom: -60px; }

  .nv-head { max-width: 62ch; margin-bottom: 22px; }
  .nv-head h2 { font-size: clamp(24px, 2.6vw, 31px); font-weight: 800; letter-spacing: -.02em; margin: 6px 0 0; }
  .nv-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .nv-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 22px; box-shadow: var(--shadow); }
  .nv-card h3 { font-size: 17px; font-weight: 800; margin: 10px 0 0; }
  .nv-card p { font-size: 14.5px; line-height: 1.5; color: var(--ink-soft); margin: 8px 0 0; }
  .nv-ic { font-size: 26px; line-height: 1; }

  .nv-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; counter-reset: none; }
  .nv-steps li { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 22px; }
  .nv-num { display: inline-flex; width: 38px; height: 38px; align-items: center; justify-content: center; border-radius: 50%; background: #ff7800; color: #1a0d00; font-family: var(--display); font-weight: 700; font-size: 19px; }
  .nv-steps h3 { font-size: 17px; font-weight: 800; margin: 12px 0 0; }
  .nv-steps p { font-size: 14.5px; line-height: 1.5; color: var(--ink-soft); margin: 8px 0 0; }

  .nv-split { display: grid; grid-template-columns: 1fr 1.1fr; gap: 36px; align-items: center; }
  .nv-split--rev { grid-template-columns: 1.1fr .9fr; }
  .nv-split--rev .nv-split-img { order: 2; }
  .nv-split-txt h2 { font-size: clamp(24px, 2.6vw, 31px); font-weight: 800; letter-spacing: -.02em; margin: 6px 0 0; }
  .nv-split-txt p { font-family: var(--serif); font-size: 16.5px; line-height: 1.55; color: var(--ink-soft); margin: 12px 0 0; }
  .nv-split-img img { width: 100%; height: auto; display: block; }
  .nv-split-img--phone { display: flex; justify-content: center; }
  .nv-split-img--phone img { width: min(280px, 100%); }
  .nv-list { margin: 14px 0 0; padding-left: 20px; color: var(--ink); line-height: 1.7; font-size: 15.5px; }

  .nv-install { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }

  .nv-faq-wrap { max-width: 860px; }
  .nv-faq details { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; margin-bottom: 10px; }
  .nv-faq summary { cursor: pointer; padding: 16px 20px; font-weight: 800; font-size: 15.5px; list-style: none; position: relative; padding-right: 44px; }
  .nv-faq summary::-webkit-details-marker { display: none; }
  .nv-faq summary::after { content: "+"; position: absolute; right: 20px; top: 50%; transform: translateY(-50%); font-size: 22px; color: #ff7800; font-weight: 700; }
  .nv-faq details[open] summary::after { content: "–"; }
  .nv-faq p { padding: 0 20px 16px; margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--ink-soft); }

  .nv-final {
    position: relative; overflow: hidden; background: #0a0c10; color: #fff; border-radius: 18px;
    padding: 40px 48px; display: flex; align-items: center; justify-content: space-between; gap: 30px; flex-wrap: wrap;
  }
  .nv-final::before {
    content: ""; position: absolute; right: -90px; bottom: -90px; width: 340px; height: 340px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,120,0,.3), transparent 62%); pointer-events: none;
  }
  .nv-final-txt { position: relative; }
  .nv-final-kick { font-family: var(--display); font-weight: 600; letter-spacing: .2em; font-size: 13px; text-transform: uppercase; color: #ff7800; }
  .nv-final h2 { font-size: clamp(24px, 2.8vw, 32px); font-weight: 800; letter-spacing: -.02em; margin: 6px 0 0; color: #fff; }
  .nv-final p { font-family: var(--serif); font-size: 16px; color: #C6CBD8; margin: 8px 0 18px; }
  .nv-url { margin-top: 14px; font-family: var(--display); font-weight: 700; font-size: 20px; letter-spacing: .02em; }
  .nv-url span { color: #ff7800; }
  .nv-qr { position: relative; background: #fff; border-radius: 14px; padding: 12px; border: 3px solid #ff7800; }
  .nv-qr img { width: 180px; height: 180px; display: block; }

  @media (max-width: 900px) {
    .nv-hero-card { grid-template-columns: 1fr; padding: 32px 26px 0; text-align: left; }
    .nv-hero-txt { padding-bottom: 8px; }
    .nv-hero-img img { width: min(250px, 72%); margin-bottom: -50px; }
    .nv-grid, .nv-steps { grid-template-columns: 1fr 1fr; }
    .nv-split, .nv-split--rev { grid-template-columns: 1fr; gap: 20px; }
    .nv-split--rev .nv-split-img { order: 0; }
  }
  @media (max-width: 600px) {
    .nv-grid, .nv-steps, .nv-install { grid-template-columns: 1fr; }
    .nv-final { padding: 30px 24px; justify-content: center; text-align: center; }
    .nv-final-txt { width: 100%; }
    .nv-qr img { width: 150px; height: 150px; }
  }
</style>
